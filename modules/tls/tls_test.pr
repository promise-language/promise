use net;
// tls module tests — loopback TLS handshake over the reactor (T0077, T1598, T1599).
// A self-signed cert/key (generated once, committed) drives a TlsListener
// server and a TlsStream client on 127.0.0.1, exercising the full handshake,
// encrypted round-trip, negotiated version/cipher, close_notify, and TlsError
// kind differentiation. Runs on all three backends — Linux/OpenSSL (memory
// BIOs), macOS/Secure Transport (buffer queues) and Windows/SChannel (buffer
// queues). Excluded on wasm (no TLS backend / no sockets).
//
// Every socket-capable target now has a backend, so the backend-less contract
// (constructors raising TlsError(kind: unsupported)) has no target left to run
// on: test_tls_unsupported_without_backend was retired with the Windows backend
// (T1598, T1614). Restore it alongside any future target that lacks a backend.
//
// The test certificate is an inert self-signed localhost artifact. Apple's SSL
// trust policy is far stricter than OpenSSL's, and a plain CN-only certificate
// is rejected outright (measured: "SSL hostname does not match name(s) in
// certificate", "Extended key usage does not match certificate usage",
// "Certificate exceeds maximum temporal validity period"), so the fixture must
// carry SAN + EKU and dodge the 398-day validity cap. It is therefore:
//
//   subject/issuer  CN=localhost (self-signed, CA:TRUE, keyCertSign+digitalSignature)
//   SAN             DNS:localhost, IP:127.0.0.1, IP:::1     (CN is ignored since 10.15)
//   EKU             serverAuth
//   validity        2019-01-01Z .. 2039-01-01Z
//
// The backdating is deliberate. Apple enforces the 398-day maximum validity even
// for anchors supplied through SecTrustSetAnchorCertificates, so a compliant
// 10-year certificate still fails; certificates issued before 2020-09-01 are
// exempt. A 397-day certificate would satisfy the cap but would expire — and
// break this suite — every year. If Apple ever closes the pre-2020 exemption,
// switch to a short-dated certificate regenerated by CI rather than committed.
// These properties are strictly more standards-conformant than a CN-only
// certificate, so OpenSSL (which prefers SAN and applies no temporal cap)
// accepts it too.
//
// Regenerate with the Go toolchain (the system `openssl` on macOS is LibreSSL and
// cannot set notBefore), then paste the PEM below:
//
//   crypto/x509.CreateCertificate with a self-signed template:
//     SerialNumber: 1, Subject/Issuer CN=localhost, IsCA: true,
//     BasicConstraintsValid: true,
//     KeyUsage: DigitalSignature|KeyEncipherment|CertSign,
//     ExtKeyUsage: []{ServerAuth},
//     DNSNames: ["localhost"], IPAddresses: [127.0.0.1, ::1],
//     NotBefore: 2019-01-01T00:00:00Z, NotAfter: 2039-01-01T00:00:00Z,
//     key: rsa.GenerateKey(2048), marshalled PKCS#8.
//
// Self-signed certificate and matching private key (CN=localhost), PEM-encoded.
_test_cert() u8[] {
  return "-----BEGIN CERTIFICATE-----\nMIIDKjCCAhKgAwIBAgIBATANBgkqhkiG9w0BAQsFADAUMRIwEAYDVQQDEwlsb2Nh\nbGhvc3QwHhcNMTkwMTAxMDAwMDAwWhcNMzkwMTAxMDAwMDAwWjAUMRIwEAYDVQQD\nEwlsb2NhbGhvc3QwggEiMA0GCSqGSIb3DQEBAQUAA4IBDwAwggEKAoIBAQC+UCkb\nxfweDOAya9SRhQxkt9hUXr9D1xEnJVZUfTQJC1Tgk2U/kdAXT7z4bXTzXuRiKBik\nwp9MR12MW9qwYoc2ul/D8nJeyUJIeDU6JxzlZVkgl7Z124Eyk3gxMuAV09DCabdr\n5rayTuwOYNxSWsYH4c7HtSRstN+W44Oi2conYNtzepHQyzvkZoadWakgxQnAr/IV\nIMaawdWW7QaVg4WQEm00JsID3X6wNbfzp9P6MZhvHvLR4IBuE9el9C1144u+s/vh\nY/l0IS+U8y+tGq/JPywLD3sUQEG4djQc/q2uuz/SpGUF5QCRyOzxyQT9g3sphE0I\nvPj3AcRsxgvFc5bVAgMBAAGjgYYwgYMwDgYDVR0PAQH/BAQDAgKkMBMGA1UdJQQM\nMAoGCCsGAQUFBwMBMA8GA1UdEwEB/wQFMAMBAf8wHQYDVR0OBBYEFOL3x9cyb4/r\nHpNfCu0XbcCEUL1uMCwGA1UdEQQlMCOCCWxvY2FsaG9zdIcEfwAAAYcQAAAAAAAA\nAAAAAAAAAAAAATANBgkqhkiG9w0BAQsFAAOCAQEAqc1RvKkjwgI+NBwa3fW09yQJ\nnFbjsDfpJKVEvrPbgCjXcl9DFYaS2AxLXKHVCWiFM8vKkMMNVG4fFjfdOuUZ6apG\niuZEuOwyNG3SzD+jQdZvcXrWtmRls15oxpk4QPLlHv6frLXRpXAzS1TByx7tlobQ\nYDKpg37s9jX1pfq/9B+5+s8yuHXeBvLwxO8LU6Zvf9t0H3ElO16ezW5NEVYYrS95\niznJVTOmsigPsfRSjjoOXmm2rF9EWuj9SYMHaCkVc772brxkNAZIYVAE6s/BlFnu\nFDrQTYkI1LBtpuD4a3mfhYFM8BHyXvXu/FMDh2ps7ndIoZCX9v3c8Ir2KeYxSA==\n-----END CERTIFICATE-----\n".bytes();
}

_test_key() u8[] {
  return "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC+UCkbxfweDOAy\na9SRhQxkt9hUXr9D1xEnJVZUfTQJC1Tgk2U/kdAXT7z4bXTzXuRiKBikwp9MR12M\nW9qwYoc2ul/D8nJeyUJIeDU6JxzlZVkgl7Z124Eyk3gxMuAV09DCabdr5rayTuwO\nYNxSWsYH4c7HtSRstN+W44Oi2conYNtzepHQyzvkZoadWakgxQnAr/IVIMaawdWW\n7QaVg4WQEm00JsID3X6wNbfzp9P6MZhvHvLR4IBuE9el9C1144u+s/vhY/l0IS+U\n8y+tGq/JPywLD3sUQEG4djQc/q2uuz/SpGUF5QCRyOzxyQT9g3sphE0IvPj3AcRs\nxgvFc5bVAgMBAAECggEAQWLAJPMqUlbBJoGmuFJ6dhY2BJLC6vd2xLjOxtt3Z84V\nXM03YZZi5Md4GPBeWIlXNSQqh1z4pxfz25fpdGV9qD9zTJq9UbSbCdQHEZJDmsrt\nysVlImwGoQ5KorikhctO86SnqLJNPcjg0HXV7JOUazvZNAMX3yNrmGdVoDtseYd0\nhh8t5UGPoUZUBFVGK1b0ZvJtdxm16wgpdlE8LqiC8cXLyXwWe+E1YISI8T40sLco\nR+N4SkggdIuZqGqmWIxbk3aQj0Wrtbfjjzovv26YXVEKi5c9aaIdURxim1DkbRIQ\n5g7VTR6Z8fr786CqMLnRsqvxpP5gsr2Cek/orkomZwKBgQDGb4UKErkoQNUoRGPG\n4jvf0nNNTq7I/trWkFa63m0OpdbqZv2BVXhMUGSnpvcC/QoOPPuaIFnDmPe0xL7U\n5aV4Lwls40DGqdIlDKlLiCEq2ISS2Xh76ISbRZH9ceHjIoXKswttUQbx20TiA61C\nY2Jt8bcbBLImUfJiJiAgu/bsGwKBgQD1hXAKnHOgt+/J1onPwCbVGrXcJN9GBKjR\nGV9zGC45uK6EkPBKyImCAkrqhX2gT7/eHPiUCgEWUE2HSercnI8X+Ak+NYJ911kv\nadx407JDfkBGs4Q8tZk5Ximk7Uy3YRWpyQcpbPTxg+q6AExYBrOTfzG/sOuILeUG\nSbDTwYDXzwKBgQCqO/vXQ27DALOdIuayNV2GS4YNOUYrOrBEyHkPQUgv+8ffOdGb\nRda5KXLgfRWF48zfoCN8+unnKnC/DNZl0ElfTIL6fg8RH5kfnbgTC0rg9fTuAlEh\ng71Xc5yl4DAYaoJ6/ZT9CDk7/Y8fkmXuAVLs3SPnsuSeiUi2ONzxGC/iJwKBgQCm\npYq1+RlWlmKQqijiNTdmX/neUbymptT7EHDECz6c+SijXEltSQ5kiy/UXQU3Acpm\ndV2YBe5U+e6VjGt4kF9j0nxbmDBZQAkN8Jmv/Wi6/P+dvY1dM5mr4aj8hAEVWzU8\nB/HvgUAEihiRZVBsUygiTiwzQ1+rEBOqn+wA3w+X6wKBgAMYLEv0Fo5pmXCbId7G\nOvu9rWPk+pu1rmLD/XFj61uYD6BDmPiIIOyHosqJTrZeIz165MUOQP7a9hcOfEoM\nsBxmdvJBnhYdvXHAnNXlpd2CHKID/ylRykijfOYVF+xKNpVtoOPMIMfkvbrcK3A6\n8+PmV+ctiDfQytn+exVyAp0K\n-----END PRIVATE KEY-----\n".bytes();
}

test_tls_loopback_roundtrip() `test(exclude: wasm, timeout: "20s") {
  u8[] cert = _test_cert();
  u8[] key = _test_key();
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, cert, key)?!;
  int port = listener.local_port;
  assert(port > 0, "listener bound to a port");

  // Client runs in a goroutine; it connects, sends a line, and checks the echo.
  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsConfig cfg = TlsConfig.insecure();
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    assert(client.cipher_suite.len > 0, "client negotiated a cipher suite");
    client.write_string("hello tls\n")?!;
    if reply := client.read_line()?! {
      assert(reply == "echo:hello tls", "client received the server echo");
    } else {
      assert(false, "client expected an echo line");
    }
    client.close()?!;
  };

  // Server handshakes, reads one line, echoes it back, and closes.
  TlsStream server = listener.accept()?!;
  assert(server.cipher_suite.len > 0, "server negotiated a cipher suite");
  match server.version {
    TlsVersion.tls_1_2 => {
    },
    TlsVersion.tls_1_3 => {
    },
  }
  if line := server.read_line()?! {
    assert(line == "hello tls", "server received the plaintext over TLS");
    server.write_string("echo:" + line + "\n")?!;
  } else {
    assert(false, "server expected a request line");
  }
  server.close()?!;
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

test_tls_handshake_error_on_plain_tcp() `test(exclude: wasm, timeout: "15s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  // A plain-TCP server that speaks no TLS: it reads the ClientHello and replies
  // with non-TLS bytes, so the client handshake must fail.
  go {
    net.TcpStream conn = listener.accept()? e {
      return;
    };
    u8[] buf = u8[].filled(0u8, 1024);
    conn.read(buf)? e {
    };
    u8[] garbage = "NOT-A-TLS-SERVER\n".bytes();
    conn.write(garbage)? e {
    };
    conn.close()? e {
    };
    // listener is owned by this goroutine and drops here, closing its socket.
  };

  net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
  TlsConfig cfg = TlsConfig.insecure();
  bool caught = false;
  TlsStream.connect(move tcp, "localhost", cfg)? e is TlsError {
    // Must be a handshake or io failure — NOT a certificate error (we used
    // insecure()) and NOT unsupported (this platform has a TLS backend).
    //
    // Normally it is `handshake` on both backends, by different routes: OpenSSL
    // rejects the malformed record outright, while Secure Transport reads the
    // same bytes as a record header promising more data and only fails when the
    // peer closes — which _fill_in reports as a handshake failure precisely so
    // the two backends agree here. `io` is still accepted because a peer that
    // vanishes can also surface as a reset on the socket read itself, which is a
    // genuine I/O error and not worth making this test flaky over.
    match e.kind {
      TlsErrorKind.handshake => {
        caught = true;
      },
      TlsErrorKind.io => {
        caught = true;
      },
      TlsErrorKind.certificate => {
        assert(false, "should not be a certificate error under insecure()");
      },
      TlsErrorKind.no_trust_store => {
        assert(false, "should not be a trust-store error under insecure()");
      },
      TlsErrorKind.unsupported => {
        assert(false, "TLS must be supported on this platform");
      },
    }
  }!;
  assert(caught, "TLS handshake against a plain-TCP server must fail");
  sleep(Duration.from_millis(100));
}

// Compile-time proof that TlsStream satisfies Reader and Writer, as its type doc
// claims — required for layering (e.g. HTTPS) over a generic byte stream. These
// helpers are never called; sema type-checks the interface views at compile time.
_tls_stream_is_reader(TlsStream move s) {
  _tls_consume_reader(s);
}
_tls_stream_is_writer(TlsStream move s) {
  _tls_consume_writer(s);
}
_tls_consume_reader(Reader r) {
}
_tls_consume_writer(Writer w) {
}

test_tls_config_insecure_and_default() `test(exclude: wasm) {
  // Both config factories succeed on every socket-capable target: on a backed
  // platform they hold a real SSL_CTX, and on a backend-less one a 0 context that
  // every later operation refuses.
  TlsConfig a = TlsConfig.insecure();
  TlsConfig b = TlsConfig.create();
  b.set_min_version(TlsVersion.tls_1_3);
  // a and b drop here, freeing their OpenSSL contexts (leak detector verifies).
}

// A verifying client that trusts the server's self-signed certificate (added as a
// custom root) completes the handshake and drains the server's whole response via
// read_all. Exercises: TlsConfig.create + add_root_certificate, the connect verify
// path with a matching hostname, a certificate that verifies (get_verify_result ==
// 0), and TlsStream.read_all draining to a clean close_notify. Deterministic — the
// trust anchor is supplied inline (no system-trust-store dependency), and it follows
// the request/response ordering of the stable roundtrip: the client sends first, the
// server responds and closes while the client is still open, then the client
// read_all's to the server's close_notify and simply drops.
test_tls_verified_handshake_and_read_all() `test(exclude: wasm, timeout: "20s") {
  u8[] cert = _test_cert();
  u8[] key = _test_key();
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, cert, key)?!;
  int port = listener.local_port;

  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsConfig cfg = TlsConfig.create();
    cfg.add_root_certificate(_test_cert())?!; // trust the self-signed server cert
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    client.write_string("ping\n")?!;
    // Drain the server's full response until its close_notify, then just drop — no
    // close_notify is written back into the already-closed peer.
    u8[] got = client.read_all()?!;
    assert(string.from_bytes(got) == "payload-over-verified-tls",
    "client read_all decrypted the whole response over a verified TLS link");
  };

  TlsStream server = listener.accept()?!;
  if line := server.read_line()?! {
    assert(line == "ping", "server received the client request over verified TLS");
  } else {
    assert(false, "server expected a request line");
  }
  server.write_string("payload-over-verified-tls")?!;
  server.close()?!; // close_notify while the client is still reading — clean EOF
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

// A verifying client whose trust anchor DOES cover the server cert still rejects
// the connection when the requested hostname does not match the certificate.
// Exercises the certificate-failure branch of _handshake (get_verify_result != 0
// → TlsErrorKind.certificate) distinctly from a protocol handshake failure, and
// is deterministic because the trust store is supplied inline (no no_trust_store).
test_tls_verified_handshake_rejects_wrong_host() `test(exclude: wasm, timeout: "15s") {
  u8[] cert = _test_cert();
  u8[] key = _test_key();
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, cert, key)?!;
  int port = listener.local_port;

  go {
    // Server accept fails once the client aborts on the bad hostname; swallow it.
    listener.accept()? e {
    };
  };

  net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
  TlsConfig cfg = TlsConfig.create();
  cfg.add_root_certificate(_test_cert())?!; // chain will verify; hostname will not
  bool caught_cert = false;
  TlsStream.connect(move tcp, "wronghost.invalid", cfg)? e is TlsError {
    match e.kind {
      TlsErrorKind.certificate => {
        caught_cert = true;
      },
      _ => {
        assert(false, "a hostname mismatch must surface as a certificate error");
      },
    }
  }!;
  assert(caught_cert, "verifying client must reject a certificate whose host mismatches");
  sleep(Duration.from_millis(100));
}

// Certificate/key loading error paths that need no network: a valid client cert
// and key load; invalid PEM is rejected as a certificate error on both the config
// (add_root_certificate / set_client_certificate) and the server listener (bind).
test_tls_certificate_loading_errors() `test(exclude: wasm) {
  u8[] garbage = "-----BEGIN CERTIFICATE-----\nnot-valid-base64\n-----END CERTIFICATE-----\n".bytes();

  // A valid client certificate + matching key load on a (non-verifying) config.
  TlsConfig client_cfg = TlsConfig.insecure();
  client_cfg.set_client_certificate(_test_cert(), _test_key())?!;

  // Adding a valid CA to a verifying config succeeds and marks a trust store.
  TlsConfig verifier = TlsConfig.create();
  verifier.add_root_certificate(_test_cert())?!;

  // Invalid PEM is a certificate error via add_root_certificate.
  TlsConfig bad_ca = TlsConfig.insecure();
  bool caught_ca = false;
  bad_ca.add_root_certificate(garbage)? e is TlsError {
    match e.kind {
      TlsErrorKind.certificate => {
        caught_ca = true;
      },
      _ => {
      },
    }
  }!;
  assert(caught_ca, "invalid CA PEM must raise a certificate error");

  // A malformed private key is a certificate error via set_client_certificate.
  TlsConfig bad_key = TlsConfig.insecure();
  u8[] badkey = "-----BEGIN PRIVATE KEY-----\nnot-valid-base64\n-----END PRIVATE KEY-----\n".bytes();
  bool caught_key = false;
  bad_key.set_client_certificate(_test_cert(), badkey)? e is TlsError {
    match e.kind {
      TlsErrorKind.certificate => {
        caught_key = true;
      },
      _ => {
      },
    }
  }!;
  assert(caught_key, "malformed private key must raise a certificate error");

  // A server listener rejects an invalid certificate at bind time (frees its ctx).
  bool caught_bind_cert = false;
  TlsListener.bind("127.0.0.1", 0, garbage, _test_key())? e is TlsError {
    match e.kind {
      TlsErrorKind.certificate => {
        caught_bind_cert = true;
      },
      _ => {
      },
    }
  }!;
  assert(caught_bind_cert, "TlsListener.bind must reject an invalid server certificate");

  // ...and rejects a valid certificate paired with an invalid key.
  bool caught_bind_key = false;
  TlsListener.bind("127.0.0.1", 0, _test_cert(), badkey)? e is TlsError {
    match e.kind {
      TlsErrorKind.certificate => {
        caught_bind_key = true;
      },
      _ => {
      },
    }
  }!;
  assert(caught_bind_key, "TlsListener.bind must reject an invalid server key");
}

// Whether this platform's TLS backend can negotiate TLS 1.3. macOS uses Secure
// Transport, which implements no TLS 1.3 — SSLSetProtocolVersionMin rejects
// kTLSProtocol13 with errSSLIllegalParam — so a macOS connection tops out at
// TLS 1.2 (T1599).
_tls13_possible() bool `target(macos) {
  return false;
}
_tls13_possible() bool `target(!macos) {
  return true;
}

// The negotiated connection parameters are reported as usable values on both
// ends. Two things are pinned here that a plain round-trip does not cover:
//   * cipher_suite is a recognised NAME, never a raw "0xXXXX" fallback. On
//     macOS the suite number comes back as a bare u16 and the backend maps it
//     through a name table, so this is the test that the table actually covers
//     what Secure Transport negotiates.
//   * version never exceeds what the backend implements — TLS 1.2 on macOS.
test_tls_negotiated_parameters() `test(exclude: wasm, timeout: "20s") {
  u8[] cert = _test_cert();
  u8[] key = _test_key();
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, cert, key)?!;
  int port = listener.local_port;

  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsConfig cfg = TlsConfig.insecure();
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    string suite = client.cipher_suite;
    assert(suite.len > 0, "client reports a negotiated cipher suite");
    assert(!suite.starts_with("0x"),
    "client cipher suite is a recognised name, not a raw suite number");
    client.write_string("params\n")?!;
    client.close()?!;
  };

  TlsStream server = listener.accept()?!;
  string suite = server.cipher_suite;
  assert(suite.len > 0, "server reports a negotiated cipher suite");
  assert(!suite.starts_with("0x"),
  "server cipher suite is a recognised name, not a raw suite number");

  bool is_13 = false;
  match server.version {
    TlsVersion.tls_1_2 => {
    },
    TlsVersion.tls_1_3 => {
      is_13 = true;
    },
  }
  if !_tls13_possible() {
    assert(!is_13, "a backend without TLS 1.3 must not report a 1.3 connection");
  }

  if line := server.read_line()?! {
    assert(line == "params", "server read the client's line over the negotiated link");
  } else {
    assert(false, "server expected a request line");
  }
  server.close()?!;
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

// A `fullchain.pem`-shaped bundle: more than one PEM block. Real server
// certificates are almost always shipped this way (leaf followed by its issuers),
// and CA bundles likewise, so both backends must accept one. Here the second block
// repeats the self-signed leaf — which is its own issuer — so the bundle is
// well-formed without a second key pair.
_test_cert_chain() u8[] {
  string one = string.from_bytes(_test_cert());
  return (one + one).bytes();
}

// A multi-block PEM works on both ends: as the server's certificate chain and as a
// client trust bundle. This is the regression guard for the macOS import path:
// SecItemImport reports a multi-block PEM as kSecItemTypeAggregate, so a backend
// that gated on the reported item type would reject every real-world certificate
// bundle with "invalid PEM?" while Linux accepted it (T1599).
//
// It pins acceptance only. Both backends currently install just the leaf and drop
// the remaining blocks, so an intermediate CA in a real fullchain.pem never reaches
// the wire — tracked as T1612, which needs a two-level CA/leaf fixture this
// single-certificate one cannot express.
test_tls_certificate_chain_bundle() `test(exclude: wasm, timeout: "20s") {
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, _test_cert_chain(), _test_key())?!;
  int port = listener.local_port;

  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsConfig cfg = TlsConfig.create();
    cfg.add_root_certificate(_test_cert_chain())?!; // trust bundle, also multi-block
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    client.write_string("chain\n")?!;
    client.close()?!;
  };

  TlsStream server = listener.accept()?!;
  if line := server.read_line()?! {
    assert(line == "chain", "server served a multi-block certificate bundle");
  } else {
    assert(false, "server expected a request line");
  }
  server.close()?!;
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

// 256 KiB of recognisable bytes. Deliberately far past both the 16 KiB TLS record
// limit and the 16 KiB ciphertext pump buffer in _fill_in, so a transfer of this
// size spans many records and many refills in both directions.
_bulk_payload() string {
  return "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef".repeat(4096);
}

// Bulk transfer in both directions. Every other round-trip in this file fits inside
// a single TLS record, so nothing else here distinguishes "TLS carries one short
// line" from "TLS carries a stream": this drives many records each way, the
// repeated _fill_in refill loop in read, a single ciphertext queue holding the
// whole 256 KiB before _flush_out drains it, and a receive buffer deliberately
// smaller than one record so decrypted data comes out in fragments.
//
// It matters most for the macOS backend, whose inbound/outbound queues (T1599) are
// hand-written stand-ins for OpenSSL's memory BIOs: a queue that mis-tracked
// head/tail across a refill, or sized a growth wrongly, would pass every
// single-record test in this file and only corrupt a stream once it crossed a
// record boundary.
//
// Two defensive paths measurably stay unreached even here, and this test should not
// be read as covering them. q_append never compacts a partially-drained buffer,
// because Secure Transport always drains the inbound queue before asking for more,
// so head==tail resets it first; and _tcp_write_all never takes its partial-write
// branch, because net.TcpStream.write already parks until the whole buffer is gone.
// Both were checked by breaking them and observing this test still pass.
test_tls_bulk_transfer_spans_many_records() `test(exclude: wasm, timeout: "40s") {
  string payload = _bulk_payload();
  int size = payload.len;
  assert(size == 262144, "bulk payload is 256 KiB");

  TlsListener listener = TlsListener.bind("127.0.0.1", 0, _test_cert(), _test_key())?!;
  int port = listener.local_port;

  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsConfig cfg = TlsConfig.insecure();
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    client.write_string(_bulk_payload())?!; // many records out
    u8[] back = client.read_all()?!; // many records in, to close_notify
    assert(back.len == size, "client received every byte of the bulk response");
    assert(string.from_bytes(back) == _bulk_payload(),
    "client bulk response is byte-exact after decryption");
  };

  TlsStream server = listener.accept()?!;
  u8[] got = u8[]();
  u8[] buf = u8[].filled(0u8, 4096); // smaller than one TLS record, on purpose
  while got.len < size {
    int n = server.read(buf)?!;
    assert(n > 0, "server must not see end-of-stream mid-payload");
    int i = 0;
    while i < n {
      got.push(buf[i]);
      i = i + 1;
    }
  }
  assert(got.len == size, "server read exactly the payload, no trailing bytes");
  assert(string.from_bytes(got) == payload, "server bulk request is byte-exact after decryption");

  server.write_string(payload)?!;
  server.close()?!;
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

// Requesting a TLS 1.3 minimum must never break a connection, and must never make a
// backend claim a version it cannot speak. This is the live-connection counterpart
// to the config-only call in test_tls_config_insecure_and_default, which exercises
// set_min_version but observes nothing about the resulting handshake.
//
// The two backends diverge here by design (T1599): OpenSSL honours the floor and
// negotiates 1.3, while Secure Transport implements no TLS 1.3 at all — its
// SSLSetProtocolVersionMin rejects kTLSProtocol13, so the request is dropped and the
// connection stays at TLS 1.2 rather than failing. Both outcomes are asserted, so
// neither a macOS backend that silently reported 1.3 nor a Linux one that quietly
// downgraded would pass.
test_tls_min_version_1_3_request() `test(exclude: wasm, timeout: "20s") {
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, _test_cert(), _test_key())?!;
  int port = listener.local_port;

  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsConfig cfg = TlsConfig.insecure();
    cfg.set_min_version(TlsVersion.tls_1_3);
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    client.write_string("min13\n")?!;
    client.close()?!;
  };

  TlsStream server = listener.accept()?!;
  bool is_13 = false;
  match server.version {
    TlsVersion.tls_1_2 => {
    },
    TlsVersion.tls_1_3 => {
      is_13 = true;
    },
  }
  if _tls13_possible() {
    assert(is_13, "a backend with TLS 1.3 must honour a 1.3 minimum and negotiate 1.3");
  } else {
    assert(!is_13, "a backend without TLS 1.3 must stay at 1.2, not claim 1.3");
  }

  if line := server.read_line()?! {
    assert(line == "min13", "the connection carries data whichever version was negotiated");
  } else {
    assert(false, "server expected a request line");
  }
  server.close()?!;
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

// Three connections in a row over one listener context and one client config. Every
// test above uses each context exactly once, so nothing yet covers what a server
// actually does: hold a context and serve session after session from it.
//
// This is the resource-invariant test for the shared context. On macOS the server
// context owns a SecIdentity built once at bind time and handed to every session,
// so an unbalanced retain/release would either leak per connection or over-release
// and crash on the second handshake — both invisible to a single-session test. The
// suite's leak detector settles the first half; reaching the third round-trip
// settles the second.
test_tls_sequential_sessions_reuse_context() `test(exclude: wasm, timeout: "30s") {
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, _test_cert(), _test_key())?!;
  int port = listener.local_port;

  go {
    TlsConfig cfg = TlsConfig.insecure(); // one config, reused by all three sessions
    int i = 0;
    while i < 3 {
      net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
      TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
      client.write_string("req-" + i.to_string() + "\n")?!;
      if reply := client.read_line()?! {
        assert(reply == "ack-" + i.to_string(), "client got the reply for its own session");
      } else {
        assert(false, "client expected a reply line");
      }
      client.close()?!;
      i = i + 1;
    }
  };

  int served = 0;
  while served < 3 {
    TlsStream server = listener.accept()?!;
    assert(server.cipher_suite.len > 0, "every session negotiates a cipher suite");
    if line := server.read_line()?! {
      assert(line == "req-" + served.to_string(), "server read session " + served.to_string());
      server.write_string("ack-" + served.to_string() + "\n")?!;
    } else {
      assert(false, "server expected a request line");
    }
    server.close()?!;
    served = served + 1;
  }
  assert(served == 3, "three sessions served from one context");
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

// The Reader/Writer structural defaults work over TLS, not merely type-check
// against it. The witness functions above prove TlsStream satisfies both views at
// compile time but are never called, so nothing yet runs Reader.read_byte or
// Writer.write_line through an encrypted stream — and those defaults are how
// layered code (an HTTPS client over a generic byte stream) actually drives it.
// The defaults live on the interfaces, so they are reachable only through a view;
// these two helpers are what force the dispatch back into TlsStream.read/write.
_tls_write_line_via_writer(Writer ~w, string s) {
  w.write_line(s)?!;
}

// Reads one byte at a time through the Reader view until the line terminator,
// walking the decrypted record byte by byte.
_tls_read_line_via_reader(Reader ~r) string {
  u8[] got = u8[]();
  while true {
    if b := r.read_byte() {
      if b == 10 {
        break;
      }
      if b != 13 {
        got.push(b);
      }
    } else {
      break;
    }
  }
  return string.from_bytes(got);
}

test_tls_reader_writer_defaults() `test(exclude: wasm, timeout: "20s") {
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, _test_cert(), _test_key())?!;
  int port = listener.local_port;

  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsConfig cfg = TlsConfig.insecure();
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    _tls_write_line_via_writer(client, "defaults");
    client.close()?!;
  };

  TlsStream server = listener.accept()?!;
  assert(_tls_read_line_via_reader(server) == "defaults",
  "Reader.read_byte decrypted the line written by Writer.write_line");

  server.close()?!;
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

// A second, entirely unrelated self-signed CA (CN=unrelated-authority, its own
// key pair). It never appears on the wire — its only job is to be a *valid*
// trust anchor that does not cover the server's certificate, which is what
// separates "this client has no trust store" from "this client has one and the
// chain does not verify against it". Generated by the same recipe as _test_cert
// (SAN + EKU serverAuth + pre-2020 notBefore, so Apple's temporal cap and EKU
// policy accept it as an anchor on macOS too).
_unrelated_cert() u8[] {
  return "-----BEGIN CERTIFICATE-----\nMIIDNjCCAh6gAwIBAgIBAjANBgkqhkiG9w0BAQsFADAeMRwwGgYDVQQDExN1bnJl\nbGF0ZWQtYXV0aG9yaXR5MB4XDTE5MDEwMTAwMDAwMFoXDTM5MDEwMTAwMDAwMFow\nHjEcMBoGA1UEAxMTdW5yZWxhdGVkLWF1dGhvcml0eTCCASIwDQYJKoZIhvcNAQEB\nBQADggEPADCCAQoCggEBAJhWQ3GWADIqqHrrdoGLMUIqczrCZomk7WWuIhReNRQe\n21Nt/mBAZh+txYe1YZg/atviExTHKulWVwKqEqRlGzhbMAyvF/H4hnsyt3nEtGIM\nA6Kx9/Fl848X9zQ2a+A6TygrXxok3Az2RE04pCvKnyQeiCCvHgm8yjr1pO/yqCVb\nJnhO+sukWyaav5YzrkVLQZ45iKk0UQ0qCGztH+XWt7xDGGYRJWzdedjm4NREP+ji\nyR9gtMV+2psvCqpEanPktELO4HyQD3sxSxaGqzWnhZ/9gI7F8nRHQJbj1Xs6sv1j\nKROh2SUk5nZdD6JyCrDlxUoZycQWZQNCKC/FsyefO8MCAwEAAaN/MH0wDgYDVR0P\nAQH/BAQDAgKkMBMGA1UdJQQMMAoGCCsGAQUFBwMBMA8GA1UdEwEB/wQFMAMBAf8w\nHQYDVR0OBBYEFHISgjzxWDEqTaVAiXEnf5u7hZ7UMCYGA1UdEQQfMB2CG3VucmVs\nYXRlZC1hdXRob3JpdHkuaW52YWxpZDANBgkqhkiG9w0BAQsFAAOCAQEARxPRTv02\n+OlLA3hqbD9qjCWSj195t0Q6HswVKZI4d+P7LDJQ1aAw59j5eVlgMG4iyBaiU2ME\nRQ+76+7NNMzNVGHKaktkoMDe2wLMC7ZrKK4tVvu58fr+9T/PYPDfOP/479KkdWgH\n2hkkPb+N3IWvio/JOCcGhL3tsb5UgPkv2JK2UmJ8Se07pAHG08oKEZu6zFMKza5V\nOUTgNdMX87EV3rbyyV7Wtz6WJLPt6U3X4HUKDyGTXEiLyXCo54GRp6Lj/zCB4d4y\nHK8+Vv0QeKH80iASONT0UOq0cjLX6YZJsUBva2uFEaXv++67C9Fssj9eEOFajWxb\ncIKLBUEJnWvVvg==\n-----END CERTIFICATE-----\n".bytes();
}

// The security property the whole verifying path exists for: a client that has a
// trust store but does NOT trust the server's certificate must refuse the
// connection. Nothing above tested this. test_tls_verified_handshake_and_read_all
// supplies the matching anchor and succeeds; the wrong-host test supplies the
// matching anchor and fails on the *hostname* policy instead. So the trust
// decision itself — chain does not chain up to any anchor — was never observed,
// and a backend that evaluated trust but ignored the verdict would pass both.
//
// The hostname here is the matching "localhost", precisely so the only thing left
// that can reject the connection is the anchor set. On macOS this is the reject
// arm of __promise_tls_check_trust: SecTrustEvaluateWithError returns false, the
// handshake is failed rather than continued, and TlsStream.connect surfaces
// TlsErrorKind.certificate.
//
// Deterministic on both backends and on any host: the anchor supplied is a real
// certificate, so _has_trust_store is true and no_trust_store is off the table,
// and it is not the server's issuer, so no system trust store can rescue the
// chain either.
test_tls_verified_handshake_rejects_untrusted_certificate() `test(exclude: wasm, timeout: "15s") {
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, _test_cert(), _test_key())?!;
  int port = listener.local_port;

  go {
    // The server's accept fails once the client aborts the handshake; swallow it.
    listener.accept()? e {
    };
  };

  net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
  TlsConfig cfg = TlsConfig.create();
  cfg.add_root_certificate(_unrelated_cert())?!; // a real anchor, but the wrong one
  bool caught_cert = false;
  TlsStream.connect(move tcp, "localhost", cfg)? e is TlsError {
    match e.kind {
      TlsErrorKind.certificate => {
        caught_cert = true;
      },
      TlsErrorKind.no_trust_store => {
        assert(false, "a valid anchor was added, so this is not a missing trust store");
      },
      _ => {
        assert(false, "an untrusted chain must surface as a certificate error");
      },
    }
  }!;
  assert(caught_cert, "a verifying client must reject a chain that reaches none of its anchors");
  sleep(Duration.from_millis(100));
}

// Six trust anchors on one config. Every other test adds at most one, which on
// macOS leaves the anchor array's growth path (T1599) entirely unexecuted: the
// backend starts at capacity 0, allocates 4 on the first add, then reallocates to
// 8 and memcpy's the existing entries across on the fifth. A growth that copied
// the wrong byte count, or freed the old array before copying, would corrupt or
// leak — and no single-anchor test can see it.
//
// Both halves of the invariant are asserted. Correctness: after five decoy anchors
// the real one still verifies, so the array survived two reallocations with its
// contents intact and the certificate at index 5 is still the one evaluated
// against. Cleanup: the config drops at end of scope and must release all six
// SecCertificateRefs and both array allocations — an over-retain shows up as a
// leak, and the suite's zero-tolerance leak detector is what checks it.
test_tls_many_trust_anchors_grow_the_anchor_array() `test(exclude: wasm, timeout: "20s") {
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, _test_cert(), _test_key())?!;
  int port = listener.local_port;

  go {
    TlsConfig cfg = TlsConfig.create();
    int i = 0;
    while i < 5 {
      cfg.add_root_certificate(_unrelated_cert())?!; // decoys: 5 crosses cap 4 → 8
      i = i + 1;
    }
    cfg.add_root_certificate(_test_cert())?!; // the sixth is the one that matters
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    client.write_string("anchors\n")?!;
    client.close()?!;
  };

  TlsStream server = listener.accept()?!;
  if line := server.read_line()?! {
    assert(line == "anchors",
    "the trust anchor added after two array growths still verified the chain");
  } else {
    assert(false, "server expected a request line");
  }
  server.close()?!;
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

// Four TLS handshakes in flight at once against one listener. Every other test in
// this file is strictly sequential — one handshake, or three one after another —
// so nothing yet puts two sessions of the same context on the scheduler at the
// same time.
//
// That is the case the backends are most exposed to. Each session owns its own
// engine object but shares the context that holds the server identity, and every
// session parks and resumes on the reactor mid-handshake, interleaving with the
// others. A context whose retain/release is not balanced per session, or a
// per-session buffer queue that was reachable from more than one goroutine, shows
// up here and nowhere else in this file. The reply carries the client's own index
// back, so a session that got another session's plaintext fails rather than
// silently passing.
test_tls_concurrent_sessions() `test(exclude: wasm, timeout: "40s") {
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, _test_cert(), _test_key())?!;
  int port = listener.local_port;
  done := channel[int](capacity: 4);

  int c = 0;
  while c < 4 {
    int id = c;
    go {
      net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
      TlsConfig cfg = TlsConfig.create();
      cfg.add_root_certificate(_test_cert())?!;
      TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
      assert(client.cipher_suite.len > 0, "each concurrent session negotiates a suite");
      client.write_string("hello-" + id.to_string() + "\n")?!;
      if reply := client.read_line()?! {
        assert(reply == "echo-hello-" + id.to_string(),
        "each client received the echo of its own request, not another session's");
      } else {
        assert(false, "client expected a reply line");
      }
      client.close()?!;
      done.send(id);
    };
    c = c + 1;
  }

  // Serve all four. accept() completes handshakes one at a time, but the clients'
  // handshakes are already in flight concurrently behind it.
  int served = 0;
  while served < 4 {
    TlsStream server = listener.accept()?!;
    if line := server.read_line()?! {
      server.write_string("echo-" + line + "\n")?!;
    } else {
      assert(false, "server expected a request line");
    }
    server.close()?!;
    served = served + 1;
  }

  int acked = 0;
  while acked < 4 {
    int _ = (<-done)!;
    acked = acked + 1;
  }
  assert(acked == 4, "all four concurrent TLS sessions completed");
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

// Replacing a config's client certificate before connecting must leave the
// config usable: the second set_client_certificate supersedes the first rather
// than accumulating or corrupting backend state. Ported with the Windows
// backend (T1598), where the credential handle is rebuilt on each call.
test_tls_config_replaces_client_certificate() `test(exclude: wasm, timeout: "20s") {
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, _test_cert(), _test_key())?!;
  int port = listener.local_port;

  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsConfig cfg = TlsConfig.insecure();
    cfg.set_client_certificate(_test_cert(), _test_key())?!;
    cfg.set_client_certificate(_test_cert(), _test_key())?!; // replaces the first
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    client.write_string("recert\n")?!;
    client.close()?!;
  };

  TlsStream server = listener.accept()?!;
  if line := server.read_line()?! {
    assert(line == "recert", "a config whose client certificate was replaced still connects");
  } else {
    assert(false, "server expected a request line");
  }
  server.close()?!;
  listener.close()?!;
  sleep(Duration.from_millis(150));
}

// --- server-side building blocks: TlsServerConfig, TlsStream.accept,
// --- TlsStream.close_gracefully (T0079).
//
// These are what let a server keep its accept loop plaintext and run each TLS
// handshake on the connection's own goroutine — the shape modules/http's
// Server.bind_tls is built on. Synchronization here is by channel handshake
// only (T1632).

test_tls_server_config_create_and_errors() `test(exclude: wasm) {
  // A well-formed cert/key pair loads.
  TlsServerConfig good = TlsServerConfig.create(_test_cert(), _test_key())?!;

  // A certificate that is not PEM at all is rejected as a certificate error.
  u8[] garbage = "not a certificate".bytes();
  bool cert_rejected = false;
  TlsServerConfig.create(garbage, _test_key())? e is TlsError {
    cert_rejected = match e.kind {
      TlsErrorKind.certificate => true,
      _ => false,
    };
  }!;
  assert(cert_rejected, "an invalid certificate PEM raises TlsErrorKind.certificate");

  // A key that does not match the certificate is rejected too.
  u8[] badkey = "-----BEGIN PRIVATE KEY-----\nbm90IGEga2V5\n-----END PRIVATE KEY-----\n".bytes();
  bool key_rejected = false;
  TlsServerConfig.create(_test_cert(), badkey)? e is TlsError {
    key_rejected = match e.kind {
      TlsErrorKind.certificate => true,
      _ => false,
    };
  }!;
  assert(key_rejected, "an invalid private key PEM raises TlsErrorKind.certificate");
}

test_tls_stream_accept_on_plain_listener() `test(exclude: wasm, timeout: "20s") {
  // The server binds a bare TCP listener and upgrades the accepted stream
  // itself, rather than letting TlsListener handshake inside accept.
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;
  channel[bool] done = channel[bool](capacity: 1);

  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsConfig cfg = TlsConfig.insecure();
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    client.write_string("upgraded\n")?!;
    if reply := client.read_line()?! {
      assert(reply == "echo:upgraded", "client received the echo over the upgraded connection");
    } else {
      assert(false, "client expected an echo line");
    }
    client.close()?!;
    done.send(true);
    return;
  };

  net.TcpStream raw = listener.accept()?!;
  TlsServerConfig server_config = TlsServerConfig.create(_test_cert(), _test_key())?!;
  TlsStream server = TlsStream.accept(move raw, server_config)?!;
  assert(server.cipher_suite.len > 0, "server negotiated a cipher suite after upgrading");
  if line := server.read_line()?! {
    assert(line == "upgraded", "server framed plaintext off the upgraded stream");
    server.write_string("echo:" + line + "\n")?!;
  } else {
    assert(false, "server expected a request line");
  }
  server.close()?!;
  listener.close()?!;
  _ := <-done;
}

test_tls_stream_accept_reuses_one_server_config() `test(exclude: wasm, timeout: "30s") {
  // One TlsServerConfig serves several sequential handshakes — the shape a
  // server needs, where the credentials outlive every individual connection.
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;
  TlsServerConfig server_config = TlsServerConfig.create(_test_cert(), _test_key())?!;
  channel[bool] done = channel[bool](capacity: 1);

  go {
    int i = 0;
    while i < 3 {
      net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
      TlsConfig cfg = TlsConfig.insecure();
      TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
      client.write_string("ping " + i.to_string() + "\n")?!;
      if reply := client.read_line()?! {
        assert(reply == "pong " + i.to_string(), "client saw the matching reply");
      } else {
        assert(false, "client expected a reply line");
      }
      client.close()?!;
      i = i + 1;
    }
    done.send(true);
    return;
  };

  int served = 0;
  while served < 3 {
    net.TcpStream raw = listener.accept()?!;
    TlsStream server = TlsStream.accept(move raw, server_config)?!;
    if line := server.read_line()?! {
      assert(line == "ping " + served.to_string(), "server read the request");
      server.write_string("pong " + served.to_string() + "\n")?!;
    } else {
      assert(false, "server expected a request line");
    }
    server.close()?!;
    served = served + 1;
  }
  listener.close()?!;
  _ := <-done;
}

test_tls_stream_accept_fails_on_plain_tcp_peer() `test(exclude: wasm, timeout: "15s") {
  // A peer that speaks no TLS makes the server-side handshake fail with a
  // handshake error — and only that connection is lost.
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;
  channel[bool] done = channel[bool](capacity: 1);

  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    u8[] junk = "GET / HTTP/1.1\r\nHost: x\r\n\r\n".bytes();
    tcp.write(junk)? e {
      // the server may already have torn the connection down
      0;
    };
    u8[] sink = u8[].filled(0u8, 256);
    tcp.read(sink)? e {
      0;
    };
    tcp.close()? e {
    };
    done.send(true);
    return;
  };

  net.TcpStream raw = listener.accept()?!;
  TlsServerConfig server_config = TlsServerConfig.create(_test_cert(), _test_key())?!;
  bool failed = false;
  TlsStream.accept(move raw, server_config)? e is TlsError {
    failed = match e.kind {
      TlsErrorKind.handshake => true,
      _ => false,
    };
  }!;
  assert(failed, "a plaintext peer raises TlsErrorKind.handshake on the server side");
  listener.close()?!;
  _ := <-done;
}

test_tls_close_gracefully_delivers_the_last_write() `test(exclude: wasm, timeout: "20s") {
  // The server writes a reply and closes while the client's request bytes are
  // still unread. close_gracefully must FIN-and-drain rather than reset, so the
  // reply is intact at the client (the TLS counterpart of T1322).
  TlsListener listener = TlsListener.bind("127.0.0.1", 0, _test_cert(), _test_key())?!;
  int port = listener.local_port;
  channel[bool] wrote = channel[bool](capacity: 1);
  channel[bool] done = channel[bool](capacity: 1);

  go {
    net.TcpStream tcp = net.TcpStream.connect("127.0.0.1", port)?!;
    TlsConfig cfg = TlsConfig.insecure();
    TlsStream client = TlsStream.connect(move tcp, "localhost", cfg)?!;
    // The server never reads this: it is exactly the unread inbound data that
    // close_gracefully has to drain.
    client.write_string("a request the server will never read\n")?!;
    wrote.send(true);
    u8[] all = client.read_all()?!;
    assert(string.from_bytes(all) == "server reply\n", "the reply survived the server's close");
    client.close()?!;
    done.send(true);
    return;
  };

  TlsStream server = listener.accept()?!;
  _ := <-wrote;
  server.write_string("server reply\n")?!;
  server.close_gracefully();
  listener.close()?!;
  _ := <-done;
}

test_tls_listener_bind_releases_credentials_when_the_socket_bind_fails() `test(exclude: wasm) {
  // TlsListener.bind builds its TlsServerConfig before it opens the socket, so
  // a failing socket bind must still release the backend context. That release
  // is now drop-on-raise rather than an explicit free (T0079 moved the context
  // into TlsServerConfig), which makes the per-test leak detector the thing
  // that actually proves it — this test exists to put that path under it.
  //
  // "example" is not an IPv4 literal, which is what net.TcpListener.bind
  // requires, so the bind fails the same way on every platform with a backend.
  bool caught_io = false;
  TlsListener.bind("example", 0, _test_cert(), _test_key())? e is TlsError {
    match e.kind {
      TlsErrorKind.io => {
        caught_io = true;
      },
      _ => {
      },
    }
  }!;
  assert(caught_io, "a failed socket bind is reported as TlsErrorKind.io");
}
