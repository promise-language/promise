// tests/std/wide_int_test.pr — wide integer types (i128/u128/i256/u256/i512/u512)
// --- Arithmetic (128) ---
u128_arith() `test {
  u128 a = 1000000000000000000000u128; // 10^21, exceeds u64
  u128 b = 3u128;
  assert(a + b == 1000000000000000000003u128, "u128 add");
  assert(a - b == 999999999999999999997u128, "u128 sub");
  assert(a * b == 3000000000000000000000u128, "u128 mul");
  assert(a / b == 333333333333333333333u128, "u128 div"); // exercises __udivti3
  assert(a % b == 1u128, "u128 rem");
}

i128_arith() `test {
  i128 a = -1000000000000000000000i128;
  i128 b = 7i128;
  assert(a + b == -999999999999999999993i128, "i128 add");
  assert(a * -1i128 == 1000000000000000000000i128, "i128 negate mul");
  assert(a / b == -142857142857142857142i128, "i128 div"); // exercises __divti3
  assert(-a > 0i128, "i128 unary minus");
}

// --- Comparison / bitwise (128) ---
u128_bitwise() `test {
  u128 x = 0xff00ff00ff00ff00ff00ff00ff00ff00u128;
  u128 y = 0x00ff00ff00ff00ff00ff00ff00ff00ffu128;
  assert((x & y) == 0u128, "and");
  assert((x | y) == u128.max, "or");
  assert((x ^ y) == u128.max, "xor");
  assert(~0u128 == u128.max, "not");
  assert((1u128 << 100u128) >> 100u128 == 1u128, "shift");
  assert(x > y, "gt");
  assert(y < x, "lt");
}

// --- Boundaries ---
wide_bounds() `test {
  assert(u128.min == 0u128, "u128 min");
  assert(u128.max == 340282366920938463463374607431768211455u128, "u128 max");
  assert(i128.max == 170141183460469231731687303715884105727i128, "i128 max");
  assert(i128.min == -170141183460469231731687303715884105727i128 - 1i128, "i128 min");
  assert(i128.min < 0i128, "i128 min negative");
  assert(i128.max + 1i128 == i128.min, "i128 wrap");
  assert(u256.max == ~0u256, "u256 max");
  assert(u512.max == ~0u512, "u512 max");
}

// --- Casts ---
wide_casts() `test {
  i128 a = 42i128;
  i64 narrow = a as! i64;
  assert(narrow == 42i64, "widen->narrow");
  i256 wide = a as! i256;
  assert(wide == 42i256, "widen 128->256");
  u128 ub = a as! u128;
  assert(ub == 42u128, "signed->unsigned same width");
  i128 fromi64 = 12345i64 as! i128;
  assert(fromi64 == 12345i128, "i64->i128 sign extend");
  // narrow truncates lower bits
  u128 big = 0x1_0000_0000_0000_0001u128;
  assert((big as! u64) == 1u64, "truncate to u64");
  // signed widen sign-extends
  i128 neg = -5i128;
  assert((neg as! i256) == -5i256, "negative sign extend");
  // float <-> wide
  u128 fromf = 100.0 as! u128;
  assert(fromf == 100u128, "f64->u128");
  f64 tof = 256u128 as! f64;
  assert(tof == 256.0, "u128->f64");
}

// --- to_string / parse round-trips (base 16 default + explicit base 10) ---
wide_format_parse() `test {
  u128 v = 0xdeadbeefcafebabeu128;
  assert(v.to_string() == "deadbeefcafebabe", "default base 16");
  assert(v.to_string(base: 10) == "16045690984503098046", "base 10");
  assert(v.to_string(prefix: true) == "0xdeadbeefcafebabe", "hex prefix");
  // round trip via Scanner using the default base (16). Exercises the
  // Parse-interface default-param path through a concrete call. (scan[u128](s)
  // would route the same call through generic structural dispatch, which drops
  // the defaulted base — tracked as T1395; use a direct call until it lands.)
  u128 rt16 = u128.parse(Scanner(s: "deadbeefcafebabe"))?!;
  assert(rt16 == v, "parse default base 16");
  u128 rt10 = u128.parse(Scanner(s: "16045690984503098046"), 10)?!;
  assert(rt10 == v, "parse base 10");
  // signed
  i128 s = -255i128;
  assert(s.to_string(base: 10) == "-255", "signed base 10");
  assert(s.to_string() == "-ff", "signed base 16");
  i128 sp = i128.parse(Scanner(s: "-ff"), 16)?!;
  assert(sp == s, "parse signed base 16");
}

// --- Range / iteration ---
wide_range() `test {
  u128 sum = 0u128;
  for i in 0u128..5u128 {
    sum = sum + i;
  }
  assert(sum == 10u128, "exclusive range"); // 0+1+2+3+4
  u128 total = 0u128;
  for i in 1u128..=3u128 {
    total = total + i;
  }
  assert(total == 6u128, "inclusive range");
}

// --- Hash (usable as map keys / set members) ---
wide_hash() `test {
  Set[u128] s = Set[u128]();
  s.add(0xffffffffffffffffffffffffffffffffu128);
  s.add(1u128);
  assert(s.contains(0xffffffffffffffffffffffffffffffffu128), "set contains max");
  assert(s.contains(1u128), "set contains 1");
  assert(!s.contains(2u128), "set absent");
  map[u128, string] m = map[u128, string]();
  m[42u128] = "answer";
  assert(m[42u128]! == "answer", "map lookup");
}

// --- 256-bit arithmetic + division ---
wide_256() `test {
  u256 a = 0x1_00000000_00000000_00000000_00000000u256; // 2^128
  u256 b = a * a; // 2^256 overflow -> 0 (wraps)
  assert(b == 0u256, "256 mul wrap");
  u256 c = a - 1u256;
  assert(c == 0xffffffffffffffffffffffffffffffffu256, "2^128 - 1"); // 2^128 - 1
  u256 d = u256.max / 2u256; // exercises 256-bit division libcall
  assert(d == 0x7fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffu256, "256 div");
  assert(d.to_string(base: 10).len == 77, "256 decimal width");
}

// --- 512-bit arithmetic + division ---
wide_512() `test {
  u512 one = 1u512;
  u512 big = one << 256u512;
  assert(big / big == 1u512, "512 div self");
  assert(big % (big - 1u512) == 1u512, "512 rem"); // exercises 512-bit rem libcall
  assert((big - 1u512).to_string() == "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff", "512 hex");
  i512 neg = -12345678901234567890123456789012345678901234567890i512;
  assert(neg.to_string(base: 10) == "-12345678901234567890123456789012345678901234567890", "512 signed decimal");
}

// --- parse error paths (raise) ---
wide_parse_errors() `test {
  // Empty input: no bytes at all -> "unexpected end of input".
  bool empty_caught = false;
  u128 e1 = u128.parse(Scanner(s: ""), 16)? err {
    assert(err.message == "unexpected end of input", "empty msg");
    empty_caught = true;
    0u128;
  };
  assert(empty_caught, "empty input raises");
  assert(e1 == 0u128, "empty fallback value");

  // A leading non-digit character yields no digits -> "expected digit".
  bool nondigit_caught = false;
  u128 e2 = u128.parse(Scanner(s: "xyz"), 10)? err {
    assert(err.message == "expected digit", "nondigit msg");
    nondigit_caught = true;
    0u128;
  };
  assert(nondigit_caught, "non-digit start raises");

  // Signed: a lone minus with no following digit -> "expected digit".
  bool minus_caught = false;
  i128 e3 = i128.parse(Scanner(s: "-"), 10)? err {
    assert(err.message == "expected digit", "lone minus msg");
    minus_caught = true;
    0i128;
  };
  assert(minus_caught, "lone minus raises");

  // Signed empty input (never started) -> "unexpected end of input".
  bool sempty_caught = false;
  i256 e4 = i256.parse(Scanner(s: ""), 10)? err {
    assert(err.message == "unexpected end of input", "signed empty msg");
    sempty_caught = true;
    0i256;
  };
  assert(sempty_caught, "signed empty raises");
}

// --- parse stops at first out-of-base / non-digit character ---
wide_parse_partial() `test {
  // Base 10: parsing halts at the first non-digit, returning the prefix.
  u128 p = u128.parse(Scanner(s: "10zzz"), 10)?!;
  assert(p == 10u128, "trailing garbage stops parse");
  // Base 2: '0'/'1' consumed, '9' is out of range -> stops. "101" = 5.
  u128 b2 = u128.parse(Scanner(s: "1019"), 2)?!;
  assert(b2 == 5u128, "out-of-base digit stops parse");
}

// --- uppercase hex digits (exercises _digit_value A-Z branch) ---
wide_uppercase_parse() `test {
  u128 v = u128.parse(Scanner(s: "DEADBEEF"), 16)?!;
  assert(v == 0xdeadbeefu128, "uppercase hex parses");
  // Mixed case must also work.
  u256 m = u256.parse(Scanner(s: "AbCdEf"), 16)?!;
  assert(m == 0xabcdefu256, "mixed case hex parses");
  // Signed negative uppercase.
  i128 n = i128.parse(Scanner(s: "-FF"), 16)?!;
  assert(n == -255i128, "negative uppercase hex parses");
}

// --- to_string width / fill / prefix formatting ---
wide_format_width_fill() `test {
  u128 v = 0xabu128; // 171
  assert(v.to_string(width: 6) == "    ab", "space pad to width");
  assert(v.to_string(width: 6, fill: '0') == "0000ab", "zero pad to width");
  assert(v.to_string(base: 10, width: 5, fill: '0') == "00171", "decimal zero pad");
  assert(v.to_string(base: 16, prefix: true, width: 8, fill: '0') == "0x0000ab", "prefix + pad");
  // Width narrower than the value is a no-op (no truncation).
  assert(v.to_string(width: 1) == "ab", "width below length");
  // Signed negative with prefix + decimal.
  i128 n = -171i128;
  assert(n.to_string(base: 10) == "-171", "signed decimal");
  assert(n.to_string(prefix: true) == "-0xab", "signed hex prefix");
}

// --- formatting edge cases ---
wide_format_edge() `test {
  // Zero renders as "0" in every base and at every width.
  assert(0u128.to_string() == "0", "zero hex");
  assert(0u256.to_string(base: 10) == "0", "zero decimal 256");
  assert(0u512.to_string() == "0", "zero hex 512");
  // base < 2 is guarded and yields "0" rather than looping forever.
  assert(0xffu128.to_string(base: 1) == "0", "base 1 guarded");
  assert(0xffu128.to_string(base: 0) == "0", "base 0 guarded");
  // Base 2 and base 36 exercise the division slow path at the extremes.
  assert(5u128.to_string(base: 2) == "101", "base 2");
  assert(35u128.to_string(base: 36) == "z", "base 36 max digit");
}

// --- increment / decrement operators ---
wide_incr_decr() `test {
  u128 a = 5u128;
  a++;
  assert(a == 6u128, "u128 increment");
  a--;
  assert(a == 5u128, "u128 decrement");
  i256 b = -1i256;
  b++;
  assert(b == 0i256, "i256 increment across zero");
  b--;
  assert(b == -1i256, "i256 decrement across zero");
}

// --- remaining comparison operators (<=, >=, !=) ---
wide_comparisons() `test {
  assert(5u128 <= 5u128, "u128 le equal");
  assert(5u128 <= 6u128, "u128 le less");
  assert(!(6u128 <= 5u128), "u128 le false");
  assert(6u128 >= 6u128, "u128 ge equal");
  assert(6u128 >= 5u128, "u128 ge greater");
  assert(5u128 != 6u128, "u128 ne");
  assert(!(5u128 != 5u128), "u128 ne false");
  // Signed comparisons must treat the sign bit correctly.
  assert(-5i256 < -3i256, "i256 negative ordering");
  assert(-5i256 <= -5i256, "i256 negative le");
  assert(-3i256 >= -5i256, "i256 negative ge");
  assert(i512.min < i512.max, "i512 min < max");
}

// --- Format structural interface via a Writer (format! method) ---
_wide_write_through(Writer ~w, u128 v) {
  v.format(w)?!;
}

wide_format_interface() `test {
  Builder b = Builder();
  _wide_write_through(b, 0xabu128);
  assert(b.to_string() == "ab", "format! writes hex through Writer");
  // Signed value through the same path.
  Builder b2 = Builder();
  (-255i128).format(b2)?!;
  assert(b2.to_string() == "-ff", "signed format! through Writer");
}

// --- signed div/rem sign matrix (exercises __divti3 + __modti3 directly) ---
// Truncated (toward-zero) semantics: quotient sign = xor of operand signs,
// remainder sign = dividend sign. __modti3 is otherwise untested at runtime,
// and __divti3 was only exercised with a single sign combination (T1399).
wide_signed_div_rem_matrix() `test {
  // Operands wider than u64 so the op cannot be strength-reduced to a 64-bit path.
  i128 a = 1000000000000000000007i128; // 10^21 + 7 (prime-ish, non-divisible by 3)
  i128 b = 3i128;
  // +/+
  assert(a / b == 333333333333333333335i128, "i128 +/+ div");
  assert(a % b == 2i128, "i128 +/+ rem");
  // -/+  (quotient negative, remainder takes dividend's minus sign)
  assert((-a) / b == -333333333333333333335i128, "i128 -/+ div");
  assert((-a) % b == -2i128, "i128 -/+ rem");
  // +/-  (quotient negative, remainder stays positive — dividend is positive)
  assert(a / (-b) == -333333333333333333335i128, "i128 +/- div");
  assert(a % (-b) == 2i128, "i128 +/- rem");
  // -/-  (quotient positive, remainder negative — dividend is negative)
  assert((-a) / (-b) == 333333333333333333335i128, "i128 -/- div");
  assert((-a) % (-b) == -2i128, "i128 -/- rem");
}

// --- division edge cases (quotient 0, exact, by one, self) ---
wide_div_edge() `test {
  u128 big = 340282366920938463463374607431768211453u128; // u128.max - 2
  // Dividend smaller than divisor: quotient 0, remainder = dividend.
  assert(7u128 / big == 0u128, "u128 quotient zero");
  assert(7u128 % big == 7u128, "u128 rem is dividend");
  // Exact division: remainder 0.
  assert((big - 1u128) / 2u128 == 170141183460469231731687303715884105726u128, "u128 exact div");
  assert((big - 1u128) % 2u128 == 0u128, "u128 exact rem zero");
  // Divide by one and divide self.
  assert(big / 1u128 == big, "u128 div by one");
  assert(big / big == 1u128, "u128 div self");
  assert(big % big == 0u128, "u128 rem self zero");
  // Signed: i128.min divided by a large magnitude — most-negative dividend path.
  assert(i128.min / i128.max == -1i128, "i128 min / max");
  assert(i128.min % i128.max == -1i128, "i128 min % max");
}

// --- wide signed div/rem (256/512 go through ExpandLargeDivRem, not the ti3 libcalls) ---
wide_signed_256_512() `test {
  i256 a = -123456789012345678901234567890i256;
  i256 b = 1000000i256;
  assert(a / b == -123456789012345678901234i256, "i256 -/+ div");
  assert(a % b == -567890i256, "i256 -/+ rem takes dividend sign");
  assert(a / (-b) == 123456789012345678901234i256, "i256 -/- div positive");
  assert(a % (-b) == -567890i256, "i256 -/- rem takes dividend sign");

  i512 c = -1000000000000000000000000000000000000000000000000000i512;
  i512 d = 7i512;
  assert(c / d == -142857142857142857142857142857142857142857142857142i512, "i512 -/+ div");
  assert(c % d == -6i512, "i512 -/+ rem");
  assert(c / (-d) == 142857142857142857142857142857142857142857142857142i512, "i512 -/- div");
}

// --- encode / decode round-trip (decimal string, lossless) ---
wide_encode_decode() `test {
  u128 v = u128.max;
  string s = v.to_string(base: 10);
  u128 back = u128.parse(Scanner(s: move s), 10)?!;
  assert(back == v, "u128 decimal round-trip");

  i256 n = -99999999999999999999999999999999i256;
  string sn = n.to_string(base: 10);
  i256 bn = i256.parse(Scanner(s: move sn), 10)?!;
  assert(bn == n, "i256 negative decimal round-trip");
}

// --- opaque-divisor div/rem (actually reaches the __*ti3 libcalls) ---
// Divisors the optimizer cannot see as constants, so `/` and `%` reach the
// __udivti3/__umodti3/__divti3/__modti3 libcalls instead of being strength-
// reduced to multiply+shift. Every other div test here uses literal divisors
// and so never exercises the libcall ABI (T1414). Operands are pushed onto a
// vector at runtime rather than written as a vector literal — a literal would
// take the static .rodata path, which corrupts >64-bit wide-int elements
// (T1418).
_wide_pick[T](T[] v, int i) T {
  return v[i];
}

wide_div_opaque_divisor() `test {
  u128[] uv = [];
  uv.push(1000000000000000000007u128);
  uv.push(3u128);
  u128 ua = _wide_pick(uv, 0);
  u128 ub = _wide_pick(uv, 1);
  assert(ua == 1000000000000000000007u128, "u128 opaque operand intact");
  assert(ua / ub == 333333333333333333335u128, "u128 opaque div");
  assert(ua % ub == 2u128, "u128 opaque rem");
  assert(u128.max / ub == 113427455640312821154458202477256070485u128, "u128 opaque max div");
  assert(u128.max % ub == 0u128, "u128 opaque max rem");

  i128[] iv = [];
  iv.push(-1000000000000000000007i128);
  iv.push(3i128);
  iv.push(1000000000000000000007i128);
  i128 ia = _wide_pick(iv, 0);
  i128 ib = _wide_pick(iv, 1);
  i128 ip = _wide_pick(iv, 2);
  assert(ip / ib == 333333333333333333335i128, "i128 opaque +/+ div");
  assert(ip % ib == 2i128, "i128 opaque +/+ rem");
  assert(ia / ib == -333333333333333333335i128, "i128 opaque -/+ div");
  assert(ia % ib == -2i128, "i128 opaque -/+ rem");
  assert(ip / (0i128 - ib) == -333333333333333333335i128, "i128 opaque +/- div");
  assert(ip % (0i128 - ib) == 2i128, "i128 opaque +/- rem");
  assert(ia / (0i128 - ib) == 333333333333333333335i128, "i128 opaque -/- div");
  assert(ia % (0i128 - ib) == -2i128, "i128 opaque -/- rem");
}

// The div/rem edge cases (quotient zero, self-division, divide-by-one, zero
// dividend, divisor wider than u64) are all covered above by wide_div_edge with
// LITERAL divisors — which LLVM strength-reduces to multiply+shift, so none of
// them ever reach __udivti3/__umodti3. Re-run the same shapes with opaque
// divisors so the shift-subtract loop and the libcall ABI actually see them.
wide_div_opaque_unsigned_edge() `test {
  u128[] uv = [];
  uv.push(340282366920938463463374607431768211453u128); // u128.max - 2
  uv.push(1u128);
  uv.push(18446744073709551629u128); // 2^64 + 13: > u64 and not a power of two
  uv.push(0u128);
  u128 big = _wide_pick(uv, 0);
  u128 one = _wide_pick(uv, 1);
  u128 wide_d = _wide_pick(uv, 2);
  u128 zero = _wide_pick(uv, 3);

  // Dividend smaller than the divisor: quotient 0, remainder = dividend.
  assert(7u128 / big == 0u128, "opaque quotient zero");
  assert(7u128 % big == 7u128, "opaque rem is dividend");
  // Dividend equal to the divisor, and divide-by-one.
  assert(big / big == 1u128, "opaque div self");
  assert(big % big == 0u128, "opaque rem self zero");
  assert(big / one == big, "opaque div by one");
  assert(big % one == 0u128, "opaque rem by one");
  // Zero dividend must exit the shift-subtract loop immediately.
  assert(zero / big == 0u128, "opaque zero dividend div");
  assert(zero % big == 0u128, "opaque zero dividend rem");
  // A divisor whose HIGH 64 bits are set: both limbs of the second operand have
  // to survive the call. A wrapper that reads the operand pointer as the value
  // (the original T1414 failure) or that keeps only the low word gets this wrong.
  assert(u128.max / wide_d == 18446744073709551603u128, "opaque >2^64 divisor div");
  assert(u128.max % wide_d == 168u128, "opaque >2^64 divisor rem");
  // Both operands opaque and both wider than u64.
  assert(big / wide_d == 18446744073709551603u128, "opaque/opaque wide div");
  assert(big % wide_d == 166u128, "opaque/opaque wide rem");
}

wide_div_opaque_signed_edge() `test {
  i128[] iv = [];
  iv.push(3i128);
  iv.push(18446744073709551629i128); // 2^64 + 13
  iv.push(i128.max);
  iv.push(i128.min);
  i128 three = _wide_pick(iv, 0);
  i128 wide_d = _wide_pick(iv, 1);
  i128 imax = _wide_pick(iv, 2);
  i128 imin = _wide_pick(iv, 3);

  // i128.min has no positive counterpart, so the branchless magnitude
  // (v ^ mask) - mask wraps it back to itself — which is the correct UNSIGNED
  // 2^127 for the division loop. Any "fix-up" that clamps or negates loses the
  // top bit and silently halves the quotient.
  assert(i128.min / three == -56713727820156410577229101238628035242i128, "opaque min div");
  assert(i128.min % three == -2i128, "opaque min rem");
  assert(i128.min / imax == -1i128, "opaque min / max div");
  assert(i128.min % imax == -1i128, "opaque min / max rem");
  assert(i128.min / imin == 1i128, "opaque min / min div");
  assert(i128.min % imin == 0i128, "opaque min / min rem");
  // Dividend smaller in magnitude than a most-negative divisor.
  assert(i128.max / imin == 0i128, "opaque max / min div");
  assert(i128.max % imin == i128.max, "opaque max / min rem");
  // Divisor wider than u64, both dividend signs (quotient sign = xor of signs,
  // remainder sign = dividend sign).
  assert(i128.max / wide_d == 9223372036854775801i128, "opaque wide divisor div");
  assert(i128.max % wide_d == 9223372036854775898i128, "opaque wide divisor rem");
  assert(i128.min / wide_d == -9223372036854775801i128, "opaque wide divisor neg div");
  assert(i128.min % wide_d == -9223372036854775899i128, "opaque wide divisor neg rem");
  assert(i128.max / (0i128 - wide_d) == -9223372036854775801i128, "opaque wide neg divisor div");
  assert(i128.max % (0i128 - wide_d) == 9223372036854775898i128, "opaque wide neg divisor rem");
}

// --- opaque BASE through to_string (the loop that first surfaced T1414) ---
// _wide_int_format_128 divides by its `base` parameter, which is opaque inside
// the std module — that call site is what produced garbage on Windows x64. The
// existing wide_format_parse tests pass literal bases at the CALL site, but the
// division still happens against the parameter, so both are worth pinning: here
// the base is opaque at the call site too, which also keeps the test honest if
// std is ever inlined into user code under LTO.
wide_format_opaque_base() `test {
  int[] bases = [];
  bases.push(2);
  bases.push(8);
  bases.push(10);
  bases.push(36);
  int b2 = _wide_pick(bases, 0);
  int b8 = _wide_pick(bases, 1);
  int b10 = _wide_pick(bases, 2);
  int b36 = _wide_pick(bases, 3);

  assert(5u128.to_string(base: b2) == "101", "opaque base 2");
  assert(u128.max.to_string(base: b8) == "3777777777777777777777777777777777777777777", "opaque base 8");
  assert(u128.max.to_string(base: b10) == "340282366920938463463374607431768211455", "opaque base 10");
  assert(u128.max.to_string(base: b36) == "f5lxx1zz5pnorynqglhzmsp33", "opaque base 36");
  // Signed magnitudes go through the same division loop after sign extraction.
  assert((-1000000000000000000007i128).to_string(base: b10) == "-1000000000000000000007", "opaque signed base 10");
  assert((-1000000000000000000007i128).to_string(base: b36) == "-5v1j4f4ds79m9z", "opaque signed base 36");
  assert(i128.min.to_string(base: b10) == "-170141183460469231731687303715884105728", "opaque i128.min base 10");
  // Round-trip back through parse at the same opaque base.
  assert(u128.parse(Scanner(s: "340282366920938463463374607431768211455"), b10)?! == u128.max, "opaque base 10 round-trip");
  assert(u128.parse(Scanner(s: "f5lxx1zz5pnorynqglhzmsp33"), b36)?! == u128.max, "opaque base 36 round-trip");
  assert(i128.parse(Scanner(s: "-170141183460469231731687303715884105728"), b10)?! == i128.min, "opaque i128.min round-trip");
}

// 256/512-bit div/rem is inline-expanded by LLVM's ExpandLargeDivRem and never
// reaches a libcall, so it was unaffected by T1414 — but nothing pinned that,
// and a future width/lowering change that reintroduced a libcall would inherit
// exactly the same ABI trap. Guard the widths with opaque divisors too.
wide_div_opaque_256_512() `test {
  u256[] uv = [];
  uv.push(7u256);
  u256 du = _wide_pick(uv, 0);
  assert(u256.max / du == 16541727033902313631938712144098272550467140666520080577065369143987589948562u256, "u256 opaque div");
  assert(u256.max % du == 1u256, "u256 opaque rem");

  i256[] iv = [];
  iv.push(7i256);
  i256 di = _wide_pick(iv, 0);
  assert(i256.min / di == -8270863516951156815969356072049136275233570333260040288532684571993794974281i256, "i256 opaque neg div");
  assert(i256.min % di == -1i256, "i256 opaque neg rem");

  u512[] wv = [];
  wv.push(7u512);
  u512 dw = _wide_pick(wv, 0);
  assert(u512.max / dw == 1915401132848942442796289285457978018211337974370341911103365920531680575724792425257410614023843346812861694026640864407679126115992367135204807000869156u512, "u512 opaque div");
  assert(u512.max % dw == 3u512, "u512 opaque rem");

  // The 256/512 format loops divide by their `base` parameter as well.
  int[] bases = [];
  bases.push(10);
  int b10 = _wide_pick(bases, 0);
  assert(i256.min.to_string(base: b10) == "-57896044618658097711785492504343953926634992332820282019728792003956564819968", "i256.min opaque base 10");
  assert(u512.max.to_string(base: b10) == "13407807929942597099574024998205846127479365820592393377723561443721764030073546976801874298166903427690031858186486050853753882811946569946433649006084095", "u512.max opaque base 10");
}

// --- T1419: wide integers as Map values / keys and Set elements ---
// Regression: enum variant data blobs (Map stores values in a generic
// `Slot[K,V]` enum) were sized with i128+ alignment capped at 8, so a wide-int
// value at a non-zero payload offset overflowed the blob and read back 0.
map_u128_value_literal() `test {
  map[int, u128] m = {
    1: 7u128, 2: 18446744073709551617u128
  };
  assert((m[1] ?: 99u128) == 7u128, "u128 map literal value key 1");
  assert((m[2] ?: 99u128) == 18446744073709551617u128, "u128 map literal value key 2");
  assert((m[3] ?: 99u128) == 99u128, "u128 map miss falls back");
}

map_u128_value_runtime() `test {
  map[int, u128] m = {:};
  m[1] = 18446744073709551617u128;
  m[2] = u128.max;
  assert((m[1] ?: 99u128) == 18446744073709551617u128, "u128 map runtime insert key 1");
  assert((m[2] ?: 99u128) == u128.max, "u128 map runtime insert key 2");
}

map_i256_value() `test {
  map[int, i256] m = {
    1: 7i256
  };
  assert((m[1] ?: 99i256) == 7i256, "i256 map literal value");
  m[2] = i256.min;
  assert((m[2] ?: 99i256) == i256.min, "i256 map runtime insert");
}

map_u128_key() `test {
  map[u128, int] m = {:};
  m[18446744073709551617u128] = 42;
  m[u128.max] = 7;
  assert((m[18446744073709551617u128] ?: -1) == 42, "u128 key lookup");
  assert((m[u128.max] ?: -1) == 7, "u128 key lookup max");
  assert((m[1u128] ?: -1) == -1, "u128 key miss");
}

set_u128_membership() `test {
  Set[u128] s = Set[u128]();
  s.add(7u128);
  s.add(18446744073709551617u128);
  assert(s.contains(7u128), "u128 set contains present");
  assert(s.contains(18446744073709551617u128), "u128 set contains wide present");
  assert(!s.contains(1u128), "u128 set absent");
}
