// --- _build_request unit tests (no network) ---

test_build_request_connection_close() `test(exclude: wasm) {
  _Url u = _parse_url("http://example.com/p")?!;
  map[string, string] h = map[string, string]();
  u8[] bytes = _build_request(Method.Get, u, h, "", false, false);
  string req = string.from_bytes(bytes);
  assert(req.starts_with("GET /p HTTP/1.1\r\n"), "request line");
  assert(req.contains("Host: example.com\r\n"), "host header, default port omitted");
  assert(req.contains("Connection: close\r\n"), "connection close when keep_alive false");
  assert(!req.contains("Accept-Encoding"), "no gzip advertised when want_gzip false");
  assert(!req.contains("Content-Length"), "no content-length for empty body");
}

test_build_request_keepalive_and_gzip() `test(exclude: wasm) {
  _Url u = _parse_url("http://example.com:8080/")?!;
  map[string, string] h = map[string, string]();
  u8[] bytes = _build_request(Method.Get, u, h, "", true, true);
  string req = string.from_bytes(bytes);
  assert(req.contains("Host: example.com:8080\r\n"), "host includes non-80 port");
  assert(req.contains("Connection: keep-alive\r\n"), "keep-alive when requested");
  assert(req.contains("Accept-Encoding: gzip\r\n"), "gzip advertised when want_gzip and no user AE");
}

test_build_request_respects_user_accept_encoding() `test(exclude: wasm) {
  _Url u = _parse_url("http://example.com/")?!;
  map[string, string] h = map[string, string]();
  h["Accept-Encoding"] = "identity";
  u8[] bytes = _build_request(Method.Get, u, h, "", true, true);
  string req = string.from_bytes(bytes);
  assert(req.contains("Accept-Encoding: identity\r\n"), "user Accept-Encoding preserved");
  assert(!req.contains("Accept-Encoding: gzip"), "auto gzip not added when user set Accept-Encoding");
}

test_build_request_skips_reserved_headers() `test(exclude: wasm) {
  _Url u = _parse_url("http://example.com/")?!;
  map[string, string] h = map[string, string]();
  h["Host"] = "evil.com";
  h["Connection"] = "close";
  h["Content-Length"] = "999";
  h["X-Custom"] = "yes";
  u8[] bytes = _build_request(Method.Post, u, h, "body", true, false);
  string req = string.from_bytes(bytes);
  assert(!req.contains("evil.com"), "caller Host skipped (builder manages Host)");
  assert(!req.contains("999"), "caller Content-Length skipped");
  assert(!req.contains("Connection: close"), "caller Connection skipped");
  assert(req.contains("Content-Length: 4\r\n"), "content-length recomputed from body");
  assert(req.contains("Connection: keep-alive\r\n"), "builder-managed Connection used");
  assert(req.contains("X-Custom: yes\r\n"), "non-reserved custom header kept");
  assert(req.ends_with("\r\n\r\nbody"), "body appended after headers");
}

