// tls module tests — loopback TLS handshake over the reactor (T0077).
// A self-signed cert/key (generated once, committed) drives a TlsListener
// server and a TlsStream client on 127.0.0.1, exercising the full memory-BIO
// handshake, encrypted round-trip, negotiated version/cipher, close_notify, and
// TlsError kind differentiation. Excluded on wasm (no TLS backend / no sockets).
// Self-signed certificate and matching private key (CN=localhost), PEM-encoded.
_test_cert() u8[] {
  return "-----BEGIN CERTIFICATE-----\nMIIDCTCCAfGgAwIBAgIUIdE48rWcPrShBQQO6bmpIWC4UYswDQYJKoZIhvcNAQEL\nBQAwFDESMBAGA1UEAwwJbG9jYWxob3N0MB4XDTI2MDgxOTE2MzQwM1oXDTM2MDgx\nNjE2MzQwM1owFDESMBAGA1UEAwwJbG9jYWxob3N0MIIBIjANBgkqhkiG9w0BAQEF\nAAOCAQ8AMIIBCgKCAQEAmNxN4Db03AQ7rfUWkwMdfiAR+861FfWwgVFTeGFcmdE8\nImoPdZVlY0Kp3POt9+znOg4keaLQlCF/st8MkVcTafgbX8WNkPdQBep23bTwvezi\nj9QOJs/YNesImsYgs08p9R0HOiQvuRsK2E/khvok8XQtOGbe0D9+vG0LOqGc2CKG\nu1M9WfuI0A8iWlcVXFoiJQLas/FpXaNqkJ1+GDj4XW4JfkgByA3olAGiWZP+rZn8\nd8fUyZjbfI+huUTV8OWAXJpk8CI8BNFyEQU+WS8EsaVEgp1j6vOKbtBxFa1fu+Jz\n7vEllrAJQxBE4EWYr3u40K8DzG0kSYEnNzql62QzZQIDAQABo1MwUTAdBgNVHQ4E\nFgQUZ6zv3vHCsCg2daSNRgzxPh1Uy6EwHwYDVR0jBBgwFoAUZ6zv3vHCsCg2daSN\nRgzxPh1Uy6EwDwYDVR0TAQH/BAUwAwEB/zANBgkqhkiG9w0BAQsFAAOCAQEAOkKf\nM+4hRfY33y+6LExP5qc7n7XBD8axlPbwWTTz4VnZhtb/1mhDilzsIvvqnr4joyVU\nasNZfV17Y5PBKdLJi7oAGQY6vBQTY/6oliltMMfyuwUlED4lpQrzR5eHETwLxae9\nyn2la4zq/T06latfpJsn69XDhfBFd8ZmF9aYlon80l6532hXtSVO3lpQmlst5Ke9\nevsiUh6EFMg67xKRgz6WBQYmUwe36uz84FC5etCHQkpuWSvYrPEfZs21J+ep4tvh\nIXSqOb2LDsJhf3V9VfILQRmzgSY36oUaHg2gck3QCYBj0wVCZm+BHw4FzFOe6MEa\nIe6jqBg4hHdNVc6mAw==\n-----END CERTIFICATE-----\n".bytes();
