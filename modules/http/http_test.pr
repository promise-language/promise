    Response r2 = c.get("http://127.0.0.1:" + port.to_string() + "/b")?!;
    assert(r2.body == "second", "second body reused HTTP/1.0 keep-alive socket");
  };

  // Both served on ONE accepted connection: a second accept never happens, so
  // the test only completes if the HTTP/1.0 keep-alive socket was reused.
  _serve_keepalive(listener,
  "HTTP/1.0 200 OK\r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\nfirst",
  "HTTP/1.0 200 OK\r\nContent-Length: 6\r\nConnection: close\r\n\r\nsecond")?!;
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

// --- Client.close() drains the pool, forcing a reconnect on the next request ---

test_client_close_drains_pool() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
    Response r1 = c.get("http://127.0.0.1:" + port.to_string() + "/a")?!;
    assert(r1.body == "first", "first body");
    c.close(); // drop the pooled keep-alive connection
    Response r2 = c.get("http://127.0.0.1:" + port.to_string() + "/b")?!;
    assert(r2.body == "second", "second body after forced reconnect");
  };

  // Because close() drained the pool, the client must open a SECOND connection
  // for r2 — served as two separate accepts by _serve_n.
  string[] responses = string[]();
  responses.push("HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\nfirst");
  responses.push("HTTP/1.1 200 OK\r\nContent-Length: 6\r\nConnection: close\r\n\r\nsecond");
  string[] requests = _serve_n(listener, responses)?!;
  assert(requests.len == 2, "two connections served after close()");
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

// --- 3xx without a Location header is returned as-is (nothing to follow) ---

test_client_redirect_no_location() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
    Response resp = c.send(Request.new_get("http://127.0.0.1:" + port.to_string() + "/"))?!;
    assert(resp.status == 302, "302 without Location returned unfollowed");
    assert(resp.body == "body", "original 3xx body preserved");
  };

  string[] responses = string[]();
  responses.push("HTTP/1.1 302 Found\r\nContent-Length: 4\r\nConnection: close\r\n\r\nbody");
  string[] requests = _serve_n(listener, responses)?!;
  assert(requests.len == 1, "only one request — redirect not followed");
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

// --- chunked framing error paths (_read_chunked_body EOF raises) ---

// Server declares chunked encoding then closes mid chunk-size line: the reader
// must raise "unexpected EOF in chunk size" rather than hang or return garbage.
test_chunked_eof_in_chunk_size() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Response resp = http_get("http://127.0.0.1:" + port.to_string() + "/")? e {
      assert(e.message.contains("chunk size"), "EOF in chunk size surfaced");
      return;
    };
    assert(false, "should raise on truncated chunk-size line");
  };

  // Header terminator present, but the chunk-size line ("5") never gets its CRLF
  // before the socket closes.
  string reply = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n5";
  _serve_once(listener, reply)?!;
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

// Server declares a 5-byte chunk but sends only 3 bytes before closing: the
// reader must raise "unexpected EOF in chunk data".
test_chunked_eof_in_chunk_data() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Response resp = http_get("http://127.0.0.1:" + port.to_string() + "/")? e {
      assert(e.message.contains("chunk data"), "EOF in chunk data surfaced");
      return;
    };
    assert(false, "should raise on truncated chunk data");
  };

  string reply = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n5\r\nHel";
  _serve_once(listener, reply)?!;
  listener.close()?!;
  sleep(Duration.from_millis(100));
}
