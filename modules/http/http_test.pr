  _strip_header_ci(h, "cookie");
  assert(h.len == 1, "both credential headers removed regardless of casing");
  bool kept = false;
  if v := h["X-Keep"] {
    kept = true;
  }
  assert(kept, "unrelated header preserved");
}

// --- Pool: eviction at capacity + LIFO take hit/miss (uses live sockets) ---

test_pool_eviction_and_take() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  // Connect two clients and accept them in the same goroutine. connect() returns
  // as soon as the kernel completes the handshake into the listener backlog, so
  // no concurrent accept — and therefore no goroutine and no sleep — is needed to
  // keep the server-side fds alive (T1615/T1632: synchronize by scope, never by a
  // clock). The accepted streams a and b live as locals across the pool checks
  // and drop deterministically at function end, before the leak snapshot.
  net.TcpStream s1 = net.TcpStream.connect("127.0.0.1", port)?!;
  net.TcpStream s2 = net.TcpStream.connect("127.0.0.1", port)?!;
  net.TcpStream a = listener.accept()?!;
  net.TcpStream b = listener.accept()?!;

  Pool p = Pool.create(1);
  p.put("a", move s1); // pooled: [a]
  p.put("b", move s2); // at capacity → evict "a"; pooled: [b]

  // take("a") misses: it was evicted (and LIFO only matches the newest key).
  bool miss = true;
  if got := p.take("a") {
    miss = false;
  }
  assert(miss, "take(a) misses after eviction");

  // take("b") hits and yields the pooled stream (dropped at block end).
  bool hit = false;
  if got := p.take("b") {
    hit = true;
  }
  assert(hit, "take(b) hits the retained connection");

  listener.close()?!;
}

// --- _exchange framing: HEAD (no body), EOF-framed, gzip failure ---

test_head_request_no_body() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    // Build a HEAD request directly (no dedicated factory) and send it.
    Request req = Request(method: move Method.Head, url: "http://127.0.0.1:" + port.to_string() + "/", headers: map[string, string](), body: "");
    Response resp = req.send()?!;
    assert(resp.status == 200, "HEAD status 200");
    assert(resp.body == "", "HEAD response carries no body even with Content-Length");
  };

  // HEAD reply: headers only, Content-Length advertised but no body bytes sent.
  string reply = "HTTP/1.1 200 OK\r\nContent-Length: 42\r\nConnection: close\r\n\r\n";
  string request = _serve_once(listener, reply)?!;
  assert(request.starts_with("HEAD / HTTP/1.1"), "server saw a HEAD request");
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

test_client_eof_framed_body() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
    Response resp = c.send(Request.new_get("http://127.0.0.1:" + port.to_string() + "/"))?!;
    assert(resp.status == 200, "status 200");
    assert(resp.body == "eof body", "body framed by read-to-EOF");
  };

  // No Content-Length and not chunked → body is framed by connection close (EOF).
  string reply = "HTTP/1.1 200 OK\r\nConnection: close\r\n\r\neof body";
  _serve_once(listener, reply)?!;
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

test_client_gzip_decode_failure() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
    Response resp = c.send(Request.new_get("http://127.0.0.1:" + port.to_string() + "/"))? e {
      assert(e.message.contains("gzip decode failed"), "gzip failure surfaced as HttpError");
      return;
    };
    assert(false, "should raise on invalid gzip body");
  };

  // Content-Encoding: gzip but the body is not a valid gzip stream.
  string reply = "HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nContent-Length: 6\r\nConnection: close\r\n\r\nnotgz!";
  _serve_once(listener, reply)?!;
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

