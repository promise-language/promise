// --- the present/absent split: a `none` getter must not drop a garbage inner --

get probe_none string? `doc("Always absent — exercises the absent arm of the drop.") {
  string? empty;
  return empty;
}

test_absent_optional_getter_borrow() `test {
  int i = 0;
  while i < 50 {
    _borrow_opt(probe_none);
    i = i + 1;
  }
  assert(true, "an absent optional must skip the inner drop, not crash");
}

test_absent_optional_getter_push() `test {
  string?[] xs = [];
  int i = 0;
  while i < 50 {
    xs.push(move probe_none);
    i = i + 1;
  }
  assert(xs.len == 50, "absent optionals still occupy a slot");
}

test_absent_optional_getter_discard() `test {
  int i = 0;
  while i < 50 {
    probe_none;
    i = i + 1;
  }
  assert(true, "a discarded absent optional must not drop anything");
}

// --- the values must survive the fix: no premature free ----------------------

test_pushed_payloads_are_readable() `test {
  string?[] xs = [];
  int i = 0;
  while i < 50 {
    xs.push(move probe_dir);
    i = i + 1;
  }
  int seen = 0;
  int j = 0;
  while j < xs.len {
    assert(xs[j] is present, "slot {j} should be present");
    assert(xs[j]!.len == 17, "payload should survive the push intact");
    seen = seen + 1;
    j = j + 1;
  }
  assert(seen == 50, "every stored optional should still hold its payload");
}

test_pushed_vector_payloads_are_readable() `test {
  int[]?[] xs = [];
  int i = 0;
  while i < 50 {
    xs.push(move probe_vec);
    i = i + 1;
  }
  int total = 0;
  int j = 0;
  while j < xs.len {
    assert(xs[j] is present, "slot {j} should be present");
    total = total + xs[j]!.len;
    j = j + 1;
  }
  assert(total == 100, "every stored vector should still hold 2 elements, got {total}");
}

