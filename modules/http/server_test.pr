}

// B0347: partially fixed — the Bag[K,string].[] return site now dups the
// inner string. However, downstream patterns where the caller passes the
// unwrapped string to another `~this` method that stores it into a container
// still double-free. That case is tracked separately; this test is excluded
// on macOS until the follow-up lands.
test_server_headers() `test(exclude: wasm || macos, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;
  channel[bool] done = channel[bool](capacity: 1);

  go {
    Request req = Request.new_get("http://127.0.0.1:" + port.to_string() + "/path");
    req.set_header("X-Test", "hello");
    Response resp = req.send()?!;
    assert(resp.status == 200, "status 200");
    assert(resp.body == "/path", "path echoed");
    bool found = false;
    for k, v in resp.headers {
      if k == "x-echo" && v == "hello" {
        found = true;
      }
    }
    assert(found, "x-echo header");
    done.send(true);
  };

  net.TcpStream conn = listener.accept()?!;
  _HeaderEchoHandler handler = _HeaderEchoHandler(echo_header: "x-test");
  _serve_connection[_HeaderEchoHandler](conn, Ref[_HeaderEchoHandler](move handler), 1);
  listener.close()?!;
  _ := <-done;
}

