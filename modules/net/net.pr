// net module — TCP networking with reactor-based non-blocking I/O (T0071).
// Requires: use net;
//
// Uses the M:N scheduler's IO reactor for goroutine parking: when a socket
// would block (EAGAIN), the goroutine suspends via coro.suspend and is woken
// by the reactor poller thread when the fd becomes ready.
// Socket operations return -errno on failure.
//
// Host name resolution (T1518) deliberately does NOT go through that reactor.
// The reactor only knows how to wait on an fd, whereas the platform resolver
// owns /etc/hosts, search domains, resolv.conf options and mDNS — reimplementing
// DNS on the reactor would lose all of that. Instead `_net_resolve` blocks in
// getaddrinfo behind the scheduler's syscall handoff (T1685): the calling M is
// released along with its P, so no other goroutine is delayed while the resolver
// works. A dead nameserver can therefore stall the *calling goroutine* for
// several seconds; a caller-visible resolve timeout is tracked as T1563.
_net_socket_create(int domain, int typ, int protocol) int `extern("promise_net_socket_create");
_net_socket_bind_addr(int fd, string host, int port) int `extern("promise_net_socket_bind_addr");
_net_socket_listen(int fd, int backlog) int `extern("promise_net_socket_listen");
_net_socket_accept_addr(int fd) int `extern("promise_net_socket_accept_addr");
_net_socket_connect_addr(int fd, string host, int port) int `extern("promise_net_socket_connect_addr");
_net_socket_close(int fd) int `extern("promise_net_socket_close");
_net_socket_send(int fd, u8[] ~data) int `extern("promise_net_socket_send");
_net_socket_recv(int fd, u8[] ~buf) int `extern("promise_net_socket_recv");
_net_socket_shutdown(int fd, int how) int `extern("promise_net_socket_shutdown");
_net_socket_get_error(int fd) int `extern("promise_net_socket_get_error");
_net_socket_getsockname(int fd) int `extern("promise_net_socket_getsockname");

// Reactor integration — netpoll_open/close are regular bridge calls,
// netpoll_wait_read/write are intercepted at codegen and replaced with
// inline coro.suspend (T0232).
_net_socket_set_nonblock(int fd) int `extern("promise_net_socket_set_nonblock");
_net_netpoll_open(int fd) int `extern("promise_net_netpoll_open");
_net_netpoll_close(int pd) `extern("promise_net_netpoll_close");
_net_netpoll_wait_read(int pd) `extern("promise_netpoll_wait_read");
_net_netpoll_wait_write(int pd) `extern("promise_netpoll_wait_write");

// Name resolution (T1518). Pointers are carried as int, matching the _pd
// PollDesc convention above. _net_resolve returns the addrinfo list head as an
// int, or a negative normalized code: -1 not found, -2 try again, -3 failed,
// -4 unsupported on this target. An empty host always comes back as -1 (not
// found): the rejection lives in pal_resolve_host, so every caller of this
// bridge inherits it and no platform resolver gets to decide (T1726).
_net_resolve(string host, string service) int `extern("promise_net_resolve");
_net_resolve_next(int node) int `extern("promise_net_resolve_next");
_net_resolve_family(int node) int `extern("promise_net_resolve_family");
_net_resolve_address(int node) string `extern("promise_net_resolve_address");
_net_resolve_free(int list) `extern("promise_net_resolve_free");
_net_socket_connect_resolved(int fd, int node) int `extern("promise_net_socket_connect_resolved");

_eagain() int `target(macos) {
  return 35;
}
_eagain() int `target(linux) {
  return 11;
}
_eagain() int `target(wasm) {
  return 11;
}
_eagain() int `target(windows) {
  return 10035; // WSAEWOULDBLOCK
}
_einprogress() int `target(macos) {
  return 36;
}
_einprogress() int `target(linux) {
  return 115;
}
_einprogress() int `target(wasm) {
  return 115;
}
_einprogress() int `target(windows) {
  return 10035; // WSAEWOULDBLOCK (Windows uses this for non-blocking connect in progress)
}

type NetError is error `public `doc("A network I/O error with an errno code.") {
  int code;
}

_make_net_error(int rc) NetError {
  int c = 0 - rc;
  return NetError(code: c, message: _net_strerror(c));
}

_net_strerror(int code) string {
  return match code {
    9 => "bad file descriptor",
    13 => "permission denied",
    22 => "invalid argument",
    98 => "address already in use", // Linux EADDRINUSE
    48 => "address already in use", // macOS EADDRINUSE
    99 => "cannot assign requested address", // Linux EADDRNOTAVAIL
    49 => "cannot assign requested address", // macOS EADDRNOTAVAIL
    111 => "connection refused", // Linux ECONNREFUSED
    61 => "connection refused", // macOS ECONNREFUSED
    104 => "connection reset by peer", // Linux ECONNRESET
    54 => "connection reset by peer", // macOS ECONNRESET
    110 => "connection timed out", // Linux ETIMEDOUT
    60 => "connection timed out", // macOS ETIMEDOUT
    32 => "broken pipe",
    10013 => "permission denied", // WSAEACCES
    10022 => "invalid argument", // WSAEINVAL
    10038 => "bad file descriptor", // WSAENOTSOCK
    10048 => "address already in use", // WSAEADDRINUSE
    10049 => "cannot assign requested address", // WSAEADDRNOTAVAIL
    10054 => "connection reset by peer", // WSAECONNRESET
    10060 => "connection timed out", // WSAETIMEDOUT
    10061 => "connection refused", // WSAECONNREFUSED
    _ => "network error (errno {code})",
  };
}

enum ResolveErrorKind `public `doc("Why host name resolution failed.") {
  not_found `doc("The host name does not exist."),
  try_again `doc("A temporary resolver failure; retrying may succeed."),
  failed `doc("A permanent resolver failure."),
  unsupported `doc("Name resolution is not available on this target."),
}

type ResolveError is NetError `public `doc("Raised when a host name cannot be resolved to an IP address. `host` is the name that failed; `kind` says whether the failure is permanent or worth retrying. Inherits NetError, so an existing `? e is NetError` catch also catches it. Naming either type in a typed catch needs it in scope unqualified (`use net as _;`) — `? e is net.ResolveError` does not parse yet (T1701), and `e as net.ResolveError` panics codegen (T1538).") {
  string host;
  ResolveErrorKind kind;
}

// Maps a normalized resolver code from _net_resolve onto a ResolveError. `kind`
// is the single source of truth for why resolution failed; the inherited
// NetError.code stays 0 because the normalized resolver codes are not errnos and
// _net_strerror would mistranslate them.
_make_resolve_error(string host, int code) ResolveError {
  ResolveErrorKind kind = ResolveErrorKind.failed;
  string reason = "resolver failure";
  if code == -1 {
    kind = ResolveErrorKind.not_found;
    reason = "not found";
  } else if code == -2 {
    kind = ResolveErrorKind.try_again;
    reason = "temporary resolver failure, retry may succeed";
  } else if code == -4 {
    kind = ResolveErrorKind.unsupported;
    reason = "name resolution is not supported on this target";
  }
  return ResolveError(code: 0, host: host.clone(), kind: move kind,
  message: "cannot resolve host '{host}': {reason}");
}

// Owns an addrinfo list returned by _net_resolve so it is released on every exit
// path — including `raise` and an early `return` from the middle of a connect
// loop — via the scope cleanup stack. The list is allocated by the platform
// resolver (libc malloc), so it is invisible to the leak detector; drop is the
// only thing standing between a failed connect and a permanent leak.
type _AddrList {
  int _handle;

  drop(~this) {
    if this._handle != 0 {
      _net_resolve_free(this._handle);
    }
  }
}

resolve!(string host) string[] `public `doc("Resolves a host name to its IP addresses (both A and AAAA records), in the order the platform resolver prefers. Numeric literals such as \"127.0.0.1\" or \"::1\" are accepted and returned unchanged. Results are in presentation form. Raises ResolveError if the name cannot be resolved. An empty host name always raises ResolveError(kind: not_found), on every target — it never resolves to this machine.") {
  int head = _net_resolve(host, "0");
  if head < 0 {
    raise _make_resolve_error(host, head);
  }
  _AddrList owned = _AddrList(_handle: head);
  string[] addresses = [];
  int node = head;
  while node != 0 {
    string text = _net_resolve_address(node);
    if text.len > 0 {
      addresses.push(move text);
    }
    node = _net_resolve_next(node);
  }
  // A successful lookup that yielded nothing usable would otherwise hand back an
  // empty vector, which the doc comment promises never happens and which a caller
  // would only discover by indexing out of bounds.
  if addresses.len == 0 {
    raise _make_resolve_error(host, -1);
  }
  return addresses;
}

_af_inet() int {
  return 2;
}

_sock_stream() int {
  return 1;
}

type TcpListener `public `doc("A TCP listener socket. Binds to an address and accepts incoming connections. Auto-closes on drop.") {
  int _fd;
  int _pd; // PollDesc pointer (as int) for reactor integration

  bind!(string host, int port) Self `factory `public `doc("Creates a TCP listener bound to the given host and port. Host must be an IPv4 address (e.g. \"0.0.0.0\" or \"127.0.0.1\").") {
    // Create socket
    int fd = _net_socket_create(_af_inet(), _sock_stream(), 0);
    if fd < 0 {
      raise _make_net_error(fd);
    }
    // Bind (sets SO_REUSEADDR internally)
    int rc = _net_socket_bind_addr(fd, host, port);
    if rc < 0 {
      _net_socket_close(fd);
      raise _make_net_error(rc);
    }
    // Listen with default backlog
    rc = _net_socket_listen(fd, 128);
    if rc < 0 {
      _net_socket_close(fd);
      raise _make_net_error(rc);
    }
    // Set non-blocking, then register with reactor for non-blocking accept.
    // non-blocking must be set BEFORE netpoll_open so EPOLLET sees the correct
    // initial state when the fd is added to epoll (B0322).
    _net_socket_set_nonblock(fd);
    int pd = _net_netpoll_open(fd);
    return TcpListener(_fd: fd, _pd: pd);
  }

  accept!(~this) TcpStream `public `doc("Accepts a new TCP connection. Blocks the goroutine (via reactor) until a connection arrives.") {
    while true {
      int fd = _net_socket_accept_addr(this._fd);
      if fd >= 0 {
        _net_socket_set_nonblock(fd);
        int pd = _net_netpoll_open(fd);
        return TcpStream(_fd: fd, _pd: pd);
      }
      int err = 0 - fd;
      if err == _eagain() {
        _net_netpoll_wait_read(this._pd);
        continue;
      }
      raise _make_net_error(fd);
    }
    // Unreachable — loop always returns or raises.
    raise NetError(code: 0, message: "unreachable");
  }

  get local_port int `public `doc("Returns the port number this listener is bound to. Useful after binding to port 0 (dynamic allocation).") {
    return _net_socket_getsockname(this._fd);
  }

  close!(~this) `public `doc("Closes the listener. Raises NetError on failure.") {
    if this._fd < 0 {
      raise NetError(code: 9, message: "bad file descriptor");
    }
    _net_netpoll_close(this._pd);
    int rc = _net_socket_close(this._fd);
    this._fd = -1;
    this._pd = 0;
    if rc < 0 {
      raise _make_net_error(rc);
    }
  }

  drop(~this) {
    if this._fd >= 0 {
      _net_netpoll_close(this._pd);
      _net_socket_close(this._fd);
    }
  }
}

type TcpStream `public `doc("A TCP connection stream. Supports non-blocking read/write with reactor-based goroutine parking. Auto-closes on drop.") {
  int _fd;
  int _pd; // PollDesc pointer (as int) for reactor integration

  connect!(string host, int port) Self `factory `public `doc("Connects to a TCP server at the given host and port. The host may be a name (\"example.com\", \"localhost\") or an IPv4/IPv6 literal; names are resolved via the platform resolver and the resolved addresses are tried in the order it prefers. Blocks the goroutine until the connection is established. Raises ResolveError if the name cannot be resolved, NetError if no resolved address accepted the connection. An empty host raises ResolveError(kind: not_found) on every target, rather than connecting to this machine.") {
    int head = _net_resolve(host, "{port}");
    if head < 0 {
      raise _make_resolve_error(host, head);
    }
    // Frees the addrinfo list on every exit below, including the returns inside
    // the loop and the raises after it.
    _AddrList owned = _AddrList(_handle: head);

    // getaddrinfo applies RFC 6724 destination-address ordering, so trying the
    // addresses in list order is the correct policy: on a v4-only network a
    // v6-first list fails fast with ENETUNREACH and falls through to the v4
    // address. (Racing v4 and v6 in parallel — Happy Eyeballs — is out of scope.)
    int node = head;
    int last_err = 0;
    while node != 0 {
      int fd = _net_socket_create(_net_resolve_family(node), _sock_stream(), 0);
      if fd < 0 {
        last_err = fd;
        node = _net_resolve_next(node);
        continue;
      }
      // Set non-blocking BEFORE connect so connect() returns EINPROGRESS.
      // Register with epoll AFTER connect so the fd is in "connecting" (not writable)
      // state at registration time — EPOLLET then fires correctly when the connection
      // completes. Registering before connect would cause a spurious initial EPOLLOUT
      // (fresh socket is writable) that EPOLLET consumes, and fast loopback connections
      // may never produce a second edge transition, leaving the goroutine parked forever
      // (B0322).
      _net_socket_set_nonblock(fd);
      int rc = _net_socket_connect_resolved(fd, node);
      if rc >= 0 {
        // Immediate connect (non-blocking socket connected synchronously — rare).
        int pd = _net_netpoll_open(fd);
        return TcpStream(_fd: fd, _pd: pd);
      }
      int err = 0 - rc;
      if err == _einprogress() {
        // Non-blocking connect in progress — register with reactor, wait for writable,
        // then check SO_ERROR. Reactor registered here (after connect) so EPOLLET sees
        // the "connecting → connected" transition.
        int pd = _net_netpoll_open(fd);
        _net_netpoll_wait_write(pd);
        int sock_err = _net_socket_get_error(fd);
        if sock_err == 0 {
          return TcpStream(_fd: fd, _pd: pd);
        }
        _net_netpoll_close(pd);
        _net_socket_close(fd);
        last_err = 0 - sock_err;
      } else {
        _net_socket_close(fd);
        last_err = rc;
      }
      node = _net_resolve_next(node);
    }
    if last_err == 0 {
      raise NetError(code: 0, message: "cannot connect to '{host}': resolver returned no usable addresses");
    }
    raise _make_net_error(last_err);
  }

  read!(~this, u8[] ~buf) int `public `doc("Reads bytes into buf. Returns the number of bytes read (0 at EOF). Blocks the goroutine until data is available.") {
    while true {
      int n = _net_socket_recv(this._fd, buf);
      if n >= 0 {
        return n;
      }
      int err = 0 - n;
      if err == _eagain() {
        _net_netpoll_wait_read(this._pd);
        continue;
      }
      raise _make_net_error(n);
    }
    raise NetError(code: 0, message: "unreachable");
  }

  write!(~this, u8[] ~data) int `public `doc("Writes bytes from data. Returns the number of bytes written. Blocks the goroutine until the socket is writable.") {
    while true {
      int n = _net_socket_send(this._fd, data);
      if n >= 0 {
        return n;
      }
      int err = 0 - n;
      if err == _eagain() {
        _net_netpoll_wait_write(this._pd);
        continue;
      }
      raise _make_net_error(n);
    }
    raise NetError(code: 0, message: "unreachable");
  }

  close!(~this) `public `doc("Closes the stream. Raises NetError on failure.") {
    if this._fd < 0 {
      raise NetError(code: 9, message: "bad file descriptor");
    }
    _net_netpoll_close(this._pd);
    int rc = _net_socket_close(this._fd);
    this._fd = -1;
    this._pd = 0;
    if rc < 0 {
      raise _make_net_error(rc);
    }
  }

  shutdown!(~this, bool read = false, bool write = false) `public `doc("Shuts down part of the connection. Pass read: true and/or write: true.") {
    int how = 0;
    if read && write {
      how = 2; // SHUT_RDWR
    } else if write {
      how = 1; // SHUT_WR
    }
    // how == 0 is SHUT_RD
    int rc = _net_socket_shutdown(this._fd, how);
    if rc < 0 {
      raise _make_net_error(rc);
    }
  }

  drop(~this) {
    if this._fd >= 0 {
      _net_netpoll_close(this._pd);
      _net_socket_close(this._fd);
    }
  }
}
