// T2049: a bare identifier naming a module-level getter is a CALL producing a
// fresh owned value, not a place read. Codegen's ownership classifiers switched
// on the AST shape and read `*ast.IdentExpr` as "a variable", so a getter result
// was either duplicated (orphaning the original) or given no statement temp at
// all. Separately, no producer path registered an `Optional`-typed call/getter
// result as a statement temp — an `Optional[T]` is a `{i1, T}` aggregate, which
// matches neither the i8* nor the `{i8*, i8*}` tracker — so its payload leaked
// wherever it was borrowed or discarded.
//
// Every test loops 50 times so a per-iteration leak is unambiguous in the count.
get probe_dir string? `doc("Optional heap string from a module-level getter.") {
  return "probe" + "-dir-payload";
}

get probe_plain string `doc("Non-optional heap string — the tracked control.") {
  return "probe" + "-plain-payload";
}

get probe_vec int[]? `doc("Optional heap vector from a module-level getter.") {
  int[] v = [];
  v.push(1);
  v.push(2);
  return v;
}

type Row `doc("Droppable heap user type, to exercise the Optional[user] inner.") {
  string label;
  drop(~this) {
  }
}

get probe_row Row? `doc("Optional droppable heap user type from a getter.") {
  return Row(label: "row" + "-payload");
}

probe_fn() string? `doc("Optional heap string from a plain call, not a getter.") {
  return "probe" + "-fn-payload";
}

_borrow_opt(string? v) `doc("Borrows an optional string — does not consume it.") {
}

_borrow_vec(int[]? v) `doc("Borrows an optional vector.") {
}

_borrow_row(Row? v) `doc("Borrows an optional heap user type.") {
}

_borrow_plain(string v) `doc("Borrows a plain string.") {
}

_consume(string? move v) `doc("Consumes an optional string.") {
}

_take[T](T move v) `doc("Generic consuming parameter.") {
}

type Box `doc("Holds an optional string field.") {
  string? v;
}

// --- the item's repro: push a moved optional getter result --------------------

test_push_moved_optional_getter() `test {
  string?[] xs = [];
  int i = 0;
  while i < 50 {
    xs.push(move probe_dir);
    i = i + 1;
  }
  assert(xs.len == 50, "every push should have stored an element");
}

// The same push WITHOUT the marker. Sema accepts both spellings for a bare
// getter today; whichever one T2205 settles on, neither may leak.
test_push_unmarked_optional_getter() `test {
  string?[] xs = [];
  int i = 0;
  while i < 50 {
    xs.push(probe_dir);
    i = i + 1;
  }
  assert(xs.len == 50, "every push should have stored an element");
}

test_push_moved_optional_vector_getter() `test {
  int[]?[] xs = [];
  int i = 0;
  while i < 50 {
    xs.push(move probe_vec);
    i = i + 1;
  }
  assert(xs.len == 50, "every push should have stored an element");
}

test_push_moved_optional_row_getter() `test {
  Row?[] xs = [];
  int i = 0;
  while i < 50 {
    xs.push(move probe_row);
    i = i + 1;
  }
  assert(xs.len == 50, "every push should have stored an element");
}

