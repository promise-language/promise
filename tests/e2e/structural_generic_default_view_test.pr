// E2E regression tests for T0862: calling a *default* method through a *generic*
// structural-interface view used to segfault at runtime ("fatal: segmentation
// fault at 0x0").
//
// A non-generic structural interface compiles its own default methods (e.g.
// IBox.put_two), and concrete implementors reference them directly in their
// vtable. A *generic* interface instance (e.g. Box[int]) does not: the mono
// pipeline skips structural instances, so no default method was emitted for the
// concrete implementor's vtable slot. Coercing the concrete type into the
// generic view and dispatching the inherited default then jumped to address 0.
//
// The fix synthesizes the inherited defaults onto the non-generic concrete type
// (Counter.put_two) before its vtable is built.
type Box[T] `structural {
  put!(~this, T x) T `abstract;
  put_two!(~this, T x) T {
    return this.put(x);
  }
  put_three!(~this, T x) T {
    return this.put_two(x);
  }
}

type Counter is Box[int] {
  int n;
  put!(~this, int x) int {
    return x + this.n;
  }
}

type Holder is Box[string] {
  string prefix;
  put!(~this, string x) string {
    return this.prefix + x;
  }
}

// Default method through a generic view — the original crash.
default_through_view() `test {
  Counter ct = Counter(n: 10);
  Box[int] b = ct;
  assert(b.put_two(5)?! == 15, "put_two through Box[int] view");
}

// Chained defaults (put_three -> put_two -> put) through the view.
chained_defaults_through_view() `test {
  Counter ct = Counter(n: 0);
  Box[int] b = ct;
  assert(b.put_three(7)?! == 7, "put_three through Box[int] view");
}

// A different type argument (string) exercises a distinct mono instance.
string_arg_through_view() `test {
  Holder h = Holder(prefix: ">");
  Box[string] b = h;
  assert(b.put_two("hi")?! == ">hi", "put_two through Box[string] view");
}

// Abstract dispatch and direct (non-view) calls keep working.
abstract_and_direct() `test {
  Counter ct = Counter(n: 1);
  assert(ct.put_two(4)?! == 5, "direct default call");
  Box[int] b = ct;
  assert(b.put(3)?! == 4, "abstract dispatch through view");
}

// A concrete type that *overrides* an inherited default must use its own
// method through the view, not the synthesized default.
type Override is Box[int] {
  int n;
  put!(~this, int x) int {
    return x;
  }
  put_two!(~this, int x) int {
    return x + 100;
  }
}
override_default_through_view() `test {
  Override o = Override(n: 0);
  Box[int] b = o;
  assert(b.put_two(5)?! == 105, "overridden put_two through view");
}

// Generic structural interface that itself inherits another generic structural
// interface (Derived[T] is Base[T]). The inherited default `base_default` is
// reached transitively and its type param (Base.T) must resolve to int — the
// recursion previously left it unsubstituted and crashed codegen.
type Base[T] `structural {
  base_op!(~this, T x) T `abstract;
  base_default!(~this, T x) T {
    return this.base_op(x);
  }
}
type Derived[T] is Base[T] `structural {
  derived_default!(~this, T x) T {
    return this.base_default(x);
  }
}
type Impl is Derived[int] {
  int k;
  base_op!(~this, int x) int {
    return x + this.k;
  }
}
inherited_generic_iface_through_view() `test {
  Impl im = Impl(k: 3);
  Derived[int] d = im;
  assert(d.derived_default(5)?! == 8, "derived_default through Derived[int] view");
  assert(d.base_default(5)?! == 8, "transitively-inherited base_default through view");
}

// An interface with a *generic* default method (its own type param U). Such a
// method is not virtual and is skipped by the synthesis path; the regular
// (non-generic) defaults still work through the view, and the generic method
// remains callable directly with explicit type args.
type GBox[T] `structural {
  put!(~this, T x) T `abstract;
  put_two!(~this, T x) T {
    return this.put(x);
  }
  wrap[U](~this, U y) U {
    return y;
  }
}
type GCounter is GBox[int] {
  int n;
  put!(~this, int x) int {
    return x;
  }
}
generic_default_method() `test {
  GCounter ct = GCounter(n: 0);
  assert(ct.wrap[int](9) == 9, "generic default method direct");
  GBox[int] b = ct;
  assert(b.put_two(5)?! == 5, "non-generic default through view alongside generic method");
}

// A non-generic concrete type implementing a generic structural interface that
// lives in a *module* (std's Iterator[int]). Calling an inherited default
// combinator through the view exercises the cross-module synthesis path (T1374).
//
// `next` must match Iterator's abstract signature (non-failable `next(~this)
// T?`); a failable `next!` does not satisfy it. Sema now rejects that mismatch
// with a clean diagnostic (T1376) instead of letting it slip through to a
// codegen crash (insertvalue elem type mismatch); the rejection is covered by
// TestAbstractOverrideSignatureMismatch in the sema package.
//
// The iterator bound comes through the opaque `mk` helper so the count/collect/
// find dispatch is genuinely executed at runtime. An earlier version used a
// compile-time-constant `limit: 3`, which let `opt -O1` const-fold and elide the
// combinator dispatch entirely — so the test passed even while the concrete
// type's vtable slot for the module default was left null (the T1374 crash was
// never actually exercised).
type UpTo is Iterator[int] {
  int cur;
  int limit;
  next(~this) int? {
    if this.cur >= this.limit {
      return none;
    }
    int v = this.cur;
    this.cur = this.cur + 1;
    return v;
  }
}
mk_upto(int n) UpTo {
  return UpTo(cur: 0, limit: n);
}
module_interface_default_through_view() `test {
  // count() — the original T1374 crash: an inherited terminal combinator
  // dispatched through the module-interface view jumped to a null vtable slot.
  Iterator[int] it = mk_upto(5);
  assert(it.count() == 5, "count() default through Iterator[int] view");
}
module_interface_default_direct() `test {
  // Same default called directly on the concrete (no view coercion).
  UpTo u = mk_upto(5);
  assert(u.count() == 5, "count() default called directly on concrete");
}
module_interface_defaults_collect_find() `test {
  // Additional terminal combinators through the view exercise more of the
  // synthesized vtable slots (collect, find, first) with data-dependent input.
  Iterator[int] a = mk_upto(4);
  assert(a.collect().len == 4, "collect() through Iterator[int] view");
  Iterator[int] b = mk_upto(9);
  if f := b.find(|int x| -> bool {
    return x == 3;
  }) {
    assert(f == 3, "find() through Iterator[int] view");
  } else {
    assert(false, "find() found nothing");
  }
  Iterator[int] c = mk_upto(5);
  if v := c.first() {
    assert(v == 0, "first() through Iterator[int] view");
  } else {
    assert(false, "first() found nothing");
  }
}
module_interface_closure_combinators_through_view() `test {
  // Closure-returning *intermediate* combinators (filter/map/take) through the
  // module-interface view. These are the vtable slots the plan flagged as the
  // risky part of per-concrete synthesis (each returns a `move ||` lambda that
  // captures `this`); a chained terminal then dispatches on the wrapped view.
  // Data-dependent input keeps opt from const-folding the chain away.
  Iterator[int] a = mk_upto(10);
  assert(a.filter(|int x| -> bool {
    return x % 2 == 0;
  }).count() == 5, "filter().count() through Iterator[int] view");

  Iterator[int] b = mk_upto(4);
  int[] mapped = b.map[int](|int x| -> int {
    return x * 10;
  }).collect();
  assert(mapped.len == 4, "map().collect() length through Iterator[int] view");
  assert(mapped[0] == 0 && mapped[3] == 30, "map().collect() values through view");

  Iterator[int] c = mk_upto(100);
  assert(c.take(7).count() == 7, "take().count() through Iterator[int] view");
}

// T1377: a *user-defined* generic structural interface (main file) that extends
// the *module*-defined Iterator[int]. A concrete implements the user interface;
// dispatching an inherited default combinator through the view crosses files
// transitively (UpTo2 -> MyIter[int] -> std Iterator[int]). The stub-declaration
// recursion previously reused the main file when resolving the grandparent
// Iterator, found nothing, declared no stub, and left the vtable slot null →
// segfault. Bound routed through the opaque `mk_upto2` helper so opt can't
// const-fold the dispatch away (same reasoning as mk_upto above).
type MyIter[T] is Iterator[T] `structural {
}
type UpTo2 is MyIter[int] {
  int cur;
  int limit;
  next(~this) int? {
    if this.cur >= this.limit {
      return none;
    }
    int v = this.cur;
    this.cur = this.cur + 1;
    return v;
  }
}
mk_upto2(int n) UpTo2 {
  return UpTo2(cur: 0, limit: n);
}
user_iface_extends_module_iface_through_view() `test {
  MyIter[int] it = mk_upto2(5);
  assert(it.count() == 5, "inherited combinator via user iface extending module iface");
}
user_iface_extends_module_iface_direct() `test {
  UpTo2 u = mk_upto2(5);
  assert(u.count() == 5, "same default called directly on concrete");
}
user_iface_chained_combinator_through_view() `test {
  MyIter[int] a = mk_upto2(10);
  assert(a.filter(|int x| -> bool {
    return x % 2 == 0;
  }).count() == 5, "filter().count() via user-iface view");
}

// T1377 (mono symmetry, runtime): a *generic concrete* type whose structural
// parent chain crosses files — MyBox[T] is MyIter[T] is std Iterator[T] —
// instantiated as MyBox[int] and dispatched through the MyIter[int] view. This is
// the runtime counterpart to the IR-shape Go test TestT1377MonoTransitiveDefault
// Defined: the transitively-inherited default must be both declared AND *defined*
// under the mono-qualified name (MyBox__int.count), else the slot is null (declare
// broken) or the stub is declared-but-undefined (only declare fixed). Bound routed
// through the opaque `mk_mybox` helper so opt can't const-fold the dispatch away.
type MyBox[T] is MyIter[T] {
  T val;
  int remaining;
  next(~this) T? {
    if this.remaining <= 0 {
      return none;
    }
    this.remaining = this.remaining - 1;
    return this.val;
  }
}
mk_mybox(int v, int n) MyBox[int] {
  return MyBox[int](val: v, remaining: n);
}
generic_concrete_cross_file_through_view() `test {
  MyIter[int] it = mk_mybox(7, 3);
  assert(it.count() == 3, "count() default through MyIter[int] view on generic concrete");
}
generic_concrete_cross_file_direct() `test {
  MyBox[int] b = mk_mybox(7, 4);
  assert(b.count() == 4, "count() default called directly on generic concrete");
}
generic_concrete_cross_file_chained() `test {
  // Chained intermediate combinator (filter) then a terminal (collect) through the
  // view exercises the closure-returning synthesized slots on the generic concrete.
  MyIter[int] a = mk_mybox(2, 6);
  int[] evens = a.filter(|int x| -> bool {
    return x % 2 == 0;
  }).collect();
  assert(evens.len == 6, "filter().collect() length via generic-concrete view");
  assert(evens[0] == 2 && evens[5] == 2, "filter().collect() values via generic-concrete view");
}
