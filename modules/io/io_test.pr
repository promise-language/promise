  // File.create on an existing directory path should fail
  if !Dir.exists(os.temp_dir + "/pr_iot_cdir") {
    Dir.make(os.temp_dir + "/pr_iot_cdir")?!;
  }
  bool caught = false;
  File.create(os.temp_dir + "/pr_iot_cdir")? e {
    caught = true;
