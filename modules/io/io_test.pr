dir_make_all_nested() `test(exclude: wasm) {
  // Clean up first
  if Dir.exists(os.temp_dir + "/pr_iot_mkall/a/b") {
    Dir.remove(os.temp_dir + "/pr_iot_mkall/a/b")?!;
  }
  if Dir.exists(os.temp_dir + "/pr_iot_mkall/a") {
    Dir.remove(os.temp_dir + "/pr_iot_mkall/a")?!;
  }
  if Dir.exists(os.temp_dir + "/pr_iot_mkall") {
    Dir.remove(os.temp_dir + "/pr_iot_mkall")?!;
  }

  Dir.make_all(os.temp_dir + "/pr_iot_mkall/a/b")?!;
  assert(Dir.exists(os.temp_dir + "/pr_iot_mkall"), "top dir exists");
  assert(Dir.exists(os.temp_dir + "/pr_iot_mkall/a"), "middle dir exists");
  assert(Dir.exists(os.temp_dir + "/pr_iot_mkall/a/b"), "leaf dir exists");

  // Clean up
  Dir.remove(os.temp_dir + "/pr_iot_mkall/a/b")?!;
  Dir.remove(os.temp_dir + "/pr_iot_mkall/a")?!;
  Dir.remove(os.temp_dir + "/pr_iot_mkall")?!;
}

dir_make_all_existing() `test(exclude: wasm) {
  if !Dir.exists(os.temp_dir + "/pr_iot_mkall2") {
    Dir.make(os.temp_dir + "/pr_iot_mkall2")?!;
  }
  // Should not error on existing directory
  Dir.make_all(os.temp_dir + "/pr_iot_mkall2")?!;
  assert(Dir.exists(os.temp_dir + "/pr_iot_mkall2"), "still exists after make_all on existing");
  Dir.remove(os.temp_dir + "/pr_iot_mkall2")?!;
}

dir_list_basic() `test(exclude: wasm) {
  // Clean up any leftovers from a previous run.
  if Dir.exists(os.temp_dir + "/pr_iot_list") {
    File.remove(os.temp_dir + "/pr_iot_list/aaa.txt")? e {
    };
    File.remove(os.temp_dir + "/pr_iot_list/bbb.txt")? e {
    };
    Dir.remove(os.temp_dir + "/pr_iot_list")?!;
  }
  Dir.make(os.temp_dir + "/pr_iot_list")?!;
  File.write_content(os.temp_dir + "/pr_iot_list/aaa.txt", "a")?!;
  File.write_content(os.temp_dir + "/pr_iot_list/bbb.txt", "b")?!;
  string[] entries = Dir.list(os.temp_dir + "/pr_iot_list")?!;
  assert(entries.len == 2, "exactly 2 entries");
  bool found_a = false;
  bool found_b = false;
  int i = 0;
  while i < entries.len {
    if entries[i] == "aaa.txt" {
      found_a = true;
    }
    if entries[i] == "bbb.txt" {
      found_b = true;
    }
    i += 1;
  }
  assert(found_a, "aaa.txt in listing");
  assert(found_b, "bbb.txt in listing");
  i = 0;
  while i < entries.len {
    assert(entries[i] != ".", "no dot entry");
    assert(entries[i] != "..", "no dotdot entry");
    i += 1;
  }
  File.remove(os.temp_dir + "/pr_iot_list/aaa.txt")?!;
  File.remove(os.temp_dir + "/pr_iot_list/bbb.txt")?!;
  Dir.remove(os.temp_dir + "/pr_iot_list")?!;
}

dir_list_empty() `test(exclude: wasm) {
