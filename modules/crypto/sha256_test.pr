// crypto/sha256_test.pr — FIPS 180-4 / RFC 6234 known-answer vectors, streaming
// equivalence, to_bytes round-trip, and the leading-zero padding guard.
// One-shot digests for the canonical FIPS 180-4 / RFC 6234 test vectors.
sha256_empty_test() `test {
  assert(to_hex(sha256("".bytes())) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  "empty string digest");
}

sha256_abc_test() `test {
  assert(to_hex(sha256("abc".bytes())) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
  "\"abc\" digest");
}

// 448-bit / 56-byte message: exactly fills one block after padding pushes into a
// second (the 0x80 + length no longer fit in block one).
sha256_448bit_test() `test {
  string msg = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
  assert(msg.len == 56, "vector is 56 bytes");
  assert(to_hex(sha256(msg.bytes())) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1",
  "448-bit two-block digest");
}

// 896-bit / 112-byte message spanning multiple full blocks.
sha256_896bit_test() `test {
  string msg = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
  assert(msg.len == 112, "vector is 112 bytes");
  assert(to_hex(sha256(msg.bytes())) == "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1",
  "896-bit multi-block digest");
}

// 1,000,000 repetitions of 'a' — exercises the streaming block-drain path over
// ~15,625 blocks in a single update() call.
sha256_million_a_test() `test {
  u8[] data = u8[].filled(97u8, 1000000);
  assert(to_hex(sha256(data)) == "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0",
  "one million 'a' digest");
}

// Padding guard: a digest that begins with a zero byte must still render as
// exactly 64 hex characters (bare to_string(base:16) would drop the leading
// "00" ~1 time in 256). Discovered input: the decimal string "286" hashes to
// 00328ce5...df60 — the smallest non-negative integer whose SHA-256 digest
// starts with 0x00. The bounded search below re-derives it as documentation.
sha256_leading_zero_padding_test() `test {
  u256 d = sha256("286".bytes());
  string hx = to_hex(d);
  assert(hx == "00328ce57bbc14b33bd6695bc8eb32cdf2fb5f3a7d89ec14a42825e15d39df60",
  "\"286\" digest");
  assert(hx.starts_with("00"), "digest begins with a zero byte");
  assert(hx.len == 64, "leading-zero digest still 64 hex chars");

  // Re-derive 286 as the smallest such integer (kept as executable documentation).
  int i = 0;
  int found = -1;
  while i < 1000 {
    if to_hex(sha256(i.to_string().bytes())).starts_with("00") {
      found = i;
      break;
    }
    i = i + 1;
  }
  assert(found == 286, "286 is the smallest integer with a leading-zero digest");
}

// Streaming in odd-sized chunks must equal the one-shot digest, for inputs that
// straddle block boundaries in different ways.
sha256_streaming_equivalence_test() `test {
  string msg = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
  u8[] bytes = msg.bytes();
  u256 oneshot = sha256(bytes);

  // Chunk sizes chosen to cross the 64-byte boundary at irregular offsets.
  int[] sizes = [1, 3, 7, 13, 64, 65, 100];
  int si = 0;
  while si < sizes.len {
    int step = sizes[si];
    Sha256 ctx = Sha256();
    int pos = 0;
    while pos < bytes.len {
      int end = pos + step;
      if end > bytes.len {
        end = bytes.len;
      }
      ctx.update(bytes[pos: end]);
      pos = end;
    }
    assert(ctx.finalize() == oneshot, "streaming chunk size matches one-shot");
    si = si + 1;
  }
}

// Streaming equivalence for the larger canonical vectors. The small streaming
// test above stays under 256 bytes / a handful of blocks; here the 896-bit and
// million-'a' inputs are fed in odd-sized chunks so the partial-buffer
// accumulation and repeated _drain path are exercised across many update() calls
// against a known FIPS digest, not just self-consistency.
sha256_streaming_large_test() `test {
  // 896-bit / 112-byte multi-block vector, streamed in odd chunks.
  string msg = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
  u8[] bytes = msg.bytes();
  int[] sizes = [1, 5, 17, 33, 64, 113];
  int si = 0;
  while si < sizes.len {
    int step = sizes[si];
    Sha256 ctx = Sha256();
    int pos = 0;
    while pos < bytes.len {
      int end = pos + step;
      if end > bytes.len {
        end = bytes.len;
      }
      ctx.update(bytes[pos: end]);
      pos = end;
    }
    assert(to_hex(ctx.finalize()) == "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1",
    "896-bit streamed in odd chunks matches FIPS digest");
    si = si + 1;
  }

  // 1,000,000 'a' fed in 97-byte updates: many blocks accumulated across ~10k
  // update() calls, drained incrementally, checked against the known digest.
  // 97 does not divide 1,000,000, so the final chunk is short (exercising the
  // clamp) and each chunk straddles the 64-byte block boundary unevenly.
  u8[] million = u8[].filled(97u8, 1000000);
  Sha256 big = Sha256();
  int p = 0;
  while p < million.len {
    int e = p + 97;
    if e > million.len {
      e = million.len;
    }
    big.update(million[p: e]);
    p = e;
  }
  assert(to_hex(big.finalize()) == "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0",
  "million 'a' streamed in 97-byte chunks matches FIPS digest");
}

// Empty streaming (no update, or a single empty update) equals sha256("").
sha256_streaming_empty_test() `test {
  u256 expected = sha256("".bytes());
  Sha256 a = Sha256();
  assert(a.finalize() == expected, "no update finalizes to empty digest");
  Sha256 b = Sha256();
  b.update("".bytes());
  assert(b.finalize() == expected, "empty update finalizes to empty digest");
}

// Block-boundary lengths exercise the three padding regimes: padding fitting in
// the same block (55), the 0x80 terminator spilling into a second block (56, 63,
// 64, 65), and an exact multiple of 64 where padding forms a whole extra block
// (64, 128). Reference digests from Python hashlib (all inputs are repeated 'a').
sha256_block_boundary_test() `test {
  // 55 bytes: 55 + 0x80 + 8-byte length == 64, padding stays in one block.
  assert(to_hex(sha256(u8[].filled(97u8, 55))) == "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318", "55 x 'a'");
  // 56 bytes: 0x80 no longer fits before the length field, forcing a 2nd block.
  assert(to_hex(sha256(u8[].filled(97u8, 56))) == "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a", "56 x 'a'");
  // 63 bytes: one byte short of a full block.
  assert(to_hex(sha256(u8[].filled(97u8, 63))) == "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34", "63 x 'a'");
  // 64 bytes: exactly one full block; padding becomes an entire second block.
  assert(to_hex(sha256(u8[].filled(97u8, 64))) == "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb", "64 x 'a'");
  // 65 bytes: one full block drained plus a 1-byte tail spanning two more blocks.
  assert(to_hex(sha256(u8[].filled(97u8, 65))) == "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0", "65 x 'a'");
  // 128 bytes: two exact full blocks plus a third all-padding block.
  assert(to_hex(sha256(u8[].filled(97u8, 128))) == "6836cf13bac400e9105071cd6af47084dfacad4e5e302c94bfed24e013afb73e", "128 x 'a'");
}

// Binary input with the high bit set exercises the big-endian word assembly and
// the ~e / bitwise round math over the full u8 range (all vectors above are
// 7-bit ASCII). Reference digests from Python hashlib.
sha256_binary_input_test() `test {
  // Every byte value 0x00..0xff, in order.
  u8[] all = u8[]();
  int i = 0;
  while i < 256 {
    all.push(i as! u8);
    i = i + 1;
  }
  assert(to_hex(sha256(all)) == "40aff2e9d2d8922e47afd4648e6967497158785fbd1da870e7110266bf944880", "0x00..0xff");

  // A single 0xff byte (top bit set in the first schedule word).
  assert(to_hex(sha256(u8[].filled(0xffu8, 1))) == "a8100ae6aa1940d0b663bb31cd466142ebbdbd5187131b92d93818987832eb89", "single 0xff");

  // Streaming the 256-byte binary buffer in odd chunks equals the one-shot digest.
  u256 oneshot = sha256(all);
  Sha256 ctx = Sha256();
  int pos = 0;
  while pos < all.len {
    int end = pos + 7;
    if end > all.len {
      end = all.len;
    }
    ctx.update(all[pos: end]);
    pos = end;
  }
  assert(ctx.finalize() == oneshot, "binary streaming matches one-shot");
}

// to_bytes must preserve a leading zero byte (the byte-level analogue of the hex
// padding guard): the "286" digest begins with 0x00, and the 32 bytes must still
// round-trip to the full 64-char hex, with byte[0] == 0.
sha256_to_bytes_leading_zero_test() `test {
  u256 d = sha256("286".bytes());
  u8[] bytes = to_bytes(d);
  assert(bytes.len == 32, "digest is 32 bytes");
  assert(bytes[0] == 0u8, "leading byte is zero");

  Builder b = Builder(capacity: 64);
  int i = 0;
  while i < bytes.len {
    b.write_string((bytes[i] as! uint).to_string(base: 16, width: 2, fill: '0'));
    i = i + 1;
  }
  assert(b.to_string() == to_hex(d), "leading-zero bytes round-trip to hex");
}

// Digest inequality: distinct inputs must yield distinct digests, and u256 `==`
// must return false for them. Every other assertion here checks `==` -> true;
// this exercises the reject path (`==` -> false) that signature verification
// depends on — a broken comparator that always answered true would pass every
// known-answer vector above yet silently accept forged signatures.
sha256_digest_inequality_test() `test {
  u256 a = sha256("abc".bytes());
  u256 b = sha256("abd".bytes()); // one bit flipped in the last byte
  assert(!(a == b), "distinct inputs produce unequal digests");
  assert(a != b, "!= agrees with ==");
  // Single-bit input difference propagates to a wholly different digest.
  assert(to_hex(a) != to_hex(b), "hex renderings differ");
  // A digest equals itself (reflexive true branch, distinct from KAT compares).
  assert(a == sha256("abc".bytes()), "same input reproduces the same digest");
}

// to_bytes yields 32 big-endian bytes that round-trip back to the hex digest.
sha256_to_bytes_roundtrip_test() `test {
  u256 d = sha256("abc".bytes());
  u8[] bytes = to_bytes(d);
  assert(bytes.len == 32, "digest is 32 bytes");

  // Re-hex the bytes and compare against to_hex(d).
  Builder b = Builder(capacity: 64);
  int i = 0;
  while i < bytes.len {
    b.write_string((bytes[i] as! uint).to_string(base: 16, width: 2, fill: '0'));
    i = i + 1;
  }
  assert(b.to_string() == to_hex(d), "to_bytes round-trips against to_hex");
}
