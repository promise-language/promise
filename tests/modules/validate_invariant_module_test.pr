// T1752 — `_validate!` across a module boundary. The invariant lives in the
// module; the construction site is here, so codegen must resolve the
// module-owned `_validate` function (and, for the inherited chain, each
// ancestor's) from user code.
use validatemod "./validatemod";

module_type_validates_at_the_user_construction_site() `test {
  validatemod.Port p = validatemod.Port(value: 80)?!;
  assert(p.value == 80, "a valid module type constructs");

  string msg = "";
  validatemod.Port bad = validatemod.Port(value: -1)? e {
    msg = e.message.clone();
    validatemod.Port(value: 1)?!
  };
  assert(msg == "port out of range", "the module's invariant ran here, got: {msg}");
}

module_inherited_chain_runs_parent_first() `test {
  validatemod.Endpoint e1 = validatemod.Endpoint(value: 443, host: "example.com")?!;
  assert(e1.host == "example.com", "the child constructs");

  // Violates BOTH: the parent's runs first, so its message surfaces.
  string msg = "";
  validatemod.Endpoint bad = validatemod.Endpoint(value: -1, host: "")? e {
    msg = e.message.clone();
    validatemod.Endpoint(value: 1, host: "y")?!
  };
  assert(msg == "port out of range", "the parent's invariant ran first, got: {msg}");

  string msg2 = "";
  validatemod.Endpoint bad2 = validatemod.Endpoint(value: 80, host: "")? e {
    msg2 = e.message.clone();
    validatemod.Endpoint(value: 1, host: "y")?!
  };
  assert(msg2 == "empty host", "the child's invariant ran, got: {msg2}");
}

module_generic_validates_per_instance() `test {
  validatemod.Boxed[int] b = validatemod.Boxed[int](item: 7, count: 2)?!;
  assert(b.count == 2, "the monomorphized instance validated");

  string msg = "";
  validatemod.Boxed[string] s = validatemod.Boxed[string](item: "x", count: 0)? e {
    msg = e.message.clone();
    validatemod.Boxed[string](item: "y", count: 1)?!
  };
  assert(msg == "count must be positive", "the invariant monomorphized, got: {msg}");
}
