// Test the io module (compiled as part of the module).
use os;

// flaky leak — sometimes leaks depending on timing
strerror_known_codes() `test {
  assert(_io_strerror(1) == "operation not permitted", "errno 1");
  assert(_io_strerror(2) == "no such file or directory", "errno 2");
  assert(_io_strerror(13) == "permission denied", "errno 13");
  assert(_io_strerror(22) == "invalid argument", "errno 22");
}

strerror_unknown_code() `test {
  string msg = _io_strerror(9999);
  assert(msg == "I/O error (errno 9999)", "unknown errno fallback");
}

make_io_error_test() `test {
  IoError e = _make_io_error(-2);
  assert(e.code == 2, "io error code from -errno");
  assert(e.message == "no such file or directory", "io error message");
}

file_create_exists_remove() `test(exclude: wasm) {
  if File.exists(os.temp_dir + "/pr_iot_cer") {
    File.remove(os.temp_dir + "/pr_iot_cer")?!;
  }
  File f = File.create(os.temp_dir + "/pr_iot_cer")?!;
  f.close()?!;
  assert(File.exists(os.temp_dir + "/pr_iot_cer"), "file exists after create");
  File.remove(os.temp_dir + "/pr_iot_cer")?!;
  assert(!File.exists(os.temp_dir + "/pr_iot_cer"), "file gone after remove");
}

// T1742: a file that is open must still be removable — on Windows that needs
// FILE_SHARE_DELETE on every handle, which no CRT open grants. Passes trivially
// on POSIX (unlink); failed with EACCES on Windows before pal_file_open moved to
// CreateFileA. `!File.exists` is asserted only after both handles close, because
// Windows deletes are delete-pending: the name stays visible until the last
// handle goes away (docs/io.md 6.2 states that difference rather than hiding it).
file_remove_while_open() `test(exclude: wasm) {
  string p = os.temp_dir + "/pr_iot_rwo";
  if File.exists(p) {
    File.remove(p)?!;
  }
  File w = File.create(p)?!;
  w.write_string("hello")?!;
  File r = File.open_read(p)?!; // second handle on the same path
  File.remove(p)?!; // must succeed while both handles are open
  r.close()?!;
  w.close()?!;
  assert(!File.exists(p), "file gone after both handles close");
}

file_write_read() `test(exclude: wasm) {
  File fw = File.create(os.temp_dir + "/pr_iot_wr")?!;
  fw.write_string("hello world")?!;
  fw.close()?!;
  File fr = File.open_read(os.temp_dir + "/pr_iot_wr")?!;
  string data = fr.read_all()?!;
  fr.close()?!;
  assert(data == "hello world", "read back what was written");
  File.remove(os.temp_dir + "/pr_iot_wr")?!;
}

