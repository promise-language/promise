{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/bin/guard\" || true",
            "shell": "bash",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write|Skill|Task|Agent|mcp__.*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/bin/guard\" || exit 2",
            "shell": "bash",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/bin/guard\" || exit 2",
            "shell": "bash",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Skill|Task|Agent|mcp__.*"
      }
    ]
  }
}
