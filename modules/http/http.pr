// http module — HTTP/1.1 client (T0072).
// Built on top of modules/net/ (TcpStream), modules/json/ (encode/decode),
// and modules/gzip/ (response decoding).
// HTTP only (no TLS). Request.send uses one Connection: close exchange; Client
// (T0447) adds redirect following, keep-alive connection reuse, and gzip.
use gzip;
use json;
use net;

type HttpError is error `public `doc("HTTP error with an optional status code.") {
  int code;
}

enum Method `public `doc("HTTP request method.") {
  Get,
  Post,
  Put,
  Delete,
  Patch,
  Head,
  Options,
}

type Request `public `doc("An HTTP request.") {
  Method method;
  string url;
  map[string, string] headers;
  string body;

  new_get(string move url) Self `factory `public `doc("Create a GET request.") {
    return Request(method: move Method.Get, url: move url, headers: map[string, string](), body: "");
  }

  new_post(string move url, string move body) Self `factory `public `doc("Create a POST request with a text body.") {
    map[string, string] h = map[string, string]();
    h["Content-Type"] = "text/plain";
    return Request(method: move Method.Post, url: move url, headers: move h, body: move body);
  }

  set_header(~this, string move key, string move value) `public `doc("Set a header on the request.") {
    this.headers[key] = value;
  }

  send!(~this) Response `public `doc("Send the request over a single fresh connection (Connection: close) and return the response. gzip responses are decoded, but no redirect following or connection reuse is performed — for those, construct a Client.") {
    _Url parsed = _parse_url(this.url)?^;
    net.TcpStream stream = net.TcpStream.connect(parsed.host, parsed.port)?^;
    // keep_alive=false, want_gzip=false: preserve the historical single-exchange,
    // plaintext-request semantics of Request.send.
    u8[] req_bytes = _build_request(this.method, parsed, this.headers, this.body, false, false);
    bool is_head = _is_head(this.method);
    _RawResponse rr = _exchange(stream, req_bytes, is_head)?^;
    return _raw_to_response(rr);
  }
}

type Response `public `doc("An HTTP response.") {
  int _status;
  map[string, string] _headers;
  string _body;

  get status int `public `doc("The response status code.") => this._status;

  get headers map[string, string] `public `doc("The response headers (keys are lowercase).") => this._headers.clone();

  get body string `public `doc("The response body as a string.") => this._body;

  get body_bytes u8[] `public `doc("The response body as raw bytes.") => this._body.bytes();

  json![T: Decodable](~this) T `public `doc("Decode the response body from JSON into a typed value.") {
    return json.decode_string[T](this._body)?^;
  }

  get is_success bool `public `doc("True if the status code indicates success (2xx).") => this._status >= 200 && this._status < 300;
}

// _RawResponse is the framed result of a single request/response exchange,
// shared by Request.send and Client.send. `keep_alive` is true only when the
// body was definitively framed (Content-Length or chunked) AND the connection
// may be reused per HTTP semantics — such a socket can go back into the pool.
type _RawResponse {
  int status;
  map[string, string] headers;
  u8[] body;
  bool keep_alive;
}

// Pool is a small LIFO cache of idle keep-alive connections, keyed by
// "host:port". Parallel arrays keep a stream beside its key. LIFO reuse is
// optimal for the single-host request bursts this client targets (e.g. the
// GitHub API). Eviction and drain close fds via TcpStream.drop — no explicit
// close needed, so the pool is leak-free by construction.
type Pool {
  string[] _keys;
  net.TcpStream[] _streams;
  int _limit;

  create(int limit) Self `factory {
    return Pool(_keys: string[](), _streams: net.TcpStream[](), _limit: limit);
  }

  // take returns an idle connection for `key` when the most-recently-returned
  // connection matches (LIFO), else none.
  take(~this, string key) net.TcpStream? {
    int n = this._keys.len;
    if n > 0 && this._keys[n - 1] == key {
      this._keys.remove(n - 1);
      return this._streams.pop();
    }
    return none;
  }

  // put returns a connection to the pool, evicting the oldest (index 0) when at
  // capacity. The evicted stream's drop closes its fd.
  put(~this, string move key, net.TcpStream move s) {
    if this._keys.len >= this._limit {
      this._keys.remove(0);
      this._streams.remove(0);
    }
    this._keys.push(move key);
    this._streams.push(move s);
  }

  // drain closes every pooled connection now (rather than at drop time).
  drain(~this) {
    while this._streams.len > 0 {
      this._streams.remove(this._streams.len - 1);
    }
    while this._keys.len > 0 {
      this._keys.remove(this._keys.len - 1);
    }
  }
}

type Client `public `doc("A reusable HTTP/1.1 client with redirect following, keep-alive connection reuse, and automatic gzip response decoding. Create once and reuse for many requests to the same host. Not safe for concurrent use — the connection pool is mutated per request, so use one Client per goroutine.") {
  Pool _pool;
  int _max_redirects;
  bool _auto_gzip;

  create(int max_redirects = 10, bool auto_gzip = true) Self `factory `public `doc("Create a client. max_redirects bounds redirect hops (default 10); auto_gzip sends Accept-Encoding: gzip and decodes gzip responses (default true).") {
    return Client(_pool: Pool.create(8), _max_redirects: max_redirects, _auto_gzip: auto_gzip);
  }

  send!(~this, Request move req) Response `public `doc("Send a request, following up to max_redirects redirects and reusing pooled connections. Redirect policy: 303 becomes GET (body dropped); 307/308 preserve method and body; 301/302 preserve GET/HEAD but rewrite other methods to GET (body dropped). Authorization and Cookie headers are stripped when a redirect crosses to a different host:port. A redirect to https:// raises HttpError until TLS support lands (T0079).") {
    Method method = _method_clone(req.method);
    string url = req.url[0:];
    map[string, string] headers = req.headers.clone();
    string body = req.body[0:];

    int hops = 0;
    for {
      _Url parsed = _parse_url(url)?^;
      bool is_head = _is_head(method);
      _RawResponse rr = this._send_once(parsed, method, headers, body, is_head)?^;

      if !_is_redirect(rr.status) {
        return _raw_to_response(rr);
      }
      if hops >= this._max_redirects {
        raise HttpError(code: rr.status, message: "too many redirects");
      }

      string location = "";
      bool have_location = false;
      if loc := rr.headers["location"] {
        location = loc[0:];
        have_location = true;
      }
      if !have_location {
        // 3xx without a Location header — nothing to follow; return it as-is.
        return _raw_to_response(rr);
      }

      string new_url = _resolve_url(parsed, location)?^;
      _Url new_parsed = _parse_url(new_url)?^;
      if new_parsed.host != parsed.host || new_parsed.port != parsed.port {
        // Cross-host redirect: drop credentials so they are not leaked.
        _strip_header_ci(headers, "authorization");
        _strip_header_ci(headers, "cookie");
      }

      // Apply the method/body rewrite policy for this status.
      if rr.status == 303 {
        method = _method_get();
        body = "";
      } else if rr.status == 301 || rr.status == 302 {
        if !_is_get_or_head(method) {
          method = _method_get();
          body = "";
        }
      }
      // 307/308: preserve method and body unchanged.

      url = new_url;
      hops = hops + 1;
    }
  }

  get!(~this, string move url) Response `public `doc("Send a GET request, following redirects and reusing connections.") {
    return this.send(Request.new_get(move url))?^;
  }

  post!(~this, string move url, string move body) Response `public `doc("Send a POST request with a text/plain body, following redirects and reusing connections.") {
    return this.send(Request.new_post(move url, move body))?^;
  }

  close(~this) `public `doc("Close all pooled connections now. The client remains usable; later requests reconnect.") {
    this._pool.drain();
  }

  // _send_once runs a single hop: reuse a pooled connection when one is
  // available (retrying on a fresh connection if the pooled one is stale), else
  // connect fresh. Reusable connections are returned to the pool.
  _send_once!(~this, _Url base, Method method, map[string, string] headers, string body, bool is_head) _RawResponse {
    string key = _pool_key(base);
    // take() borrows the key, so pass it directly (no copy).
    if pooled := this._pool.take(key) {
      u8[] req_bytes = _build_request(method, base, headers, body, true, this._auto_gzip);
      _RawResponse rr = _exchange(pooled, req_bytes, is_head)? e {
        // Stale pooled connection (server closed it while idle). The request is
        // fully in memory, so it is safe to discard this socket and resend on a
        // fresh one. `pooled` drops here, closing the dead fd.
        return this._send_fresh(base, key[0:], method, headers, body, is_head)?^;
      };
      if rr.keep_alive {
        this._pool.put(move key, move pooled);
      }
      return rr;
    }
    return this._send_fresh(base, key[0:], method, headers, body, is_head)?^;
  }

  _send_fresh!(~this, _Url base, string move key, Method method, map[string, string] headers, string body, bool is_head) _RawResponse {
    net.TcpStream stream = net.TcpStream.connect(base.host, base.port)?^;
    u8[] req_bytes = _build_request(method, base, headers, body, true, this._auto_gzip);
    _RawResponse rr = _exchange(stream, req_bytes, is_head)?^;
    if rr.keep_alive {
      this._pool.put(move key, move stream);
    }
    return rr;
  }
}

type ServerShutdownHandle `public `doc("A handle to shut down a running Server. Create before calling serve, then call shutdown from another goroutine.") {
  string _address;
  int _port;
  channel[bool] _stop;

  shutdown!(~this) `public `doc("Shut down the server. Signals the serve loop to stop and connects to wake the accept call.") {
    this._stop.send(true);
    net.TcpStream conn = net.TcpStream.connect(this._address, this._port)? e {
      return;
    };
    conn.close()? e {
    };
  }
}

type Handler `structural(protocol: true) `public `doc("Interface for handling HTTP requests. Implement handle! to process requests. The server shares one handler across every connection goroutine, so handle takes a shared receiver: handler state must either be immutable or guarded by Mutex[T].") {
  handle!(this, ServerRequest request) ServerResponse `abstract `doc("Handle an incoming request and return a response. Called concurrently from many connection goroutines through a shared reference — guard any mutable state with Mutex[T].");
}

type ServerRequest `public `doc("An incoming HTTP request received by the server.") {
  Method _method;
  string _path;
  string _query;
  map[string, string] _headers;
  string _body;
  // True when the request line said HTTP/1.1 (or later). Decides the
  // keep-alive default: persistent unless refused under 1.1, and only on an
  // explicit Connection: keep-alive under 1.0.
  bool _http11;

  get method Method `public `doc("The HTTP method.") => this._method;
  get path string `public `doc("The request path (without query string).") => this._path;
  get query string `public `doc("The query string (after '?'), empty if none.") => this._query;
  get body string `public `doc("The request body.") => this._body;

  header(this, string key) string? `public `doc("Get a header value by name (case-insensitive, keys stored lowercase).") {
    string lower = key.to_lower();
    string lookup = lower[0:];
    if this._headers.contains(lookup) {
      return this._headers[lower];
    }
    return none;
  }
}

type ServerResponse `public `doc("An HTTP response to send to the client.") {
  int status;
  map[string, string] headers;
  string body;

  with_status(int status, string move body) Self `factory `public `doc("Create a response with the given status code and body.") {
    return ServerResponse(status: status, headers: map[string, string](), body: move body);
  }

  ok(string move body) Self `factory `public `doc("Create a 200 OK response.") {
    return ServerResponse(status: 200, headers: map[string, string](), body: move body);
  }

  not_found() Self `factory `public `doc("Create a 404 Not Found response.") {
    return ServerResponse(status: 404, headers: map[string, string](), body: "Not Found");
  }

  internal_error(string move message) Self `factory `public `doc("Create a 500 Internal Server Error response.") {
    return ServerResponse(status: 500, headers: map[string, string](), body: move message);
  }

  set_header(~this, string move key, string move value) `public `doc("Set a response header.") {
    this.headers[key] = value;
  }
}

type Server `public `doc("An HTTP/1.1 server that handles each connection on its own goroutine, with keep-alive and a bounded number of concurrent connections.") {
  net.TcpListener _listener;
  string _address;
  int _port;
  channel[bool] _stop;
  int _max_connections;
  int _max_keep_alive_requests;

  bind!(string move address, int port, int max_connections = 128, int max_keep_alive_requests = 100) Self `factory `public `doc("Create a server bound to the given address and port. max_connections bounds how many connections are handled at once; max_keep_alive_requests bounds how many requests one connection may serve before the server closes it. Both must be at least 1.") {
    // Both bounds are rejected rather than clamped: max_connections becomes the
    // capacity of the accept semaphore, so 0 would leave serve unable to admit
    // a single connection, and max_keep_alive_requests below 1 would accept a
    // connection only to close it without a response. Either one silently looks
    // like a server that hangs.
    if max_connections < 1 {
      raise HttpError(code: 0, message: "max_connections must be at least 1, got " + max_connections.to_string());
    }
    if max_keep_alive_requests < 1 {
      raise HttpError(code: 0, message: "max_keep_alive_requests must be at least 1, got " + max_keep_alive_requests.to_string());
    }
    string addr = address[0:];
    net.TcpListener listener = net.TcpListener.bind(addr, port)?^;
    int actual_port = listener.local_port;
    return Server(_listener: move listener, _address: move address, _port: actual_port, _stop: channel[bool](capacity: 1), _max_connections: max_connections, _max_keep_alive_requests: max_keep_alive_requests);
  }

  create_shutdown_handle(this) ServerShutdownHandle `public `doc("Create a shutdown handle. Must be called before serve. The handle can be sent to another goroutine to stop the server.") {
    channel[bool] stop_ref = this._stop;
    return ServerShutdownHandle(_address: this._address[0:],
    _port: this._port,
    _stop: move stop_ref);
  }

  serve![H: Handler](~this, H move handler) `public `doc("Accept connections and handle each one on its own goroutine until shutdown or a listener error. At most max_connections connections are handled at once; beyond that the server stops accepting and further connections wait in the listen backlog. Returns only after every in-flight connection has finished. Blocks.") {
    // The handler is shared, not moved per connection: Ref[H] is `sendable, so
    // one clone can travel into each connection goroutine, and handle takes a
    // shared receiver.
    Ref[H] shared = Ref[H](move handler);
    // `this` is a mutable borrow and must not be captured by a `go` block, so
    // everything the goroutines need is hoisted into owned locals first.
    int limit = this._max_connections;
    int keep_limit = this._max_keep_alive_requests;
    // Semaphore: a send acquires a slot, a receive releases it. Acquiring
    // before accept is what bounds concurrency — at capacity the loop simply
    // stops accepting, so backpressure lands in the listen backlog instead of
    // spawning goroutines without limit.
    // T1669: a connection holds its slot while idle between keep-alive
    // requests too, so max_connections idle clients can stall accept. An idle
    // timeout needs a read deadline that modules/net does not expose yet;
    // max_keep_alive_requests bounds the damage in the meantime.
    channel[bool] sem = channel[bool](capacity: limit);

    while true {
      bool stopped = false;
      select {
        sem.send(true):
          stopped = false;
        _ := <-this._stop:
          stopped = true;
      }
      if stopped {
        break;
      }

      net.TcpStream conn = this._listener.accept()? e {
        // An error handler feeding an assignment must diverge, so this exit
        // drains explicitly instead of breaking to the drain below.
        _ := <-sem;
        _drain_slots(sem, limit);
        return;
      };

      // Shutdown may have been signalled while we were blocked in accept —
      // this is the branch ServerShutdownHandle's wake connection lands on.
      bool woken_to_stop = false;
      select {
        _ := <-this._stop:
          woken_to_stop = true;
        default:
          woken_to_stop = false;
      }
      if woken_to_stop {
        _ := <-sem;
        break;
      }

      Ref[H] connection_handler = shared.clone();
      go {
        _serve_connection[H](conn, connection_handler, keep_limit);
        _ := <-sem;
        return;
      };
    }

    _drain_slots(sem, limit);
  }

  close!(~this) `public `doc("Close the server's listener.") {
    this._listener.close()?^;
  }

  get address string `public `doc("The bound address.") => this._address;
  get port int `public `doc("The bound port.") => this._port;
  get max_connections int `public `doc("The maximum number of connections handled concurrently.") => this._max_connections;
  get max_keep_alive_requests int `public `doc("The maximum number of requests one keep-alive connection may serve before the server closes it.") => this._max_keep_alive_requests;
}

http_get!(string move url) Response `public `doc("Perform an HTTP GET request. Follows redirects and decodes gzip responses via a transient Client.") {
  Client client = Client.create();
  return client.send(Request.new_get(move url))?^;
}

http_post!(string move url, string move body, map[string, string] move headers) Response `public `doc("Perform an HTTP POST request with a string body. Follows redirects and decodes gzip responses via a transient Client.") {
  Request req = Request.new_post(move url, move body);
  for key, value in headers {
    req.set_header(move key, move value);
  }
  Client client = Client.create();
  return client.send(move req)?^;
}

http_post_json![T: Encodable](string move url, T data) Response `public `doc("Perform an HTTP POST request with a JSON-encoded body.") {
  string json_body = json.encode_string[T](data)?^;
  map[string, string] h = map[string, string]();
  h["Content-Type"] = "application/json";
  return http_post(move url, move json_body, move h)?^;
}

type _Url {
  string host;
  int port;
  string path;
}

type _ParsedResponse {
  int status;
  map[string, string] headers;
}

_parse_url!(string url) _Url {
  if !url.starts_with("http://") {
    raise HttpError(code: 0, message: "unsupported URL scheme (only http:// supported)");
  }
  string rest = url[7:];

  // Split host+port from path at first '/'
  string host_part = "";
  string path_val = "/";
  if slash := rest.index_of("/") {
    host_part = rest[0:slash];
    path_val = rest[slash:];
  } else {
    host_part = rest;
  }

  // Split host from port at ':'
  string host_val = "";
  int port_val = 80;
  if colon := host_part.index_of(":") {
    host_val = host_part[0:colon];
    port_val = _parse_decimal(host_part[colon + 1:]);
  } else {
    host_val = host_part;
  }

  if host_val.len == 0 {
    raise HttpError(code: 0, message: "empty host in URL");
  }

  return _Url(host: move host_val, port: port_val, path: move path_val);
}

_method_to_string(Method m) string {
  return match m {
    Method.Get => "GET",
    Method.Post => "POST",
    Method.Put => "PUT",
    Method.Delete => "DELETE",
    Method.Patch => "PATCH",
    Method.Head => "HEAD",
    Method.Options => "OPTIONS",
  };
}

_method_get() Method {
  return Method.Get;
}

// _method_clone reconstructs a Method (a non-copy enum) so callers can hold a
// method independently of the moved-in Request.
_method_clone(Method m) Method {
  return match m {
    Method.Get => Method.Get,
    Method.Post => Method.Post,
    Method.Put => Method.Put,
    Method.Delete => Method.Delete,
    Method.Patch => Method.Patch,
    Method.Head => Method.Head,
    Method.Options => Method.Options,
  };
}

_is_head(Method m) bool {
  return match m {
    Method.Head => true,
    _ => false,
  };
}

_is_get_or_head(Method m) bool {
  return match m {
    Method.Get => true,
    Method.Head => true,
    _ => false,
  };
}

_is_redirect(int status) bool {
  return status == 301 || status == 302 || status == 303 || status == 307 || status == 308;
}

_pool_key(_Url base) string {
  Builder b = Builder();
  b.write_string(base.host);
  b.write_string(":");
  b.write_string(base.port.to_string());
  return b.to_string();
}

// _strip_header_ci removes every header whose name matches `name`
// (case-insensitively). Request headers preserve the caller's original casing,
// so a plain map.remove would miss "Authorization" vs "authorization".
_strip_header_ci(map[string, string] ~headers, string name) {
  string[] to_remove = string[]();
  for k, v in headers {
    if k.to_lower() == name {
      to_remove.push(k[0:]);
    }
  }
  int i = 0;
  while i < to_remove.len {
    headers.remove(to_remove[i]);
    i = i + 1;
  }
}

// _resolve_url resolves a redirect Location against the current request URL.
// Handles absolute http:// URLs, scheme-relative //host/path, absolute-path
// /path (same host:port), and basic relative-path joins. https:// targets raise
// until TLS support lands (T0079).
_resolve_url!(_Url base, string location) string {
  if location.starts_with("http://") {
    return location[0:];
  }
  if location.starts_with("https://") {
    raise HttpError(code: 0, message: "redirect to https:// is not supported yet (T0079)");
  }
  if location.starts_with("//") {
    // Scheme-relative: inherit http.
    return "http:" + location;
  }

  Builder auth = Builder();
  auth.write_string("http://");
  auth.write_string(base.host);
  if base.port != 80 {
    auth.write_string(":");
    auth.write_string(base.port.to_string());
  }
  string prefix = auth.to_string();

  if location.starts_with("/") {
    // Absolute path on the same authority.
    return prefix + location;
  }

  // Relative path: join against the base path's directory.
  string base_path = base.path[0:];
  if q := base_path.index_of("?") {
    base_path = base_path[0:q];
  }
  int last_slash = -1;
  int i = 0;
  while i < base_path.len {
    if base_path[i] == '/' {
      last_slash = i;
    }
    i = i + 1;
  }
  string dir = "/";
  if last_slash >= 0 {
    dir = base_path[0:last_slash + 1];
  }
  return prefix + dir + location;
}

// _build_request serializes an HTTP/1.1 request. It sends Connection: keep-alive
// or close per `keep_alive`, adds Accept-Encoding: gzip when `want_gzip` and the
// caller did not already set it, and always recomputes Content-Length from
// `body`. Caller-managed headers (Host, Connection, Content-Length) are skipped
// so they cannot be duplicated.
_build_request(Method method, _Url parsed, map[string, string] headers, string body, bool keep_alive, bool want_gzip) u8[] {
  Builder buf = Builder();
  buf.write_string(_method_to_string(method));
  buf.write_string(" ");
  buf.write_string(parsed.path);
  buf.write_string(" HTTP/1.1\r\n");
  buf.write_string("Host: ");
  buf.write_string(parsed.host);
  if parsed.port != 80 {
    buf.write_string(":");
    buf.write_string(parsed.port.to_string());
  }
  buf.write_string("\r\n");
  if keep_alive {
    buf.write_string("Connection: keep-alive\r\n");
  } else {
    buf.write_string("Connection: close\r\n");
  }

  bool user_accept_encoding = false;
  for k, v in headers {
    if k.to_lower() == "accept-encoding" {
      user_accept_encoding = true;
    }
  }
  if want_gzip && !user_accept_encoding {
    buf.write_string("Accept-Encoding: gzip\r\n");
  }

  if body.len > 0 {
    buf.write_string("Content-Length: ");
    buf.write_string(body.len.to_string());
    buf.write_string("\r\n");
  }
  for key, value in headers {
    string lk = key.to_lower();
    if lk == "host" || lk == "connection" || lk == "content-length" {
      continue;
    }
    buf.write_string(key);
    buf.write_string(": ");
    buf.write_string(value);
    buf.write_string("\r\n");
  }
  buf.write_string("\r\n");
  if body.len > 0 {
    buf.write_string(body);
  }
  return buf.to_string().bytes();
}

// _exchange writes a request, reads and frames the response, gzip-decodes it
// when Content-Encoding is gzip, and reports whether the connection is reusable.
// The body is framed by Content-Length or chunked encoding (both stop exactly at
// the message boundary, leaving the socket reusable); a response with neither
// falls back to read-to-EOF and is never reusable. HEAD responses carry no body.
_exchange!(net.TcpStream ~stream, u8[] request_bytes, bool head_request) _RawResponse {
  _write_all(stream, request_bytes)?^;

  u8[] raw = u8[]();
  u8[] read_buf = u8[].filled(0, 4096);

  // Phase 1: read until the header terminator (\r\n\r\n = bytes 13,10,13,10).
  int header_end = -1;
  while header_end < 0 {
    int n = stream.read(read_buf)?^;
    if n == 0 {
      break;
    }
    int i = 0;
    while i < n {
      raw.push(read_buf[i]);
      i = i + 1;
    }
    int scan = raw.len - n;
    if scan > 3 {
      scan = scan - 3;
    }
    if scan < 0 {
      scan = 0;
    }
    while scan + 3 < raw.len {
      if raw[scan] == 13 && raw[scan + 1] == 10 && raw[scan + 2] == 13 && raw[scan + 3] == 10 {
        header_end = scan;
        break;
      }
      scan = scan + 1;
    }
  }
  if header_end < 0 {
    raise HttpError(code: 0, message: "malformed HTTP response: missing header terminator");
  }

  string header_text = string.from_bytes(raw[0:header_end]);
  bool http11 = header_text.starts_with("HTTP/1.1");
  _ParsedResponse pr = _parse_response(header_text)?^;

  // Determine body framing from the parsed headers.
  bool chunked = false;
  for k, v in pr.headers {
    if k == "transfer-encoding" && v.contains("chunked") {
      chunked = true;
    }
  }
  bool has_length = false;
  int content_length = 0;
  if cl := pr.headers["content-length"] {
    has_length = true;
    content_length = _parse_decimal(cl);
  }
  bool conn_close = false;
  bool conn_keepalive = false;
  if cv := pr.headers["connection"] {
    string lcv = cv.to_lower();
    if lcv.contains("close") {
      conn_close = true;
    }
    if lcv.contains("keep-alive") {
      conn_keepalive = true;
    }
  }

  // Phase 2: read the body according to its framing.
  int body_start = header_end + 4;
  u8[] body_data = u8[]();
  bool framed = false;
  if head_request {
    // No body on a HEAD response; the connection stays framed/reusable.
    framed = true;
  } else if chunked {
    body_data = _read_chunked_body(stream, raw, body_start)?^;
    framed = true;
  } else if has_length {
    int body_have = raw.len - body_start;
    while body_have < content_length {
      int n = stream.read(read_buf)?^;
      if n == 0 {
        break;
      }
      int i = 0;
      while i < n {
        raw.push(read_buf[i]);
        i = i + 1;
      }
      body_have = raw.len - body_start;
    }
    int end = body_start + content_length;
    if end > raw.len {
      end = raw.len;
    }
    body_data = raw[body_start: end];
    framed = true;
  } else {
    // No length and not chunked: read to EOF. Connection: close terminates the
    // stream, so the socket is not reusable afterward.
    bool reading = true;
    while reading {
      int n = stream.read(read_buf)?^;
      if n == 0 {
        reading = false;
      } else {
        int i = 0;
        while i < n {
          raw.push(read_buf[i]);
          i = i + 1;
        }
      }
    }
    body_data = raw[body_start: raw.len];
    framed = false;
  }

  // gzip decode (never for HEAD — there is no body to decode).
  if !head_request {
    if ce := pr.headers["content-encoding"] {
      if ce.to_lower().contains("gzip") {
        u8[] decoded = gzip.gunzip(body_data)? e {
          raise HttpError(code: 0, message: "gzip decode failed: " + e.message);
        };
        body_data = decoded;
      }
    }
  }

  // A connection is reusable only when the body was definitively framed. Under
  // HTTP/1.1 that is the default unless the server said Connection: close; under
  // HTTP/1.0 it requires an explicit Connection: keep-alive.
  bool keep_alive = false;
  if framed {
    if http11 {
      keep_alive = !conn_close;
    } else {
      keep_alive = conn_keepalive;
    }
  }

  return _RawResponse(status: pr.status, headers: pr.headers.clone(), body: move body_data, keep_alive: keep_alive);
}

// _read_chunked_body decodes a chunked transfer-encoded body incrementally,
// reading more from the stream only as needed and stopping exactly at the
// terminating 0-size chunk plus its trailer section. `raw` holds bytes already
// read past the header terminator; body_start indexes the first body byte.
// Stopping at the message boundary (rather than reading to EOF) is what makes a
// keep-alive connection reusable.
_read_chunked_body!(net.TcpStream ~stream, u8[] ~raw, int body_start) u8[] {
  u8[] result = u8[]();
  u8[] read_buf = u8[].filled(0, 4096);
  int pos = body_start;

  for {
    // Find the CRLF ending the chunk-size line, reading more if needed.
    int line_end = -1;
    for {
      int s = pos;
      while s + 1 < raw.len {
        if raw[s] == 13 && raw[s + 1] == 10 {
          line_end = s;
          break;
        }
        s = s + 1;
      }
      if line_end >= 0 {
        break;
      }
      int n = stream.read(read_buf)?^;
      if n == 0 {
        raise HttpError(code: 0, message: "malformed chunked body: unexpected EOF in chunk size");
      }
      int i = 0;
      while i < n {
        raw.push(read_buf[i]);
        i = i + 1;
      }
    }

    // Parse the hex chunk size, stripping any ;-extension.
    Builder hex_buf = Builder();
    int h = pos;
    while h < line_end {
      hex_buf.write_string((raw[h] as! char).to_string());
      h = h + 1;
    }
    string size_str = hex_buf.to_string().trim();
    if semi := size_str.index_of(";") {
      size_str = size_str[0:semi].trim();
    }
    int chunk_size = _parse_hex(size_str);
    int data_start = line_end + 2;

    if chunk_size == 0 {
      // Terminating chunk. Consume the trailer section up to the final blank
      // line (\r\n\r\n), reading more as needed, so the socket is left at the
      // message boundary.
      for {
        int found = -1;
        int q = line_end;
        while q + 3 < raw.len {
          if raw[q] == 13 && raw[q + 1] == 10 && raw[q + 2] == 13 && raw[q + 3] == 10 {
            found = q;
            break;
          }
          q = q + 1;
        }
        if found >= 0 {
          break;
        }
        int n = stream.read(read_buf)?^;
        if n == 0 {
          // Tolerate a missing final CRLF at EOF.
          break;
        }
        int i = 0;
        while i < n {
          raw.push(read_buf[i]);
          i = i + 1;
        }
      }
      break;
    }

    // Ensure the full chunk data plus its trailing CRLF is present.
    int need_end = data_start + chunk_size + 2;
    while raw.len < need_end {
      int n = stream.read(read_buf)?^;
      if n == 0 {
        raise HttpError(code: 0, message: "malformed chunked body: unexpected EOF in chunk data");
      }
      int i = 0;
      while i < n {
        raw.push(read_buf[i]);
        i = i + 1;
      }
    }

    int j = 0;
    while j < chunk_size {
      result.push(raw[data_start + j]);
      j = j + 1;
    }
    pos = data_start + chunk_size + 2;
  }
  return result;
}

// _raw_to_response converts the framed exchange result into the public Response.
// The headers map is cloned (partial field moves are not permitted); the body is
// copied out of its byte buffer by string.from_bytes.
_raw_to_response(_RawResponse rr) Response {
  string body_str = string.from_bytes(rr.body);
  return Response(_status: rr.status, _headers: rr.headers.clone(), _body: move body_str);
}

_write_all!(net.TcpStream ~stream, u8[] ~data) {
  int n = stream.write(data)?^;
  int offset = n;
  while offset < data.len {
    // Build a new buffer with remaining bytes (partial write path — rare)
    u8[] remaining = u8[]();
    int k = offset;
    while k < data.len {
      remaining.push(data[k]);
      k = k + 1;
    }
    n = stream.write(remaining)?^;
    offset = offset + n;
  }
}

// _graceful_close performs a lingering close: send FIN on the write half, drain
// any remaining inbound bytes, then close. This forces the kernel to do an
// orderly close (FIN) instead of an abortive close (RST) that would race ahead
// of the response the client is still reading — preventing intermittent
// "connection reset by peer" on loopback under load (T1322).
_graceful_close(net.TcpStream ~conn) {
  conn.shutdown(write: true)? e {
    // Peer may have already gone; still attempt to drain + close.
  };
  u8[] drain = u8[].filled(0, 1024);
  bool draining = true;
  while draining {
    int n = conn.read(drain)? e {
      // reset/error while draining is harmless; recover with 0 to end the loop
      0;
    };
    if n == 0 {
      draining = false;
    }
  }
  conn.close()? e {
  };
}

_parse_response!(string header_text) _ParsedResponse {
  string[] lines = header_text.split("\r\n");

  if lines.len == 0 {
    raise HttpError(code: 0, message: "empty HTTP response");
  }

  // Parse status code from first line: "HTTP/1.1 200 OK"
  int status = _parse_status_code(lines[0])?^;

  // Parse headers (lowercase keys)
  map[string, string] hdrs = map[string, string]();
  int i = 1;
  while i < lines.len {
    if colon := lines[i].index_of(":") {
      if colon > 0 {
        string key = lines[i][0:colon].trim().to_lower();
        string value = lines[i][colon + 1:].trim();
        hdrs[key] = value;
      }
    }
    i = i + 1;
  }

  return _ParsedResponse(status: status, headers: move hdrs);
}

_parse_status_code!(string line) int {
  if sp := line.index_of(" ") {
    string after = line[sp + 1:];
    if sp2 := after.index_of(" ") {
      return _parse_decimal(after[0:sp2]);
    }
    return _parse_decimal(after);
  }
  raise HttpError(code: 0, message: "malformed HTTP status line");
}

_parse_decimal(string s) int {
  int result = 0;
  int i = 0;
  while i < s.len {
    char c = s[i];
    if c >= '0' && c <= '9' {
      result = result * 10 + ((c as! int) - 48);
    }
    i = i + 1;
  }
  return result;
}

_parse_hex(string s) int {
  int result = 0;
  int i = 0;
  while i < s.len {
    char c = s[i];
    if c >= '0' && c <= '9' {
      result = result * 16 + ((c as! int) - 48);
    } else if c >= 'a' && c <= 'f' {
      result = result * 16 + ((c as! int) - 87);
    } else if c >= 'A' && c <= 'F' {
      result = result * 16 + ((c as! int) - 55);
    }
    i = i + 1;
  }
  return result;
}

_string_to_method!(string s) Method {
  if s == "GET" {
    return Method.Get;
  }
  if s == "POST" {
    return Method.Post;
  }
  if s == "PUT" {
    return Method.Put;
  }
  if s == "DELETE" {
    return Method.Delete;
  }
  if s == "PATCH" {
    return Method.Patch;
  }
  if s == "HEAD" {
    return Method.Head;
  }
  if s == "OPTIONS" {
    return Method.Options;
  }
  raise HttpError(code: 0, message: "unknown HTTP method: " + s);
}

_status_text(int code) string {
  if code == 200 {
    return "OK";
  }
  if code == 201 {
    return "Created";
  }
  if code == 204 {
    return "No Content";
  }
  if code == 301 {
    return "Moved Permanently";
  }
  if code == 302 {
    return "Found";
  }
  if code == 304 {
    return "Not Modified";
  }
  if code == 400 {
    return "Bad Request";
  }
  if code == 401 {
    return "Unauthorized";
  }
  if code == 403 {
    return "Forbidden";
  }
  if code == 404 {
    return "Not Found";
  }
  if code == 405 {
    return "Method Not Allowed";
  }
  if code == 411 {
    return "Length Required";
  }
  if code == 500 {
    return "Internal Server Error";
  }
  if code == 502 {
    return "Bad Gateway";
  }
  if code == 503 {
    return "Service Unavailable";
  }
  return "Unknown";
}

_find_content_length(string ~header_text) int {
  string[] lines = header_text.split("\r\n");
  int i = 1;
  while i < lines.len {
    if colon := lines[i].index_of(":") {
      if colon > 0 {
        string key = lines[i][0:colon].trim().to_lower();
        if key == "content-length" {
          return _parse_decimal(lines[i][colon + 1:].trim());
        }
      }
    }
    i = i + 1;
  }
  return 0;
}

// _read_request frames exactly one request off the connection. `pending` is the
// keep-alive carry-over buffer: on entry it holds bytes already read past the
// previous request's body, and on return it holds the bytes read past this
// request's body. Without it a second request on a persistent connection could
// not be framed, because a single read can straddle the boundary between two
// pipelined requests.
_read_request!(net.TcpStream ~conn, u8[] ~pending) ServerRequest {
  u8[] raw = u8[]();
  int carried = 0;
  while carried < pending.len {
    raw.push(pending[carried]);
    carried = carried + 1;
  }

  u8[] read_buf = u8[].filled(0, 4096);
  int header_end = -1;
  int scan = 0;

  // Read until we find \r\n\r\n (end of headers). The scan runs before the
  // read so a request already fully present in `pending` is framed without
  // touching the socket.
  while header_end < 0 {
    while scan + 3 < raw.len {
      if raw[scan] == 13 && raw[scan + 1] == 10 && raw[scan + 2] == 13 && raw[scan + 3] == 10 {
        header_end = scan;
        break;
      }
      scan = scan + 1;
    }
    if header_end >= 0 {
      break;
    }
    int n = conn.read(read_buf)?^;
    if n == 0 {
      raise HttpError(code: 0, message: "connection closed before headers complete");
    }
    int i = 0;
    while i < n {
      raw.push(read_buf[i]);
      i = i + 1;
    }
  }

  string header_text = string.from_bytes(raw[0:header_end]);
  int content_length = _find_content_length(header_text);

  // Read remaining body bytes if needed
  int body_start = header_end + 4;
  int body_have = raw.len - body_start;
  while body_have < content_length {
    int n = conn.read(read_buf)?^;
    if n == 0 {
      break;
    }
    int i = 0;
    while i < n {
      raw.push(read_buf[i]);
      i = i + 1;
    }
    body_have = raw.len - body_start;
  }

  string body_str = "";
  int body_end = body_start;
  if content_length > 0 && raw.len > body_start {
    body_end = body_start + content_length;
    if body_end > raw.len {
      body_end = raw.len;
    }
    body_str = string.from_bytes(raw[body_start: body_end]);
  }

  // Hand whatever we read past this request's body to the next one.
  while pending.len > 0 {
    pending.remove(pending.len - 1);
  }
  int tail = body_end;
  while tail < raw.len {
    pending.push(raw[tail]);
    tail = tail + 1;
  }

  return _parse_request(header_text, move body_str)?^;
}

_parse_request!(string header_text, string move body_str) ServerRequest {
  string[] lines = header_text.split("\r\n");
  if lines.len == 0 {
    raise HttpError(code: 0, message: "empty HTTP request");
  }

  // Parse request line: "GET /path?query HTTP/1.1"
  string request_line = lines[0];
  int sp1 = -1;
  if s := request_line.index_of(" ") {
    sp1 = s;
  }
  if sp1 < 0 {
    raise HttpError(code: 0, message: "malformed HTTP request line");
  }
  string method_str = request_line[0:sp1];
  string after_method = request_line[sp1 + 1:];

  int sp2 = -1;
  if s := after_method.index_of(" ") {
    sp2 = s;
  }
  if sp2 < 0 {
    raise HttpError(code: 0, message: "malformed HTTP request line");
  }
  string uri = after_method[0:sp2];
  bool http11 = after_method[sp2 + 1:].trim().starts_with("HTTP/1.1");

  Method method = _string_to_method(method_str)?^;

  // Split URI into path and query at '?'
  string path_val = "";
  string query_val = "";
  if q := uri.index_of("?") {
    path_val = uri[0:q];
    query_val = uri[q + 1:];
  } else {
    path_val = uri;
  }

  // Parse headers (lowercase keys)
  map[string, string] hdrs = map[string, string]();
  int i = 1;
  while i < lines.len {
    if colon := lines[i].index_of(":") {
      if colon > 0 {
        string key = lines[i][0:colon].trim().to_lower();
        string value = lines[i][colon + 1:].trim();
        hdrs[key] = value;
      }
    }
    i = i + 1;
  }

  return ServerRequest(_method: move method, _path: move path_val, _query: move query_val, _headers: move hdrs, _body: move body_str, _http11: http11);
}

// _serialize_response renders a response onto the wire. The server owns
// connection framing, so a handler-set Content-Length, Connection or
// Transfer-Encoding header is dropped in favour of the computed one: a
// duplicate desynchronizes a persistent connection, and a Transfer-Encoding
// outranks Content-Length at the client, which would make it read an unchunked
// body as chunked. A HEAD reply keeps its Content-Length header but carries no
// body bytes.
_serialize_response(ServerResponse ~resp, bool keep_alive, bool head_request) string {
  Builder buf = Builder();
  buf.write_string("HTTP/1.1 ");
  buf.write_string(resp.status.to_string());
  buf.write_string(" ");
  buf.write_string(_status_text(resp.status));
  buf.write_string("\r\n");

  for key, value in resp.headers {
    string lower = key.to_lower();
    if lower != "connection" && lower != "content-length" && lower != "transfer-encoding" {
      buf.write_string(key);
      buf.write_string(": ");
      buf.write_string(value);
      buf.write_string("\r\n");
    }
  }

  buf.write_string("Content-Length: ");
  buf.write_string(resp.body.len.to_string());
  buf.write_string("\r\n");
  if keep_alive {
    buf.write_string("Connection: keep-alive\r\n");
  } else {
    buf.write_string("Connection: close\r\n");
  }
  buf.write_string("\r\n");
  if !head_request {
    buf.write_string(resp.body);
  }

  return buf.to_string();
}

// A request body announced with Transfer-Encoding cannot be framed by the
// server (only Content-Length is understood), so the byte stream after it is
// not trustworthy and the connection cannot be reused.
_has_transfer_encoding(ServerRequest request) bool {
  if te := request.header("transfer-encoding") {
    return te.trim().len > 0;
  }
  return false;
}

// _request_keep_alive mirrors the client-side rule in _exchange: the connection
// survives only when the request body was definitively framed AND HTTP
// semantics allow reuse — under HTTP/1.1 that is the default unless the client
// said Connection: close, under HTTP/1.0 it needs an explicit
// Connection: keep-alive.
_request_keep_alive(ServerRequest request) bool {
  if _has_transfer_encoding(request) {
    return false;
  }
  bool conn_close = false;
  bool conn_keepalive = false;
  if c := request.header("connection") {
    string lower = c.to_lower();
    conn_close = lower.contains("close");
    conn_keepalive = lower.contains("keep-alive");
  }
  if request._http11 {
    return !conn_close;
  }
  return conn_keepalive;
}

// _drain_slots re-acquires every semaphore slot. Holding all `limit` of them
// proves each spawned connection goroutine released its slot, so no connection
// work is in flight once this returns.
_drain_slots(channel[bool] sem, int limit) {
  int held = 0;
  while held < limit {
    sem.send(true);
    held = held + 1;
  }
}

// _serve_connection serves every request on one accepted connection, keeping
// the socket open between requests for as long as keep-alive semantics and
// max_requests allow, then closes it exactly once. It runs on its own goroutine
// (one per connection), so a slow handler never blocks the accept loop.
_serve_connection[H: Handler](net.TcpStream ~conn, Ref[H] handler, int max_requests) {
  _serve_requests[H](conn, handler, max_requests);
  _graceful_close(conn);
}

// _serve_requests is the keep-alive request loop. It is split out of
// _serve_connection so its exit paths can `return` — an error handler feeding
// an assignment must diverge — while the connection is still closed once, by
// the caller.
_serve_requests[H: Handler](net.TcpStream ~conn, Ref[H] handler, int max_requests) {
  u8[] pending = u8[]();
  int served = 0;
  while served < max_requests {
    ServerRequest request = _read_request(conn, pending)? e {
      // An idle keep-alive close or the shutdown wake connection: no response
      // is owed. T1670: a malformed request lands here too and should get a
      // 400 rather than a silent close.
      return;
    };
    served = served + 1;
    bool head = _is_head(request.method);

    if _has_transfer_encoding(request) {
      // The body cannot be framed, so nothing after it can be trusted.
      ServerResponse len_required = ServerResponse.with_status(411, "Length Required");
      string len_str = _serialize_response(len_required, false, head);
      u8[] len_data = len_str.bytes();
      _write_all(conn, len_data)? we {
        // Best effort: the connection is being closed either way, so a failed
        // write has nowhere left to be reported.
      };
      return;
    }

    // Decided before dispatch so the handler cannot influence framing.
    bool keep = _request_keep_alive(request) && served < max_requests;

    ServerResponse resp = handler.borrow.handle(request)? e {
      ServerResponse err_resp = ServerResponse.internal_error(move e.message);
      string err_str = _serialize_response(err_resp, false, head);
      u8[] err_data = err_str.bytes();
      _write_all(conn, err_data)? we {
        // Best effort: the connection is being closed either way, so a failed
        // write has nowhere left to be reported.
      };
      return;
    };

    string resp_str = _serialize_response(resp, keep, head);
    u8[] resp_data = resp_str.bytes();
    _write_all(conn, resp_data)? we {
      return;
    };
    if !keep {
      return;
    }
  }
}
