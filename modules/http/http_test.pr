// Content-Length framing: the client must read exactly Content-Length body
// bytes and stop, NOT block to EOF. This server sends a valid Content-Length: 5
// response followed by extra trailing bytes and keeps the socket open before
// closing. A read-to-EOF client would fold "TRAILING-JUNK" into the body (and
// block until close); a length-aware client returns "hello" immediately.
test_client_stops_at_content_length() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Response resp = http_get("http://127.0.0.1:" + port.to_string() + "/")?!;
    assert(resp.status == 200, "status 200");
    assert(resp.body == "hello", "body is exactly Content-Length bytes");
    assert(resp.body.len == 5, "trailing bytes excluded from body");
  };

  net.TcpStream conn = listener.accept()?!;
  u8[] buf = u8[].filled(0, 8192);
  conn.read(buf)?!;
  // Valid 5-byte body, then extra trailing bytes the client must ignore. Keep
  // the socket open briefly to prove the client returns without waiting for EOF.
  u8[] resp_data = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhelloTRAILING-JUNK".bytes();
  _write_all(conn, resp_data)?!;
  sleep(Duration.from_millis(50));
  conn.close()?!;
  listener.close()?!;
  sleep(Duration.from_millis(50));
}

// ============================================================
// T0447 — Client: gzip decoding, redirects, keep-alive, pooling
// ============================================================

// _serve_n accepts and serves `responses.len` connections in order (one request
// each, Connection: close), returning the raw request text of each.
_serve_n!(net.TcpListener ~listener, string[] responses) string[] {
  string[] requests = string[]();
  int i = 0;
  while i < responses.len {
    net.TcpStream conn = listener.accept()?^;
    u8[] buf = u8[].filled(0, 8192);
    int n = conn.read(buf)?^;
    requests.push(string.from_bytes(buf[0:n]));
    u8[] resp_data = responses[i].bytes();
    _write_all(conn, resp_data)?^;
    _graceful_close(conn);
    i = i + 1;
  }
  return requests;
}

// _serve_keepalive accepts ONE connection and serves two requests on it, proving
// the client reused the socket (a second accept is never issued).
_serve_keepalive!(net.TcpListener ~listener, string resp1, string resp2) {
  net.TcpStream conn = listener.accept()?^;
  u8[] buf = u8[].filled(0, 8192);
  conn.read(buf)?^;
  _write_all(conn, resp1.bytes())?^;
  u8[] buf2 = u8[].filled(0, 8192);
  conn.read(buf2)?^;
  _write_all(conn, resp2.bytes())?^;
  _graceful_close(conn);
}

// _serve_stale serves the first request keep-alive then closes the socket
// (making the pooled connection stale), then accepts a fresh connection for the
// client's stale-connection retry.
_serve_stale!(net.TcpListener ~listener, string resp1, string resp2) {
  net.TcpStream conn1 = listener.accept()?^;
  u8[] buf = u8[].filled(0, 8192);
  conn1.read(buf)?^;
  _write_all(conn1, resp1.bytes())?^;
  conn1.close()?^;
  net.TcpStream conn2 = listener.accept()?^;
  u8[] buf2 = u8[].filled(0, 8192);
  conn2.read(buf2)?^;
  _write_all(conn2, resp2.bytes())?^;
  _graceful_close(conn2);
}

// --- Unit tests (no network) ---

test_resolve_url_absolute() `test(exclude: wasm) {
  _Url base = _parse_url("http://example.com/a/b")?!;
  string r = _resolve_url(base, "http://other.com/x")?!;
  assert(r == "http://other.com/x", "absolute URL used directly");
}

test_resolve_url_absolute_path() `test(exclude: wasm) {
  _Url base = _parse_url("http://example.com:8080/a/b")?!;
  string r = _resolve_url(base, "/new")?!;
  assert(r == "http://example.com:8080/new", "absolute-path keeps host:port");
}

test_resolve_url_scheme_relative() `test(exclude: wasm) {
  _Url base = _parse_url("http://example.com/a")?!;
  string r = _resolve_url(base, "//cdn.example.com/x")?!;
  assert(r == "http://cdn.example.com/x", "scheme-relative inherits http");
}

test_resolve_url_relative_path() `test(exclude: wasm) {
  _Url base = _parse_url("http://example.com/a/b/c")?!;
  string r = _resolve_url(base, "d")?!;
  assert(r == "http://example.com/a/b/d", "relative path joins against base dir");
}

test_resolve_url_relative_strips_query() `test(exclude: wasm) {
  _Url base = _parse_url("http://example.com/a/b?x=1")?!;
  string r = _resolve_url(base, "d")?!;
  assert(r == "http://example.com/a/d", "relative join uses base dir, drops query");
}

test_resolve_url_https_error() `test(exclude: wasm) {
  _Url base = _parse_url("http://example.com/")?!;
  string r = _resolve_url(base, "https://secure.example.com/")? e {
    return; // expected: https not supported yet
  };
  assert(false, "https redirect target should raise");
}

test_is_redirect_classifier() `test(exclude: wasm) {
  assert(_is_redirect(301), "301");
  assert(_is_redirect(302), "302");
  assert(_is_redirect(303), "303");
  assert(_is_redirect(307), "307");
  assert(_is_redirect(308), "308");
  assert(!_is_redirect(200), "200 not redirect");
  assert(!_is_redirect(300), "300 not followed");
  assert(!_is_redirect(304), "304 not followed");
  assert(!_is_redirect(404), "404 not redirect");
}

test_method_helpers() `test(exclude: wasm) {
  assert(_is_head(Method.Head), "Head is head");
  assert(!_is_head(Method.Get), "Get is not head");
  assert(_is_get_or_head(Method.Get), "Get is get-or-head");
  assert(_is_get_or_head(Method.Head), "Head is get-or-head");
  assert(!_is_get_or_head(Method.Post), "Post is not get-or-head");
  assert(_method_to_string(_method_clone(Method.Post)) == "POST", "clone Post");
  assert(_method_to_string(_method_get()) == "GET", "method_get is GET");
}

// --- gzip response decoding ---

test_client_gzip_decode() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
    Response resp = c.send(Request.new_get("http://127.0.0.1:" + port.to_string() + "/"))?!;
    assert(resp.status == 200, "status 200");
    assert(resp.body == "hello gzip world", "gzip body decoded");
  };

  net.TcpStream conn = listener.accept()?!;
  u8[] buf = u8[].filled(0, 8192);
  int n = conn.read(buf)?!;
  string request = string.from_bytes(buf[0:n]);
  assert(request.contains("Accept-Encoding: gzip"), "client advertised gzip");

  u8[] gz = gzip.gzip_encode("hello gzip world".bytes());
  Builder hb = Builder();
  hb.write_string("HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nContent-Length: ");
  hb.write_string(gz.len.to_string());
  hb.write_string("\r\nConnection: close\r\n\r\n");
  u8[] resp_data = hb.to_string().bytes();
  int j = 0;
  while j < gz.len {
    resp_data.push(gz[j]);
    j = j + 1;
  }
  _write_all(conn, resp_data)?!;
  _graceful_close(conn);
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

// --- redirect following ---

test_client_redirect_302_relative() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
    Response resp = c.send(Request.new_get("http://127.0.0.1:" + port.to_string() + "/old"))?!;
    assert(resp.status == 200, "final status 200");
    assert(resp.body == "arrived", "final body");
  };

  string[] responses = string[]();
  responses.push("HTTP/1.1 302 Found\r\nLocation: /new\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  responses.push("HTTP/1.1 200 OK\r\nContent-Length: 7\r\nConnection: close\r\n\r\narrived");
  string[] requests = _serve_n(listener, responses)?!;
  assert(requests.len == 2, "two requests served");
  assert(requests[0].contains("GET /old"), "first request GET /old");
  assert(requests[1].contains("GET /new"), "followed request GET /new");
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

test_client_redirect_301_post_becomes_get() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
    Response resp = c.send(Request.new_post("http://127.0.0.1:" + port.to_string() + "/submit", "payload"))?!;
    assert(resp.status == 200, "final status 200");
    assert(resp.body == "done", "final body");
  };

  string[] responses = string[]();
  responses.push("HTTP/1.1 301 Moved Permanently\r\nLocation: /elsewhere\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  responses.push("HTTP/1.1 200 OK\r\nContent-Length: 4\r\nConnection: close\r\n\r\ndone");
  string[] requests = _serve_n(listener, responses)?!;
  assert(requests[0].contains("POST /submit"), "first is POST");
  assert(requests[0].contains("payload"), "first carries body");
  assert(requests[1].contains("GET /elsewhere"), "301 rewrites POST to GET");
  assert(!requests[1].contains("payload"), "body dropped on rewrite");
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

test_client_redirect_307_preserves_method_body() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
    Response resp = c.send(Request.new_post("http://127.0.0.1:" + port.to_string() + "/a", "keepbody"))?!;
    assert(resp.status == 200, "final status 200");
  };

  string[] responses = string[]();
  responses.push("HTTP/1.1 307 Temporary Redirect\r\nLocation: /b\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  responses.push("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok");
  string[] requests = _serve_n(listener, responses)?!;
  assert(requests[1].contains("POST /b"), "307 preserves POST");
  assert(requests[1].contains("keepbody"), "307 preserves body");
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

test_client_redirect_303_becomes_get() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
