// --- parenthesized spellings -------------------------------------------------
//
// Both classifiers peel ParenExpr before deciding, so `(g)` must be recognized
// as the getter call it is. Each of these leaked before the fix.

test_paren_discard_drops_temp() `test {
  int i = 0;
  while i < 50 {
    (probe_dir);
    i = i + 1;
  }
  assert(true, "a parenthesized discarded getter must still drop");
}

test_double_paren_discard_drops_temp() `test {
  int i = 0;
  while i < 50 {
    ((probe_dir));
    i = i + 1;
  }
  assert(true, "the paren peel must be a loop, not a single unwrap");
}

test_paren_borrow_arg_drops_temp() `test {
  int i = 0;
  while i < 50 {
    _borrow_opt((probe_dir));
    i = i + 1;
  }
  assert(true, "a parenthesized borrow argument must still drop");
}

// A getter reachable by bare name because `std` is auto-imported (`use std as _`)
// must take the same path as a file-local one — neither leaking nor crashing.
test_std_getter_bare_reference() `test {
  int i = 0;
  while i < 50 {
    stdout;
    i = i + 1;
  }
  assert(true, "a bare std getter reference is a getter call like any other");
}

// --- inside a monomorphized generic body -------------------------------------
//
// When the borrow happens INSIDE a generic body the temp is registered and
// dropped under an active typeSubst, and once per instantiation. Both of these
// leaked two temps per iteration before the fix.

_sink_generic[T](T? v) `doc("Generic optional borrow sink.") {
}

_borrow_inside_generic[T](T? passthru) `doc("Borrows both its own param and a getter result.") {
  _sink_generic[T](passthru);
  _sink_generic[string](probe_dir);
}

test_borrow_inside_generic_body() `test {
  int i = 0;
  while i < 50 {
    _borrow_inside_generic[string](probe_dir);
    i = i + 1;
  }
  assert(true, "an optional temp created inside a monomorphized body must drop");
}

test_borrow_inside_generic_body_second_instantiation() `test {
  int i = 0;
  while i < 50 {
    _borrow_inside_generic[int[]](probe_vec);
    i = i + 1;
  }
  assert(true, "each instantiation drops its own temp under its own subst");
}

// The structural-view inner must still be USABLE before it is dropped — a
// premature free of the box would surface here rather than as a leak.
test_inner_view_is_live_before_drop() `test {
  int i = 0;
  int total = 0;
  while i < 50 {
    if v := inner_view {
      total = total + v.emit(1);
    }
    i = i + 1;
  }
  // emit(1) == 1 + "view-payload".len == 13.
  assert(total == 650, "each view must be live when called, got {total}");
}
