// T1387: a use-binding whose failable `close()` fails on the SUCCESS exit of a
// `go! {}` value body must surface the close error at `<-t` — instead of being
// silently dropped and the goroutine reporting {ok, value}. Symmetric to a
// failable function propagating a use-binding close error via its return
// (see tests/e2e/use_failable_close_test.pr).
//
// Each body carries an unrelated escape site (`produce(...)?^`) so the body is a
// failable scope even without the use-close escape — a workaround for T1386
// (body-can-fail detection misses use-close). The trailing expression is a plain
// binary expr (not a trailing if/match — see T1389).
// A resource whose failable close() always fails.
type CloseError is error {
  int code;
}

type FailResource {
  int id;

  close!(~this) void {
    raise CloseError(message: "close failed", code: 42);
  }
}

// A resource whose failable close() always succeeds.
type OkResource {
  int id;

  close!(~this) void {
    // success — no error
  }
}

// A failable helper providing the unrelated escape site (and success values).
produce!(int x) int {
  if x < 0 {
    raise error("neg:{x}");
  }
  return x * 2;
}

// A failable void helper (escape site for void-body cases).
do_effect!(int x) void {
  if x < 0 {
    raise error("effect:{x}");
  }
}

// A failable helper returning a heap (string) value.
make_str!(int x) string {
  if x < 0 {
    raise error("bad:{x}");
  }
  return "value={x}";
}

// A heap user type (non-`value` field layout) and a failable factory — exercises
// the divert-drop on a heap kind other than string/vector (T1427).
type Box {
  int v;
}

make_box!(int x) Box {
  if x < 0 {
    raise error("bad:{x}");
  }
  return Box(v: x);
}

// A failable helper returning a heap Vector value.
make_vec!(int x) int[] {
  if x < 0 {
    raise error("bad:{x}");
  }
  return[x, x + 1, x + 2];
}

// --- The repro: use-close error surfaces at `<-t` ---
gobang_use_close_error_surfaces() `test {
  t := go! {
    base := produce(1)?^; // succeeds; makes the body a failable scope
    use r := FailResource(id: 1); // close() raises on scope exit
    base + r.id
  };
  got := false;
  v := (<-t)? e {
    got = true;
    assert(e.message == "close failed", "surfaced error is the close error");
    -1
  };
  assert(got, "use-close error should surface at <-t");
  assert(v == -1, "handler recovery value returned");
}

// --- Successful close returns the trailing value ---
gobang_use_close_ok_returns_value() `test {
  t := go! {
    base := produce(2)?^; // base == 4
    use r := OkResource(id: 5); // close() succeeds
    base + r.id
  };
  v := (<-t)?!;
  assert(v == 9, "successful close returns the trailing value");
}

// --- Explicit-return exit + failing close: the close error surfaces (T1385/T1391) ---
// §17.2 explicit-return style routes through the same emitScopeCleanup +
// emitCloseErrCheck sequence as the bare-return and trailing-value exits, so a
// failing close on that exit must divert the already-computed return value and
// surface the close error instead — without leaking either.
gobang_use_close_explicit_return_surfaces() `test {
  t := go! {
    base := produce(1)?^; // succeeds; makes the body a failable scope
    use r := FailResource(id: 1); // close() raises on the explicit-return exit
    return base + r.id;
  };
  got := false;
  v := (<-t)? e {
    got = true;
    assert(e.message == "close failed", "explicit-return surfaced error is the close error");
    -1
  };
  assert(got, "explicit-return use-close error should surface at <-t");
  assert(v == -1, "handler recovery value returned");
}

// --- Explicit-return exit + OK close: the returned value surfaces (T1385) ---
gobang_use_close_explicit_return_ok_value() `test {
  t := go! {
    base := produce(2)?^; // base == 4
    use r := OkResource(id: 5); // close() succeeds
    return base + r.id;
  };
  v := (<-t)?!;
  assert(v == 9, "explicit-return value survives a successful close");
}

// --- Heap result + FAILING use-close divert: close error surfaces, leak-free (T1427) ---
// On a `go! {}` value exit the computed HEAP result is claimed away from temp
// cleanup for the store into G.result_ptr; a failing use-close diverts that exit
// (emitCloseErrCheck → emitFailableGoBlockError) and stores the {err} aggregate
// instead — so the divert path must drop the orphaned result or it leaks (T0067).
// Three shapes: trailing binary expr (fresh temp), trailing bare ident (moved-local,
// no temp record), and explicit `return` (§17.2 / T1385).
gobang_use_close_trailing_heap_diverted_leak_free() `test {
  t := go! {
    s := make_str(3)?^; // heap (string) result computed
    use r := FailResource(id: 1); // close() raises → the string is diverted
    s + "!"
  };
  got := false;
  (<-t)? e {
    got = true;
    assert(e.message == "close failed", "trailing heap divert surfaces the close error");
  };
  assert(got, "trailing heap-diverted use-close error surfaces at <-t");
}

gobang_use_close_trailing_heap_bareident_diverted_leak_free() `test {
  t := go! {
    s := make_str(4)?^; // heap (string) result; the trailing expr is a bare ident
    use r := FailResource(id: 1); // close() raises → the moved-local is diverted
    s
  };
  got := false;
  (<-t)? e {
    got = true;
    assert(e.message == "close failed", "bare-ident heap divert surfaces the close error");
  };
  assert(got, "bare-ident heap-diverted use-close error surfaces at <-t");
}

gobang_use_close_explicit_return_heap_diverted_leak_free() `test {
  t := go! {
    s := make_str(5)?^; // heap (string) result computed
    use r := FailResource(id: 1); // close() raises on the explicit-return exit
    return s + "!";
  };
  got := false;
  (<-t)? e {
    got = true;
    assert(e.message == "close failed", "explicit-return heap divert surfaces the close error");
  };
  assert(got, "explicit-return heap-diverted use-close error surfaces at <-t");
}

// Non-string heap kinds go through the same divert-drop (emitVariantFieldDrop),
// so cover a heap USER TYPE (trailing exit) and a heap VECTOR (explicit-return
// exit) to guard against a string-only drop path (T1427).
gobang_use_close_trailing_heap_usertype_diverted_leak_free() `test {
  t := go! {
    b := make_box(3)?^; // heap user-type result computed
    use r := FailResource(id: 1); // close() raises → the Box is diverted
    b
  };
  got := false;
  (<-t)? e {
    got = true;
    assert(e.message == "close failed", "user-type heap divert surfaces the close error");
  };
  assert(got, "user-type heap-diverted use-close error surfaces at <-t");
}

gobang_use_close_explicit_return_heap_vector_diverted_leak_free() `test {
  t := go! {
    v := make_vec(5)?^; // heap Vector result computed
    use r := FailResource(id: 1); // close() raises on the explicit-return exit
    return v;
  };
  got := false;
  (<-t)? e {
    got = true;
    assert(e.message == "close failed", "vector heap divert surfaces the close error");
  };
  assert(got, "vector heap-diverted use-close error surfaces at <-t");
}

// --- Explicit raise in the body suppresses the close error (original preserved) ---
gobang_use_close_raise_suppresses() `test {
  t := go! {
    base := produce(3)?^; // base == 6
    use r := FailResource(id: 1); // close() would raise on scope exit
    if base > 0 {
      raise error("body error"); // in-flight error suppresses the close error
    }
    base + r.id
  };
  got := false;
  v := (<-t)? e {
    got = true;
    assert(e.message == "body error", "original raise preserved, not the close error");
    0
  };
  assert(got, "in-flight raise handler ran");
}

// --- Multiple use bindings: first close error (LIFO) wins, surfaces at <-t ---
gobang_use_close_multiple_first_wins() `test {
  t := go! {
    base := produce(4)?^;
    use a := FailResource(id: 1); // closes second (LIFO) — error suppressed
    use b := FailResource(id: 2); // closes first — error captured
    base + a.id + b.id
  };
  got := false;
  (<-t)? e {
    got = true;
    assert(e.message == "close failed", "first close error (LIFO) surfaces");
  };
  assert(got, "multiple-close error handler ran");
}

// --- Void body (no trailing value): use-close error still surfaces at <-t ---
// The block ends on a `use` decl, so the task is void-failable. The close-error
// capture path must run at the void scope exit (not only when a trailing value
// is stored), routing the error into the void {ok,err} aggregate.
gobang_use_close_void_body() `test {
  t := go! {
    do_effect(1)?^; // escape site (succeeds); makes the body a failable scope
    use r := FailResource(id: 1); // close() raises on scope exit; no trailing value
  };
  got := false;
  (<-t)? e {
    got = true;
    assert(e.message == "close failed", "void-body use-close error surfaces");
  };
  assert(got, "void-body use-close error handler ran");
}

// --- Heap (string) trailing value + successful use-close: leak-free, value returned ---
// Exercises the success exit where the close capture flag is false: the trailing
// heap value is wrapped {ok, value} and its ownership transfers to the receiver.
gobang_use_close_ok_heap_value() `test {
  t := go! {
    s := make_str(3)?^;
    use r := OkResource(id: 1); // close() succeeds → trailing value surfaces
    s
  };
  v := (<-t)?!;
  assert(v == "value=3", "heap trailing value returned with ok close");
}

// --- Bare `return` early-exit: use-close error surfaces at <-t (T1391) ---
// A bare `return` inside a failable go! body is an early SUCCESS exit; a
// use-binding whose failable close() raises on that exit must route the close
// error into the task's {ok,err} aggregate (surfacing at <-t) and must not leak
// the captured error instance.
// T1385/§17.2: a bare `return;` is only legal on a non-value path, so these
// bodies are `failable_task[Void]`. The bare-return close-error routing is
// unchanged — it is the exit, not the result type, that this covers.
gobang_use_close_bare_return_surfaces() `test {
  t := go! {
    base := produce(1)?^; // succeeds; makes the body a failable scope
    use r := FailResource(id: 1); // close() raises on the bare-return exit
    if base > 0 {
      return; // bare return: r live + failing close
    }
    print_line((base + r.id).to_string());
  };
  got := false;
  (<-t)? e {
    got = true;
    assert(e.message == "close failed", "bare-return surfaced error is the close error");
  };
  assert(got, "bare-return use-close error should surface at <-t");
}

// --- Bare `return` + OK close: no spurious error at <-t (T1391/T1392) ---
// On the bare-return exit emitCloseErrCheck runs with a non-nil cap (T1387 guard),
// but a SUCCEEDING close leaves cap.val null, so the check falls through to the
// normal coroutineReturnBlock. T1392: that exit stores a DEFINED {ok, null}
// aggregate (previously it stored nothing → `<-t` read poison and, on wasm, mis-read
// the discriminant as an error and dereferenced a garbage error pointer).
gobang_use_close_bare_return_ok_no_surface() `test {
  t := go! {
    base := produce(1)?^; // succeeds; makes the body a failable scope
    use r := OkResource(id: 7); // close() succeeds on the bare-return exit
    if base > 0 {
      return;
    }
    print_line((base + r.id).to_string());
  };
  got := false;
  (<-t)? e {
    got = true;
  };
  assert(!got, "ok close on a bare return must not spuriously surface an error");
}

// --- Bare `return` + multiple use bindings: first close error (LIFO) wins (T1391) ---
// Mirrors gobang_use_close_multiple_first_wins but on the bare-return exit: the LIFO
// close order means the last-declared binding closes first and its error is captured;
// the earlier binding's close error is suppressed. Exercises the capture/suppress
// interplay of emitScopeCleanup+emitCloseErrCheck on the coroutineReturnBlock path.
gobang_use_close_bare_return_multi_first_wins() `test {
  t := go! {
    base := produce(4)?^;
    use a := FailResource(id: 1); // closes second (LIFO) — error suppressed
    use b := FailResource(id: 2); // closes first — error captured & routed
    if base > 0 {
      return;
    }
    print_line((base + a.id + b.id).to_string());
  };
  got := false;
  (<-t)? e {
    got = true;
    assert(e.message == "close failed", "first close error (LIFO) surfaces on bare return");
  };
  assert(got, "multi-close bare-return error handler ran");
}

// --- Bare `return` + un-received task: buffered close error freed on drop (T1391) ---
// The bare-return exit stores the captured close error into the task's {ok,err}
// aggregate; an un-received FailableTask must discharge that buffered error in its
// drop path (leak enforcement, T0067, fails the test otherwise). Sibling of
// gobang_use_close_dropped_error_leak_free but via the bare-return exit.
gobang_use_close_bare_return_dropped_leak_free() `test {
  {
    t := go! {
      base := produce(1)?^;
      use r := FailResource(id: 1); // close() raises → error buffered in the task
      if base > 0 {
        return;
      }
      print_line((base + r.id).to_string());
    };
    // never received — the buffered close error must be discharged on drop.
  }
  assert(true, "dropped bare-return use-close error path did not leak");
}

// --- Un-received task whose use-close FAILS: buffered error freed on drop ---
// The captured close error is stored into the task's {ok,err} aggregate; an
// un-received FailableTask must discharge that buffered error in its drop path
// (leak enforcement, T0067, fails the test otherwise).
gobang_use_close_dropped_error_leak_free() `test {
  {
    t := go! {
      base := produce(1)?^;
      use r := FailResource(id: 1); // close() raises → error buffered in the task
      base + r.id
    };
    // never received — the buffered close error must be discharged on drop.
  }
  assert(true, "dropped use-close error path did not leak");
}
