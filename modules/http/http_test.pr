}

test_client_redirect_cross_host_strips_auth() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener_a = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port_a = listener_a.local_port;
  net.TcpListener listener_b = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port_b = listener_b.local_port;

  go {
    Client c = Client.create();
    Request req = Request.new_get("http://127.0.0.1:" + port_a.to_string() + "/");
    req.set_header("Authorization", "Bearer secret");
    Response resp = c.send(move req)?!;
    assert(resp.status == 200, "final status 200");
  };

  // Server A redirects cross-host to B.
  string[] resp_a = string[]();
  resp_a.push("HTTP/1.1 302 Found\r\nLocation: http://127.0.0.1:" + port_b.to_string() + "/\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  string[] req_a = _serve_n(listener_a, resp_a)?!;
  assert(req_a[0].contains("Authorization: Bearer secret"), "auth sent to original host");

  // Server B must not receive the Authorization header.
  string[] resp_b = string[]();
  resp_b.push("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok");
  string[] req_b = _serve_n(listener_b, resp_b)?!;
  assert(!req_b[0].contains("Authorization"), "auth stripped on cross-host redirect");

  listener_a.close()?!;
  listener_b.close()?!;
  sleep(Duration.from_millis(100));
}

test_client_max_redirects_exceeded() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create(max_redirects: 2);
    Response resp = c.send(Request.new_get("http://127.0.0.1:" + port.to_string() + "/loop"))? e {
      return; // expected: too many redirects
    };
    assert(false, "should raise too many redirects");
  };

  // max_redirects=2 → the client sends 3 requests (hops 0,1,2) before raising.
  string[] responses = string[]();
  responses.push("HTTP/1.1 302 Found\r\nLocation: /loop\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  responses.push("HTTP/1.1 302 Found\r\nLocation: /loop\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  responses.push("HTTP/1.1 302 Found\r\nLocation: /loop\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  string[] requests = _serve_n(listener, responses)?!;
  assert(requests.len == 3, "three requests before raising");
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

// --- keep-alive connection reuse ---

test_client_keepalive_reuse() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
    Response r1 = c.get("http://127.0.0.1:" + port.to_string() + "/a")?!;
    assert(r1.body == "first", "first body");
    Response r2 = c.get("http://127.0.0.1:" + port.to_string() + "/b")?!;
    assert(r2.body == "second", "second body reused connection");
  };

  // Both responses served on ONE accepted connection — a second connection is
  // never accepted, so the test only completes if the client reused the socket.
  _serve_keepalive(listener,
  "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\nfirst",
  "HTTP/1.1 200 OK\r\nContent-Length: 6\r\nConnection: keep-alive\r\n\r\nsecond")?!;
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

// --- stale pooled connection retry ---

test_client_stale_connection_retry() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  go {
    Client c = Client.create();
    Response r1 = c.get("http://127.0.0.1:" + port.to_string() + "/a")?!;
    assert(r1.body == "first", "first body");
    sleep(Duration.from_millis(80)); // let the server close the pooled socket
    Response r2 = c.get("http://127.0.0.1:" + port.to_string() + "/b")?!;
    assert(r2.body == "second", "second body after fresh retry");
  };

  _serve_stale(listener,
  "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\nfirst",
  "HTTP/1.1 200 OK\r\nContent-Length: 6\r\nConnection: close\r\n\r\nsecond")?!;
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

