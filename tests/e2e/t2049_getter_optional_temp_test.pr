test_control_plain_getter_borrow() `test {
  int i = 0;
  while i < 50 {
    _borrow_plain(probe_plain);
    i = i + 1;
  }
  assert(true, "the non-optional borrow must stay clean");
}

// A local shadowing a getter name is a variable, not a call — it must keep its
// own drop binding and must not be reclassified as a fresh owned temp.
test_control_local_shadows_getter_name() `test {
  int i = 0;
  while i < 50 {
    string? probe_dir = "shadow" + "-payload";
    _borrow_opt(probe_dir);
    i = i + 1;
  }
  assert(true, "a local shadowing a getter name stays a variable");
}

// --- control-flow paths where the drop must fire exactly once ----------------

_raise_on_opt!(string? v) bool `doc("Raises while the caller's optional temp is live.") {
  raise error(message: "boom");
}

// The error unwind (emitStmtTempCleanupForErrorPath) must drop the temp too —
// the statement is abandoned before its normal statement-end drain runs.
test_error_unwind_drops_temp() `test {
  int i = 0;
  while i < 50 {
    bool ok = _raise_on_opt(probe_dir)? {
      false
    };
    i = i + 1;
  }
  assert(true, "the error unwind must free the borrowed optional temp");
}

// A `return` mid-loop leaves the statement-end drain behind; the temp created on
// that iteration must still be freed by scope cleanup.
_early_return(int n) int `doc("Returns early while optional temps are in flight.") {
  int i = 0;
  while i < n {
    _borrow_opt(probe_dir);
    if i == 5 {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

test_early_return_drops_temp() `test {
  assert(_early_return(50) == 5, "early return out of a loop holding a temp");
}

// `continue` skips the rest of the body — the temp must not survive the back edge.
test_loop_continue_drops_temp() `test {
  int i = 0;
  while i < 50 {
    i = i + 1;
    if i % 2 == 0 {
      _borrow_opt(probe_dir);
      continue;
    }
    _borrow_opt(probe_dir);
  }
  assert(true, "both the continue and fallthrough paths must free their temp");
}

// Branch arms carry their own block-value temp floors (T1329).
test_if_arms_drop_temp() `test {
  int i = 0;
  while i < 50 {
    if i % 2 == 0 {
      _borrow_opt(probe_dir);
    } else {
      _borrow_vec(probe_vec);
    }
    i = i + 1;
  }
  assert(true, "each arm must free the temp it created");
}

type Counter `doc("Receiver for the method-call borrow paths.") {
  int n;
  bump(~this, string? v) `doc("Mutating receiver with an optional borrow param.") {
    this.n = this.n + 1;
  }
  peek(this, string? v) int `doc("Shared receiver with an optional borrow param.") {
    return this.n;
  }
}

// A method call routes through the same argument path as a free function.
test_method_borrow_drops_temp() `test {
  Counter c = Counter(n: 0);
  int i = 0;
  while i < 50 {
    c.bump(probe_dir);
    i = i + 1;
  }
  assert(c.n == 50, "mutating receiver with an optional getter arg");
}

test_shared_receiver_borrow_drops_temp() `test {
  Counter c = Counter(n: 7);
  int i = 0;
  while i < 50 {
    assert(c.peek(probe_dir) == 7, "shared receiver reads its own state");
    i = i + 1;
  }
}

_borrow_generic[T](T? v) `doc("Generic optional borrow parameter.") {
}

// A generic borrow param is substituted before the registration decision.
test_generic_borrow_drops_temp() `test {
  int i = 0;
  while i < 50 {
    _borrow_generic[string](probe_dir);
    i = i + 1;
  }
  assert(true, "a substituted generic optional param must free its temp");
}

// Two optional temps live simultaneously in one statement — both must be freed.
_borrow_two(string? a, string? b) `doc("Two optional borrow params.") {
}

test_two_live_temps() `test {
  int i = 0;
  while i < 50 {
    _borrow_two(probe_dir, probe_dir);
    i = i + 1;
  }
  assert(true, "both optional argument temps must be freed");
}

// --- the same classifier fix reaches the tuple (T1233) and array (T1466) paths -

get probe_tuple(string, int) `doc("Droppable tuple from a module-level getter.") {
  return ("tup" + "-payload", 1);
}

get probe_array string[2] `doc("Fixed array of heap strings from a getter.") {
  return["one" + "-payload", "two" + "-payload"];
}

_borrow_tuple((string, int) t) `doc("Borrows a droppable tuple.") {
}

_borrow_array(string[2] a) `doc("Borrows a fixed array of heap strings.") {
}

// tupleArgIsCallerOwnedTemp gates the T1233 tuple and T1466 array borrow-param
// registrations too, so correcting its IdentExpr case frees these as well — they
// leaked one tuple (and two array elements) per call before.
test_getter_tuple_borrow_drops_temp() `test {
  int i = 0;
  while i < 50 {
    _borrow_tuple(probe_tuple);
    i = i + 1;
  }
  assert(true, "a bare-getter tuple temp must be freed by the caller");
}

test_getter_array_borrow_drops_temp() `test {
  int i = 0;
  while i < 50 {
    _borrow_array(probe_array);
    i = i + 1;
  }
  assert(true, "a bare-getter fixed-array temp must be freed element-wise");
}

// Inside a goroutine body the temps belong to the coroutine frame, not the
// spawning statement (T0594 gives a coroutine body its own temp registries).
// Joining over the channel is the happens-before edge — never a sleep.
test_goroutine_body_drops_temp() `test {
  channel[int] done = channel[int](1);
  int i = 0;
  while i < 50 {
    go {
      _borrow_opt(probe_dir);
      done.send(1);
    };
    i = i + 1;
  }
  int got = 0;
  while got < 50 {
    <-done;
    got = got + 1;
  }
  assert(got == 50, "every goroutine ran and freed its own optional temp");
}

// --- the inner-kind matrix -------------------------------------------------
//
// emitOptionalTempDrop hands the `{i1, T}` aggregate to emitOptionalValueDrop,
// which dispatches on the inner kind. The borrow-argument path must therefore
// free EVERY droppable inner it can be handed, not just the string/vector/
// heap-user shapes the original repro used. Each of these leaked before the fix.

type Emitter `structural `doc("Structural interface for the boxed-view inner.") {
  emit(this, int x) int `abstract;
}

type HeavyEmitter `doc("Heap implementer — its box must be freed via RTTI drop.") {
  string tag;
  emit(this, int x) int {
    return x + this.tag.len;
  }
}

enum Parcel `doc("Enum with a heap payload, to exercise the enum inner.") {
  Text(string s),
  Num(int n),
}

_answer() int `doc("Trivial goroutine body for the task inner.") {
  return 3;
}

get inner_nested string?? `doc("Nested optional inner (T??).") {
  string? inner = "n" + "ested-payload";
  return inner;
}
get inner_tuple(string, int)? `doc("Droppable tuple inner.") {
  return ("tup" + "le-payload", 1);
}
get inner_array string[2]? `doc("Fixed array of heap strings inner.") {
  return["arr" + "-one", "arr" + "-two"];
}
get inner_closure(() -> int)? `doc("Closure inner — owns a heap env.") {
  int captured = 7;
  return || -> captured;
}
get inner_enum Parcel? `doc("Droppable enum inner.") {
  return Parcel.Text(s: "par" + "cel-payload");
}
get inner_channel channel[int]? `doc("Channel inner.") {
  return channel[int](1);
}
get inner_ref Ref[int]? `doc("Ref inner — refcounted.") {
  return Ref[int](5);
}
get inner_weak Weak[int]? `doc("Weak inner — refcounted.") {
  Ref[int] strong = Ref[int](5);
  return strong.downgrade();
}
get inner_mutex Mutex[int]? `doc("Mutex inner — single-owner handle.") {
  return Mutex[int](5);
}
get inner_task task[int]? `doc("Task inner — a G struct plus result buffer.") {
  return go _answer();
}
get inner_view Emitter? `doc("Structural-view inner — a heap box.") {
  return HeavyEmitter(tag: "vi" + "ew-payload");
}

_borrow_nested(string?? v) `doc("Borrows a nested optional.") {
}
_borrow_tuple_inner((string, int)? v) `doc("Borrows an optional tuple.") {
}
_borrow_array_inner(string[2]? v) `doc("Borrows an optional fixed array.") {
}
_borrow_closure((() -> int)? v) `doc("Borrows an optional closure.") {
}
_borrow_enum(Parcel? v) `doc("Borrows an optional enum.") {
}
_borrow_channel(channel[int]? v) `doc("Borrows an optional channel.") {
}
_borrow_ref(Ref[int]? v) `doc("Borrows an optional Ref.") {
}
_borrow_weak(Weak[int]? v) `doc("Borrows an optional Weak.") {
}
_borrow_mutex(Mutex[int]? v) `doc("Borrows an optional Mutex.") {
}
_borrow_task(task[int]? v) `doc("Borrows an optional task handle.") {
}
_borrow_view(Emitter? v) `doc("Borrows an optional structural view.") {
}

test_inner_nested_borrow() `test {
