  assert(caught, "create on existing directory raises error");
  Dir.remove(os.temp_dir + "/pr_iot_cdir")?!;
}

file_exists_on_directory() `test(exclude: wasm) {
  // File.exists uses access(F_OK) — returns true for any path that exists,
  // including directories. Use os.temp_dir so the test is portable: a literal
  // "/tmp" resolves to the current drive's \tmp on Windows, which need not exist.
  assert(File.exists(os.temp_dir), "temp dir exists via File.exists");
  assert(Dir.exists(os.temp_dir), "temp dir exists via Dir.exists");
}

dir_exists_root() `test(exclude: wasm) {
  assert(Dir.exists("/"), "root directory exists");
}

file_exists_nonexistent() `test(exclude: wasm) {
  assert(!File.exists(os.temp_dir + "/pr_iot_never_exists_xyz"), "nonexistent path");
}

dir_exists_nonexistent() `test(exclude: wasm) {
  assert(!Dir.exists(os.temp_dir + "/pr_iot_never_exists_xyz"), "nonexistent dir");
}

file_write_readonly() `test(exclude: wasm) {
  File.write_content(os.temp_dir + "/pr_iot_wro", "data")?!;
  File f = File.open_read(os.temp_dir + "/pr_iot_wro")?!;
  bool caught = false;
  f.write_string("fail")? e {
    caught = true;
  };
  assert(caught, "writing to readonly file raises error");
  f.close()?!;
  File.remove(os.temp_dir + "/pr_iot_wro")?!;
}

file_open_write_overwrites_in_place() `test(exclude: wasm) {
  // open_write (O_WRONLY) overwrites from the start without truncating: the
  // trailing bytes beyond what we write must survive (unlike create).
  File.write_content(os.temp_dir + "/pr_iot_ow", "ABCDEFGH")?!;
  File f = File.open_write(os.temp_dir + "/pr_iot_ow")?!;
  f.write_string("xyz")?!;
  f.close()?!;
  string data = File.read_content(os.temp_dir + "/pr_iot_ow")?!;
  assert(data == "xyzDEFGH", "open_write overwrites in place, does not truncate");
  File.remove(os.temp_dir + "/pr_iot_ow")?!;
}

file_open_write_missing_raises() `test(exclude: wasm) {
  // O_WRONLY without O_CREAT: opening a nonexistent path must fail (ENOENT).
  bool caught = false;
  File.open_write(os.temp_dir + "/pr_iot_ow_missing_xyz")? e {
    caught = true;
  };
  assert(caught, "open_write on missing file raises error");
}

file_open_write_read_raises() `test(exclude: wasm) {
  // A write-only handle cannot be read from; the read raises (EBADF).
  File.write_content(os.temp_dir + "/pr_iot_owr", "data")?!;
  File f = File.open_write(os.temp_dir + "/pr_iot_owr")?!;
  bool caught = false;
  f.read_all()? e {
    caught = true;
  };
  assert(caught, "reading from write-only handle raises error");
  f.close()?!;
  File.remove(os.temp_dir + "/pr_iot_owr")?!;
}

file_create_handle_read_raises() `test(exclude: wasm) {
  // T1275 narrowed create to O_WRONLY|O_CREAT|O_TRUNC: the returned handle is
  // write-only, so reading from it must raise (EBADF). Guards the mode-5
  // narrowing — if create ever regressed to O_RDWR this read would succeed.
  File f = File.create(os.temp_dir + "/pr_iot_crd")?!;
  f.write_string("payload")?!;
  f.seek(0)?!;
  bool caught = false;
  f.read_all()? e {
    caught = true;
  };
  assert(caught, "reading from create handle raises error");
  f.close()?!;
  File.remove(os.temp_dir + "/pr_iot_crd")?!;
}

file_append_handle_read_raises() `test(exclude: wasm) {
  // T1275 narrowed append to O_WRONLY|O_CREAT|O_APPEND: the returned handle is
  // write-only, so reading from it must raise (EBADF). Guards the mode-6
  // narrowing — if append ever regressed to O_RDWR this read would succeed.
  File.write_content(os.temp_dir + "/pr_iot_ard", "existing")?!;
  File f = File.append(os.temp_dir + "/pr_iot_ard")?!;
  f.seek(0)?!;
  bool caught = false;
  f.read_all()? e {
    caught = true;
  };
  assert(caught, "reading from append handle raises error");
  f.close()?!;
  File.remove(os.temp_dir + "/pr_iot_ard")?!;
}

file_append_creates_missing() `test(exclude: wasm) {
  // append carries O_CREAT (mode 6): opening a nonexistent path creates it
  // rather than raising, then writes land at the end.
  File.remove(os.temp_dir + "/pr_iot_acm")? _ {
  };
  File f = File.append(os.temp_dir + "/pr_iot_acm")?!;
  f.write_string("fresh")?!;
  f.close()?!;
  string d = File.read_content(os.temp_dir + "/pr_iot_acm")?!;
  assert(d == "fresh", "append creates a missing file");
  File.remove(os.temp_dir + "/pr_iot_acm")?!;
}

// T1742: an append handle must write at the end regardless of the file position.
// Windows has no CreateFile access right that means O_APPEND — the PAL gets the
// behaviour from _open_osfhandle(handle, _O_APPEND), which sets the CRT
// descriptor's FAPPEND bit so _write seeks to end before every write. This test
// is the reason FILE_APPEND_DATA was rejected as an alternative: seeking on an
// append handle stays legal, and the seek must simply not affect where the bytes
// land. Without FAPPEND the write below would overwrite from offset 0.
file_append_ignores_seek() `test(exclude: wasm) {
  string p = os.temp_dir + "/pr_iot_apsk";
  File.write_content(p, "AAAA")?!;
  File f = File.append(p)?!;
  f.seek(0)?!; // legal on an append handle, and deliberately ignored by the write
  f.write_string("BB")?!;
  f.close()?!;
  assert(File.read_content(p)?! == "AAAABB", "append writes at end after seek(0)");
  File.remove(p)?!;
}

// T1742: repeated writes through one append handle each land at the end — the
// FAPPEND seek happens per write, not once at open.
file_append_repeated_writes() `test(exclude: wasm) {
  string p = os.temp_dir + "/pr_iot_aprw";
  File.write_content(p, "0")?!;
  File f = File.append(p)?!;
  f.write_string("1")?!;
  f.write_string("2")?!;
  f.write_string("3")?!;
  f.close()?!;
  assert(File.read_content(p)?! == "0123", "each append write lands at the end");
  File.remove(p)?!;
}

// T1742: a second append handle opened while the first is still open must also
// start at the end. Two write handles on one path is only possible at all
// because the share mode allows it.
file_append_two_handles() `test(exclude: wasm) {
  string p = os.temp_dir + "/pr_iot_apth";
  File.write_content(p, "x")?!;
  File a = File.append(p)?!;
  a.write_string("y")?!;
  File b = File.append(p)?!; // opened after "y" is on disk
  b.write_string("z")?!;
  b.close()?!;
  a.close()?!;
  assert(File.read_content(p)?! == "xyz", "a second append handle starts at the end");
  File.remove(p)?!;
}

// T1742: File.size now routes through pal_file_open (read-only) instead of a raw
// CRT open, so it must still work while another handle holds the file. A
// deny-delete/deny-share open here would fail with a sharing violation.
file_size_while_open() `test(exclude: wasm) {
  string p = os.temp_dir + "/pr_iot_szwo";
  File w = File.create(p)?!;
  w.write_string("12345")?!;
  assert(File.size(p)?! == 5, "size readable while a write handle is open");
  w.write_string("67")?!;
  assert(File.size(p)?! == 7, "size reflects later writes on the open handle");
  w.close()?!;
  assert(File.size(p)?! == 7, "size unchanged after close");
  File.remove(p)?!;
}

// T1742: File.size's failure path returns pal_file_open's -errno sign-extended
// to 64 bits rather than re-reading errno. Asserting the code (not just that it
// raised) is what catches a bad widening — a zero-extend turns -2 into
// 4294967294, which surfaces as a nonsense IoError code instead of ENOENT.
file_size_nonexistent_code() `test(exclude: wasm) {
  bool caught = false;
  File.size(os.temp_dir + "/pr_iot_szne_code")? e is IoError {
    caught = true;
    assert(e.code == 2, "File.size on a missing path reports ENOENT(2)");
    assert(e.message == "no such file or directory", "ENOENT message");
  }!;
  assert(caught, "size of nonexistent raises");
}

// T1742: a path whose *parent directory* does not exist. Windows reports this as
// ERROR_PATH_NOT_FOUND(3) rather than ERROR_FILE_NOT_FOUND(2), so it exercises a
// distinct arm of the Win32 → errno table; POSIX reports ENOENT directly. Both
// must reach Promise as the same code.
file_open_missing_parent_directory() `test(exclude: wasm) {
  string p = os.temp_dir + "/pr_iot_no_such_dir_xyz/inner.txt";
  bool caught = false;
  File.open_read(p)? e is IoError {
    caught = true;
    assert(e.code == 2, "missing parent directory reports ENOENT(2)");
  }!;
  assert(caught, "opening under a missing directory raises");

  // Same path through create (mode 5): CREATE_ALWAYS still cannot invent the
  // parent, so it must fail the same way rather than succeed.
  bool caught_create = false;
  File.create(p)? e is IoError {
    caught_create = true;
    assert(e.code == 2, "create under a missing directory reports ENOENT(2)");
  }!;
  assert(caught_create, "create under a missing directory raises");
}

// T1742: a write handle and a read handle on one path coexist, and bytes written
// through the first are visible to the second. FILE_SHARE_READ|WRITE is what
// makes the second open legal at all; the PAL passes it on every mode.
file_two_handles_share_reads_and_writes() `test(exclude: wasm) {
  string p = os.temp_dir + "/pr_iot_shrw";
  File.write_content(p, "")?!;
  File w = File.open_write(p)?!;
  w.write_string("shared")?!;
  File r = File.open_read(p)?!;
  string seen = r.read_all()?!;
  r.close()?!;
  w.close()?!;
  assert(seen == "shared", "a concurrent reader sees the writer's bytes");
  File.remove(p)?!;
}

// T1742 (windows-only): ERROR_ACCESS_DENIED(5) → EACCES(13) is the one arm of
// the Win32 → errno table other than ENOENT that Promise code can actually
// reach. CreateFileA refuses a directory unless FILE_FLAG_BACKUP_SEMANTICS is
// set, so every open mode lands on that arm here. Drop the arm and the code
// falls through to the EINVAL(22) default — "invalid argument" for a perfectly
// valid path, which sends the reader looking for a bug in their own code.
//
// Windows-only because POSIX reaches these paths differently: Linux lets you
// open a directory read-only and fails later, so the codes genuinely differ.
// file_open_directory and file_create_on_directory_path cover the
// cross-platform "it raises at all" half.
file_open_directory_errno_windows() `test(exclude: wasm) `target(windows) {
  string d = os.temp_dir;

  bool caught_read = false;
  File.open_read(d)? e is IoError {
    caught_read = true;
    assert(e.code == 13, "open_read on a directory reports EACCES(13), got {e.code}");
    assert(e.message == "permission denied", "EACCES message");
  }!;
  assert(caught_read, "open_read on a directory raises");

  bool caught_rw = false;
  File.open(d)? e is IoError {
    caught_rw = true;
    assert(e.code == 13, "open on a directory reports EACCES(13), got {e.code}");
  }!;
  assert(caught_rw, "open on a directory raises");

  bool caught_create = false;
  File.create(d)? e is IoError {
    caught_create = true;
    assert(e.code == 13, "create on a directory reports EACCES(13), got {e.code}");
  }!;
  assert(caught_create, "create on a directory raises");

  // File.size routes through pal_file_open and widens its -errno, so a failure
  // that is not ENOENT must survive the widening intact too.
  bool caught_size = false;
  File.size(d)? e is IoError {
    caught_size = true;
    assert(e.code == 13, "File.size on a directory reports EACCES(13), got {e.code}");
  }!;
  assert(caught_size, "File.size on a directory raises");
}

