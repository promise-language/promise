// Tests for static .rodata vector literals (T0062).
// Vectors with all compile-time constant elements are stored in .rodata
// instead of heap-allocating. Mutation triggers copy-on-write.
test_static_int_vector() `test {
  int[] v = [1, 2, 3];
  assert(v.len == 3, "len");
  assert(v[0] == 1, "v[0]");
  assert(v[1] == 2, "v[1]");
  assert(v[2] == 3, "v[2]");
}

test_static_float_vector() `test {
  f64[] v = [1.5, 2.5, 3.5];
  assert(v.len == 3, "len");
  assert(v[0] == 1.5, "v[0]");
  assert(v[1] == 2.5, "v[1]");
  assert(v[2] == 3.5, "v[2]");
}

test_static_bool_vector() `test {
  bool[] v = [true, false, true];
  assert(v.len == 3, "len");
  assert(v[0] == true, "v[0]");
  assert(v[1] == false, "v[1]");
  assert(v[2] == true, "v[2]");
}

test_static_char_vector() `test {
  char[] v = ['a', 'b', 'c'];
  assert(v.len == 3, "len");
  assert(v[0] == 'a', "v[0]");
  assert(v[1] == 'b', "v[1]");
  assert(v[2] == 'c', "v[2]");
}

test_static_negative_int_vector() `test {
  int[] v = [-1, -2, 0, 3];
  assert(v.len == 4, "len");
  assert(v[0] == -1, "v[0]");
  assert(v[1] == -2, "v[1]");
  assert(v[2] == 0, "v[2]");
  assert(v[3] == 3, "v[3]");
}

test_static_empty_vector() `test {
  int[] v = [];
  assert(v.len == 0, "empty len");
  v.push(42);
  assert(v.len == 1, "push len");
  assert(v[0] == 42, "v[0]");
}

test_cow_push() `test {
  int[] v = [10, 20, 30];
  v.push(40);
  assert(v.len == 4, "len");
  assert(v[0] == 10, "v[0]");
  assert(v[3] == 40, "v[3]");
}

test_cow_pop() `test {
  int[] v = [10, 20, 30];
  if p := v.pop() {
    assert(p == 30, "popped");
  }
  assert(v.len == 2, "len");
  assert(v[0] == 10, "v[0]");
  assert(v[1] == 20, "v[1]");
}

test_cow_remove() `test {
  int[] v = [10, 20, 30];
  v.remove(1);
  assert(v.len == 2, "len");
  assert(v[0] == 10, "v[0]");
  assert(v[1] == 30, "v[1]");
}

test_cow_index_assign() `test {
  int[] v = [1, 2, 3];
  v[0] = 99;
  assert(v[0] == 99, "v[0]");
  assert(v[1] == 2, "v[1]");
  assert(v[2] == 3, "v[2]");
}

test_cow_compound_assign() `test {
  int[] v = [10, 20, 30];
  v[1] = v[1] + 5;
  assert(v[1] == 25, "v[1]");
}

test_static_for_in() `test {
  int[] v = [1, 2, 3, 4, 5];
  int sum = 0;
  for x in v {
    sum = sum + x;
  }
  assert(sum == 15, "sum");
}

test_static_for_in_with_index() `test {
  int[] v = [10, 20, 30];
  int index_sum = 0;
  int val_sum = 0;
  for i, x in v {
    index_sum = index_sum + i;
    val_sum = val_sum + x;
  }
  assert(index_sum == 3, "index_sum");
  assert(val_sum == 60, "val_sum");
}

test_static_contains() `test {
  int[] v = [10, 20, 30];
  assert(v.contains(20), "contains 20");
  assert(!v.contains(99), "not contains 99");
}

test_cow_multiple_pushes() `test {
  int[] v = [1];
  v.push(2);
  v.push(3);
  v.push(4);
  v.push(5);
  assert(v.len == 5, "len");
  assert(v[4] == 5, "v[4]");
}

test_static_i32_vector() `test {
  i32[] v = [1i32, 2i32, 3i32];
  assert(v.len == 3, "len");
  assert(v[0] == 1i32, "v[0]");
  assert(v[2] == 3i32, "v[2]");
}

test_non_constant_elements() `test {
  int x = 42;
  int[] v = [x, x + 1];
  assert(v.len == 2, "len");
  assert(v[0] == 42, "v[0]");
  assert(v[1] == 43, "v[1]");
  v.push(44);
  assert(v.len == 3, "push len");
}

test_static_slice() `test {
  int[] v = [10, 20, 30, 40, 50];
  int[] s = v[1:4];
  assert(s.len == 3, "slice len");
  assert(s[0] == 20, "s[0]");
  assert(s[1] == 30, "s[1]");
  assert(s[2] == 40, "s[2]");
}

// The element folds below are shared with the scalar literal path (T1418
// unified them), so these also guard genIntLit/genFloatLit/genCharLit.

test_static_int_radix_and_underscores() `test {
  // The fold parses with base detection from the prefix, after stripping
  // underscores.
  int[] v = [0xff, 0o17, 0b1010, 1_000_000, -0xff];
  assert(v[0] == 255, "hex");
  assert(v[1] == 15, "octal");
  assert(v[2] == 10, "binary");
  assert(v[3] == 1000000, "underscores");
  assert(v[4] == -255, "negated hex");
}

test_static_narrow_int_extremes() `test {
  // Element values at the edge of each narrow width. u64.max does not fit in an
  // int64, so it exercises the same >int64.max fold path the wide types do,
  // just at a width where truncation happens to be a no-op.
  i8[] a = [-128i8, 127i8];
  assert(a[0] == i8.min && a[1] == i8.max, "i8 extremes");

  u8[] b = [0u8, 255u8];
  assert(b[0] == u8.min && b[1] == u8.max, "u8 extremes");

  i64[] c = [-9223372036854775808i64, 9223372036854775807i64];
  assert(c[0] == i64.min && c[1] == i64.max, "i64 extremes");

  u64[] d = [0u64, 18446744073709551615u64];
  assert(d[0] == u64.min && d[1] == u64.max, "u64 extremes");
  assert(d[1].to_string() == "18446744073709551615", "u64 max prints unsigned");
}

test_static_char_escapes() `test {
  // Every escape PromiseLexer.g4's CHAR_LITERAL admits, plus a multi-byte rune
  // (the utf8-decode branch of the fold).
  char[] v = ['\n', '\r', '\t', '\b', '\\', '\'', '\0', 'e'];
  assert(v.len == 8, "len");
  assert(v[0] == '\n', "newline");
  assert(v[1] == '\r', "carriage return");
  assert(v[2] == '\t', "tab");
  assert(v[3] == '\b', "backspace");
  assert(v[4] == '\\', "backslash");
  assert(v[5] == '\'', "quote");
  assert(v[6] == '\0', "nul");
  assert(v[7] == 'e', "plain");

  char[] wide = ['é', '€'];
  assert((wide[0] as int) == 233, "two-byte rune");
  assert((wide[1] as int) == 8364, "three-byte rune");
}

test_static_f32_vector() `test {
  // f32 elements are folded at single precision, so 0.1f32 must equal the
  // scalar 0.1f32 exactly rather than a truncated double.
  f32[] v = [0.1f32, -2.5f32, 0.0f32];
  assert(v[0] == 0.1f32, "f32 rounds like the scalar literal");
  assert(v[1] == -2.5f32, "negative f32");
  assert(v[2] == 0.0f32, "zero f32");
}

test_static_negative_float_vector() `test {
  f64[] v = [-1.5, 0.0, -0.5, 1_000.5];
  assert(v[0] == -1.5, "negative");
  assert(v[1] == 0.0, "zero");
  assert(v[2] == -0.5, "negative fraction");
  assert(v[3] == 1000.5, "underscored float");
}
