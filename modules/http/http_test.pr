    assert(resp.status == 200, "status 200");
    assert(resp.body == "HelloWorld", "chunked body with extension");
  };

  string chunked = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n5;ext=val\r\nHello\r\n5\r\nWorld\r\n0\r\n\r\n";
  _serve_once(listener, chunked)?!;
  listener.close()?!;
  sleep(Duration.from_millis(100));
}

