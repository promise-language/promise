// T1347: Wake a serve() loop out of its blocking accept() and signal shutdown.
// The server may have already consumed the stop signal after handling the
// request and closed its listener, in which case this wake connection races
// with the close and fails (ECONNRESET/ECONNREFUSED on loopback under load).
// That is expected and harmless, so tolerate any connect/close error — exactly
// as the production ServerShutdownHandle.shutdown does (http.pr). The earlier
// raw `net.TcpStream.connect(...)?!` panicked on this benign race, which was the
// residual flake (misattributed to the http_get read path).
_wake_serve(channel[bool] stop, int port) {
  stop.send(true);
  net.TcpStream c = net.TcpStream.connect("127.0.0.1", port)? e {
    return;
  };
  c.close()? e {
  };
}

// The serve tests synchronize deterministically (T1632): receiving the port
// over port_ch is already a happens-before edge past bind+listen, and the serve
// goroutine signals `done` after serve returns — which, thanks to the drain
// barrier, is after every connection goroutine has finished.
test_server_serve() `test(exclude: wasm, timeout: "10s") {
  channel[int] port_ch = channel[int](capacity: 1);
  channel[channel[bool]] stop_ch = channel[channel[bool]](capacity: 1);
  channel[bool] done = channel[bool](capacity: 1);

  go {
    Server server = Server.bind("127.0.0.1", 0)?!;
    port_ch.send(server.port);
    channel[bool] stop_ref = server._stop;
    stop_ch.send(move stop_ref);
    _OkHandler handler = _OkHandler(response_body: "served");
    server.serve(move handler)?!;
    done.send(true);
  };

  if port := <-port_ch {
    if stop := <-stop_ch {
      // Send a real request through serve
      Response resp = http_get("http://127.0.0.1:" + port.to_string() + "/")?!;
      assert(resp.status == 200, "status 200");
      assert(resp.body == "served", "body from serve");

      // Shut down: signal + wake accept (tolerant of the shutdown race).
      _wake_serve(stop, port);
      _ := <-done;
    }
  }
}

test_server_serve_error_handler() `test(exclude: wasm, timeout: "10s") {
  channel[int] port_ch = channel[int](capacity: 1);
