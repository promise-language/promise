  // Write more than buffer size to trigger auto-flush
  u8[] data = u8[]();
  int i = 0;
  while i < 10 {
    data.push(65u8); // A
    i += 1;
  }
  w.write(data)?!;
  w.close()?!;
  string content = File.read_content(os.temp_dir + "/pr_iot_bwf")?!;
  assert(content.len == 10, "all bytes flushed");
  File.remove(os.temp_dir + "/pr_iot_bwf")?!;
}

