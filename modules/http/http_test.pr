    assert(resp.status == 200, "final status 200");
  };

  string[] responses = string[]();
  responses.push("HTTP/1.1 303 See Other\r\nLocation: /result\r\nContent-Length: 0\r\nConnection: close\r\n\r\n");
  responses.push("HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok");
  string[] requests = _serve_n(listener, responses)?!;
  assert(requests[1].contains("GET /result"), "303 rewrites to GET");
  assert(!requests[1].contains("data"), "303 drops body");
  listener.close()?!;
