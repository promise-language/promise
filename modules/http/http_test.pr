//     reusable even though HTTP/1.0 defaults to close (conn_keepalive branch). ---

test_client_http10_keepalive_reuse() `test(exclude: wasm, timeout: "10s") {
  net.TcpListener listener = net.TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

