// T2038: `yield v` transfers ownership of v to the consumer exactly as `return v`
// hands it to a caller (docs/language-design.md §12.4). The for-in binding owns
// each yielded element and drops it at the end of the iteration unless it is moved
// out; abandoning the loop destroys the generator, which drops what it still owns.
//
// Every test here yields HEAP values: a string literal's drop is a no-op, so a
// literal would hide both the double free (a stored binding freed again by the
// generator) and the leak (a built value stranded in an abandoned generator).
type Box {
  string v;
}

type T2038Err is error {
  int at;
}

type Holder {
  string base;
  Box[] boxes;

  names(this, int n) stream[string] {
    int i = 0;
    while i < n {
      yield "{this.base}-{i}";
      i += 1;
    }
  }

  // A borrowed receiver's field, yielded twice: each yield hands out a copy.
  base_twice(this) stream[string] {
    yield this.base;
    yield this.base;
  }

  first_box(this) stream[Box] {
    yield this.boxes[0];
  }
}

// --- Generators ---

fresh(int n) stream[string] {
  int i = 0;
  while i < n {
    yield "s{i}";
    i += 1;
  }
}

indexed(string[] items) stream[string] {
  int i = 0;
  while i < items.len {
    yield items[i];
    i += 1;
  }
}

forin(string[] items) stream[string] {
  for it in items {
    yield it;
  }
}

local_moved(int n) stream[string] {
  int i = 0;
  while i < n {
    string s = "l{i}";
    yield s;
    i += 1;
  }
}

chained(int n) stream[string] {
  for s in fresh(n) {
    yield s;
  }
}

boxes_fresh(int n) stream[Box] {
  int i = 0;
  while i < n {
    yield Box(v: "b{i}");
    i += 1;
  }
}

box_local(int n) stream[Box] {
  int i = 0;
  while i < n {
    Box b = Box(v: "k{i}");
    yield b;
    i += 1;
  }
}

box_indexed(Box[] bs) stream[Box] {
  int i = 0;
  while i < bs.len {
    yield bs[i];
    i += 1;
  }
}

opt_borrowed(string? o) stream[string] {
  yield o!;
  yield o!;
}

opt_moved(string? move o) stream[string] {
  yield o!;
}

opt_local() stream[string] {
  string? o = "q{1}";
  yield o!;
}

elvis_borrowed(string? o) stream[string] {
  yield o ?: "d{1}";
}

optional_elems() stream[string?] {
  yield "o{1}";
  yield none;
  yield "o{2}";
}

make_strings() string[] {
  string[] v = ["a{1}", "b{2}", "c{3}"];
  return v;
}

delegate_vec() stream[string] {
  string[] v = ["a{1}", "b{2}"];
  yield * v;
}

delegate_box_vec() stream[Box] {
  Box[] v = [Box(v: "x{1}"), Box(v: "y{2}")];
  yield * v;
}

delegate_array() stream[string] {
  string[2] a = ["a{1}", "b{2}"];
  yield * a;
}

delegate_iter() stream[string] {
  string[] v = ["a{1}", "b{2}"];
  yield * v.iter();
}

delegate_temp_iter() stream[string] {
  yield * make_strings().iter();
}

delegate_temp_vec() stream[string] {
  yield * make_strings();
}

delegate_gen(int n) stream[string] {
  yield * fresh(n);
}

// A closure cannot be copied, so `yield*` moves each one out of a collection it
// owns (a local or a temporary); the collection drops only what is left.
make_fns(int base)(() -> int)[] {
  int b = base;
  (() -> int)[] v = [|| -> b + 1, || -> b + 2, || -> b + 3];
  return v;
}

delegate_fns_local(int base) stream[() -> int] {
  (() -> int)[] v = make_fns(base);
  yield * v;
}

delegate_fns_temp(int base) stream[() -> int] {
  yield * make_fns(base);
}

delegate_fns_array() stream[() -> int] {
  string s = "c{1}";
  (() -> int)[2] a = [move || -> s.len, || -> 7];
  yield * a;
}

type Names {
  string[] items;

  all(this) stream[string] {
    yield * this.items;
  }
}

// Every droppable element category: the consumer's binding owns and drops it.
enum Shape {
  Circle(string name),
  Empty,
}

tuples(int n) stream[(string, int)] {
  int i = 0;
  while i < n {
    yield ("t{i}", i);
    i += 1;
  }
}

shapes(int n) stream[Shape] {
  int i = 0;
  while i < n {
    yield Shape.Circle("c{i}");
    i += 1;
  }
}

optional_boxes(int n) stream[Box?] {
  int i = 0;
  while i < n {
    Box? b = Box(v: "o{i}");
    yield b;
    i += 1;
  }
}

vectors(int n) stream[string[]] {
  int i = 0;
  while i < n {
    yield["v{i}", "w{i}"];
    i += 1;
  }
}

maps(int n) stream[map[string, int]] {
  int i = 0;
  while i < n {
    map[string, int] m = map[string, int]();
    m["k{i}"] = i;
    yield m;
    i += 1;
  }
}

refs(int n) stream[Ref[string]] {
  int i = 0;
  while i < n {
    yield Ref[string]("r{i}");
    i += 1;
  }
}

closures(int base) stream[() -> int] {
  int b = base;
  yield || -> b + 1;
  yield || -> b + 2;
}

// A string boxed into a structural view at the yield: the consumer owns the box.
views(int n) stream[Format] {
  int i = 0;
  while i < n {
    yield "f{i}";
    i += 1;
  }
}

ffresh!(int n, int fail_at) stream[string] {
  int i = 0;
  while i < n {
    if i == fail_at {
      raise T2038Err(message: "stop", at: i);
    }
    yield "f{i}";
    i += 1;
  }
}

by_index[T](T[] items) stream[T] {
  int i = 0;
  while i < items.len {
    yield items[i];
    i += 1;
  }
}

// --- Consumers: the item's matrix (fresh values) ---

fresh_read_break() `test {
  int seen = 0;
  for s in fresh(3) {
    seen = s.len;
    break;
  }
  assert(seen == 2, "{seen}");
}

fresh_store_break() `test {
  string first = "";
  for s in fresh(3) {
    first = s;
    break;
  }
  assert(first == "s0", "{first}");
}

fresh_store_all() `test {
  string last = "";
  for s in fresh(3) {
    last = s;
  }
  assert(last == "s2", "{last}");
}

fresh_read_all() `test {
  int n = 0;
  for s in fresh(3) {
    n += s.len;
  }
  assert(n == 6, "{n}");
}

fresh_concat_all() `test {
  string j = "";
  for s in fresh(3) {
    j = j + s;
  }
  assert(j == "s0s1s2", "{j}");
}

fresh_discarded_binding() `test {
  int count = 0;
  for _ in fresh(3) {
    count += 1;
  }
  assert(count == 3, "{count}");
}

fresh_continue() `test {
  string last = "";
  int seen = 0;
  for s in fresh(4) {
    seen += 1;
    if s == "s1" {
      continue;
    }
    last = s;
  }
  assert(seen == 4, "{seen}");
  assert(last == "s3", "{last}");
}

fresh_push() `test {
  string[] got = [];
  for s in fresh(3) {
    got.push(move s);
  }
  assert(got.len == 3, "{got.len}");
  assert(got[2] == "s2", "{got[2]}");
}

// T1453: an early return out of the loop destroys the suspended generator.
first_len(int n) int {
  for s in fresh(n) {
    if s.len > 0 {
      return s.len;
    }
  }
  return 0;
}

fresh_early_return() `test {
  assert(first_len(3) == 2, "early return");
  assert(first_len(0) == 0, "empty");
}

// --- Matrix: borrowed places (heap strings, so a missing copy would crash) ---

indexed_store_all() `test {
  string[] items = ["a{1}", "b{2}", "c{3}"];
  string last = "";
  for s in indexed(items) {
    last = s;
  }
  assert(last == "c3", "{last}");
  assert(items[2] == "c3", "source intact: {items[2]}");
}

indexed_read_break() `test {
  string[] items = ["a{1}", "b{2}"];
  int seen = 0;
  for s in indexed(items) {
    seen = s.len;
    break;
  }
  assert(seen == 2, "{seen}");
}

indexed_store_break() `test {
  string[] items = ["a{1}", "b{2}"];
  string first = "";
  for s in indexed(items) {
    first = s;
    break;
  }
  assert(first == "a1", "{first}");
}

forin_store_all() `test {
  string[] items = ["a{1}", "b{2}", "c{3}"];
  string last = "";
  for s in forin(items) {
    last = s;
  }
  assert(last == "c3", "{last}");
}

forin_read_all() `test {
  string[] items = ["a{1}", "b{2}"];
  int n = 0;
  for s in forin(items) {
    n += s.len;
  }
  assert(n == 4, "{n}");
}

forin_store_break() `test {
  string[] items = ["a{1}", "b{2}"];
  string first = "";
  for s in forin(items) {
    first = s;
    break;
  }
  assert(first == "a1", "{first}");
}

