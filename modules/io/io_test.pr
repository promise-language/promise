dir_list_mixed() `test(exclude: wasm) {
  // List a directory containing one file and one subdirectory.
  if Dir.exists(os.temp_dir + "/pr_iot_dlmix") {
    File.remove(os.temp_dir + "/pr_iot_dlmix/file.txt")? e {
    };
    Dir.remove(os.temp_dir + "/pr_iot_dlmix/sub")? e {
    };
    Dir.remove(os.temp_dir + "/pr_iot_dlmix")?!;
  }
  Dir.make(os.temp_dir + "/pr_iot_dlmix")?!;
  File.write_content(os.temp_dir + "/pr_iot_dlmix/file.txt", "x")?!;
  Dir.make(os.temp_dir + "/pr_iot_dlmix/sub")?!;
  string[] entries = Dir.list(os.temp_dir + "/pr_iot_dlmix")?!;
  assert(entries.len == 2, "two entries (file + subdir)");
  bool found_file = false;
  bool found_sub = false;
  int i = 0;
  while i < entries.len {
    if entries[i] == "file.txt" {
      found_file = true;
    }
    if entries[i] == "sub" {
      found_sub = true;
    }
    assert(entries[i] != ".", "no dot entry");
    assert(entries[i] != "..", "no dotdot entry");
    i += 1;
  }
  assert(found_file, "file.txt in listing");
  assert(found_sub, "sub in listing");
  File.remove(os.temp_dir + "/pr_iot_dlmix/file.txt")?!;
  Dir.remove(os.temp_dir + "/pr_iot_dlmix/sub")?!;
  Dir.remove(os.temp_dir + "/pr_iot_dlmix")?!;
}

