local_moved_store_all() `test {
  string last = "";
  for s in local_moved(3) {
    last = s;
  }
  assert(last == "l2", "{last}");
}

local_moved_break() `test {
  string first = "";
  for s in local_moved(3) {
    first = s;
    break;
  }
  assert(first == "l0", "{first}");
}

chained_store_all() `test {
  string last = "";
  for s in chained(3) {
    last = s;
  }
  assert(last == "s2", "{last}");
}

chained_store_break() `test {
  string first = "";
  for s in chained(3) {
    first = s;
    break;
  }
  assert(first == "s0", "{first}");
}

// --- Heap user types ---

boxes_fresh_store() `test {
  Box last = Box(v: "");
  for b in boxes_fresh(3) {
    last = b;
  }
  assert(last.v == "b2", "{last.v}");
}

boxes_fresh_store_break() `test {
  Box first = Box(v: "");
  for b in boxes_fresh(3) {
    first = b;
    break;
  }
  assert(first.v == "b0", "{first.v}");
}

box_local_store() `test {
  Box[] got = [];
  for b in box_local(3) {
    got.push(move b);
  }
  assert(got.len == 3, "{got.len}");
  assert(got[1].v == "k1", "{got[1].v}");
}

box_indexed_store() `test {
  Box[] bs = [Box(v: "i{1}"), Box(v: "j{2}")];
  Box last = Box(v: "");
  for b in box_indexed(bs) {
    last = b;
  }
  assert(last.v == "j2", "{last.v}");
  assert(bs[1].v == "j2", "source intact: {bs[1].v}");
}

box_indexed_break() `test {
  Box[] bs = [Box(v: "i{1}"), Box(v: "j{2}")];
  int seen = 0;
  for b in box_indexed(bs) {
    seen = b.v.len;
    break;
  }
  assert(seen == 2, "{seen}");
}

// --- Generator methods (the module-hosted form of the item, here in-file) ---

method_names_store() `test {
  Holder h = Holder(base: "h{1}", boxes: []);
  string last = "";
  for s in h.names(3) {
    last = s;
  }
  assert(last == "h1-2", "{last}");
}

method_names_break() `test {
  Holder h = Holder(base: "h{1}", boxes: []);
  string first = "";
  for s in h.names(3) {
    first = s;
    break;
  }
  assert(first == "h1-0", "{first}");
}

method_field_twice() `test {
  Holder h = Holder(base: "h{2}", boxes: []);
  string[] got = [];
  for s in h.base_twice() {
    got.push(move s);
  }
  assert(got.len == 2, "{got.len}");
  assert(got[0] == "h2" && got[1] == "h2", "copies");
  assert(h.base == "h2", "receiver intact: {h.base}");
}

method_field_element() `test {
  Holder h = Holder(base: "", boxes: [Box(v: "e{1}")]);
  Box got = Box(v: "");
  for b in h.first_box() {
    got = b;
  }
  assert(got.v == "e1", "{got.v}");
  assert(h.boxes[0].v == "e1", "receiver intact");
}

// --- Optionals ---

opt_borrowed_store() `test {
  string? o = "o{1}";
  string[] got = [];
  for s in opt_borrowed(o) {
    got.push(move s);
  }
  assert(got.len == 2, "{got.len}");
  assert(got[0] == "o1" && got[1] == "o1", "both yields");
  assert(o! == "o1", "caller's optional intact");
}

opt_borrowed_break() `test {
  string? o = "o{2}";
  string first = "";
  for s in opt_borrowed(o) {
    first = s;
    break;
  }
  assert(first == "o2", "{first}");
  assert(o! == "o2", "caller's optional intact");
}

opt_moved_store() `test {
  string? o = "m{1}";
  string last = "";
  for s in opt_moved(move o) {
    last = s;
  }
  assert(last == "m1", "{last}");
}

opt_local_store() `test {
  string last = "";
  for s in opt_local() {
    last = s;
  }
  assert(last == "q1", "{last}");
}

elvis_borrowed_present() `test {
  string? o = "e{1}";
  string last = "";
  for s in elvis_borrowed(o) {
    last = s;
  }
  assert(last == "e1", "{last}");
  assert(o! == "e1", "caller's optional intact");
}

elvis_borrowed_absent() `test {
  string? o = none;
  string last = "";
  for s in elvis_borrowed(o) {
    last = s;
  }
  assert(last == "d1", "{last}");
}

optional_elements() `test {
  int present = 0;
  int absent = 0;
  string last = "";
  for s in optional_elems() {
    if v := s {
      present += 1;
      last = v.clone();
    } else {
      absent += 1;
    }
  }
  assert(present == 2, "{present}");
  assert(absent == 1, "{absent}");
  assert(last == "o2", "{last}");
}

