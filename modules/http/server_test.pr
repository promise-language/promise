    stop_ch.send(move stop_ref);
    _ErrorHandler handler = _ErrorHandler(error_message: "serve error");
    server.serve(move handler)?!;
    done.send(true);
  };

  if port := <-port_ch {
    if stop := <-stop_ch {
      // Handler raises — serve should return 500 and continue
      Response resp = http_get("http://127.0.0.1:" + port.to_string() + "/")?!;
      assert(resp.status == 500, "status 500");
      assert(resp.body == "serve error", "error body");

      // Shut down: signal + wake accept (tolerant of the shutdown race).
      _wake_serve(stop, port);
      _ := <-done;
    }
  }
}

