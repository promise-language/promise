// guardmod — module whose method body is the only place MutexGuard[int] is
// instantiated (T1929).
type Counter `public `doc("A counter guarded by a Mutex owned by the method that uses it") {
  int start `public `doc("Value the guarded counter starts from");

  bump(this, int by) int `public `doc("Locks a local Mutex[int] and returns the incremented value") {
    // The MutexGuard[int] local lives only inside this module's body. Before
    // T1929 that made compileModule declare a MutexGuard[int].drop stub nothing
    // ever defines, and bake a pointer to it into promise_typeinfo_MutexGuard[int]
    // — an undefined symbol lld-link (Windows) refused to link.
    Mutex[int] mx = Mutex[int](this.start);
    MutexGuard[int] g = mx.lock();
    g.borrow = g.borrow + by;
    return g.borrow;
  }
}

// Holder — module whose method body is the only place Ref[int] and Weak[int]
// are instantiated. The Arc family keeps per-instance drop stubs that are
// body-less when the typeinfo is emitted and are filled in lazily at the first
// drop site — the case T1929's verifier must not mistake for a dangling
// reference (a false positive there aborts the compile).
type Holder `public `doc("Holds a start value observed through a module-local Ref[int]") {
  int start `public `doc("Value the module-local Ref[int] is created from");

  observe(this) int `public `doc("Creates a local Ref[int] and Weak[int] and returns the referenced value") {
    Ref[int] r = Ref[int](this.start);
    Weak[int] _w = r.downgrade();
    return r.borrow;
  }
}
