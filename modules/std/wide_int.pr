// std/wide_int.pr — Wide integer types (128/256/512-bit, signed and unsigned).
//
// These are pure value types backed by LLVM `iN`, so they are automatically
// `copy, need no heap allocation, and have no drop(). The operator surface
// mirrors i64.pr/u64.pr; LLVM lowers each `native op to the corresponding
// width-polymorphic instruction (division on wide types routes through the
// compiler-rt soft-arithmetic library, which is already linked).
//
// to_string / parse default to base 16 (hex), the natural representation for
// the dominant wide-integer use cases (hashes, UUIDs, addresses, ECC scalars)
// and the only base whose formatting is division-free. Decimal remains
// available via an explicit `base: 10` argument. See docs/large-integers.md.
type i128 `native `public `doc("Signed 128-bit integer.") {
  +(i128 other) i128 `native;
  -(i128 other) i128 `native;
  * (i128 other) i128 `native;
  / (i128 other) i128 `native;
  % (i128 other) i128 `native;
  == (i128 other) bool `native;
  != (i128 other) bool `native;
  < (i128 other) bool `native;
  > (i128 other) bool `native;
  <= (i128 other) bool `native;
  >= (i128 other) bool `native;
  -() i128 `native;
  ++ () i128 `native;
  -- () i128 `native;
  &(i128 other) i128 `native;
  | (i128 other) i128 `native;
  ^ (i128 other) i128 `native;
  << (i128 other) i128 `native;
  >> (i128 other) i128 `native;
  ~() i128 `native;
  .. (i128 end) Range[i128] `native;
  ..= (i128 end) Range[i128] `native;
  get hash int `native;
  get max i128 `public `global => 170141183460469231731687303715884105727i128;
  get min i128 `public `global => -170141183460469231731687303715884105727i128 - 1i128;

  parse!(Reader ~r, int base = 16) i128 `factory `public `doc("Parses a signed 128-bit integer (default base 16).") {
    i128 result = 0i128;
    i128 b = base as! i128;
    bool negative = false;
    bool started = false;
    bool has_digit = false;
    while true {
      if byte := r.read_byte() {
        int c = byte as! int;
        if !started && c == 45 {
          negative = true;
          started = true;
        } else {
          int digit = _digit_value(c);
          if digit >= 0 && digit < base {
            result = result * b + (digit as! i128);
            has_digit = true;
            started = true;
          } else {
            break;
          }
        }
      } else {
        if !started {
          raise error(message: "unexpected end of input");
        }
        break;
      }
    }
    if !has_digit {
      raise error(message: "expected digit");
    }
    if negative {
      result = 0i128 - result;
    }
    return result;
  }

  to_string(int base = 16, bool prefix = false, int? width, char fill = ' ') string `public `doc("Converts to string (default base 16). Optional base (2-36), prefix, width, and fill.") {
    bool negative = this < 0i128;
    u128 abs_val = 0u128;
    if negative {
      abs_val = (0i128 - (this + 1i128)) as! u128 + 1u128;
    } else {
      abs_val = this as! u128;
    }
    return _format_with_prefix_width(_wide_int_format_128(abs_val, base), negative, base, prefix, width, fill);
  }
  format!(Writer ~w) `public {
    w.write_string(this.to_string());
  }
  encode!(Encoder ~e) `public `doc("Encodes as a decimal string (lossless).") {
    e.encode_string(this.to_string(base: 10));
  }
  decode!(Decoder ~d) Self `factory `public `doc("Decodes from a decimal string.") {
    string s = d.decode_string();
    Scanner r = Scanner(s: s);
    return i128.parse(r, 10);
  }
}

