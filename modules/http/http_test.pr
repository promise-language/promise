  assert(_method_to_string(_method_clone(Method.Post)) == "POST", "clone Post");
  assert(_method_to_string(_method_clone(Method.Put)) == "PUT", "clone Put");
  assert(_method_to_string(_method_clone(Method.Delete)) == "DELETE", "clone Delete");
  assert(_method_to_string(_method_clone(Method.Patch)) == "PATCH", "clone Patch");
