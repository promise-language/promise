// Tests for std/time.pr — Duration, Instant, sleep
// --- Duration factories ---
test_duration_from_nanos() `test {
  Duration d = Duration.from_nanos(500);
  assert(d.as_nanos == 500, "from_nanos 500");
}

test_duration_from_micros() `test {
  Duration d = Duration.from_micros(100);
  assert(d.as_nanos == 100000, "from_micros nanos");
  assert(d.as_micros == 100, "from_micros roundtrip");
}

test_duration_from_millis() `test {
  Duration d = Duration.from_millis(250);
  assert(d.as_nanos == 250000000, "from_millis nanos");
  assert(d.as_millis == 250, "from_millis roundtrip");
}

test_duration_from_secs() `test {
  Duration d = Duration.from_secs(3);
  assert(d.as_nanos == 3000000000, "from_secs nanos");
  assert(d.as_secs == 3, "from_secs roundtrip");
}

test_duration_zero() `test {
  Duration d = Duration.zero();
  assert(d.as_nanos == 0, "zero nanos");
  assert(d.is_zero, "is_zero");
  assert(!Duration.from_nanos(1).is_zero, "not is_zero");
}

// --- Duration accessors ---

test_duration_accessors() `test {
  Duration d = Duration.from_nanos(2500000000);
  assert(d.as_nanos == 2500000000, "as_nanos");
  assert(d.as_micros == 2500000, "as_micros");
  assert(d.as_millis == 2500, "as_millis");
  assert(d.as_secs == 2, "as_secs truncated");
}

// --- Duration arithmetic ---

test_duration_add() `test {
  Duration a = Duration.from_millis(100);
  Duration b = Duration.from_millis(200);
  Duration c = a + b;
  assert(c.as_millis == 300, "add");
}

test_duration_sub() `test {
  Duration a = Duration.from_millis(500);
  Duration b = Duration.from_millis(200);
  Duration c = a - b;
  assert(c.as_millis == 300, "sub");
}

test_duration_mul() `test {
  Duration d = Duration.from_millis(100);
  Duration r = d * 3;
  assert(r.as_millis == 300, "mul");
  assert((d * 0).is_zero, "mul zero");
}

// --- Duration comparison ---

test_duration_eq() `test {
  Duration a = Duration.from_millis(100);
  Duration b = Duration.from_millis(100);
  assert(a == b, "eq");
  assert(!(a != b), "not neq");
}

test_duration_lt_gt() `test {
  Duration a = Duration.from_millis(100);
  Duration b = Duration.from_millis(200);
  assert(a < b, "lt");
  assert(b > a, "gt");
  assert(a <= b, "le");
  assert(b >= a, "ge");
  assert(a <= a, "le eq");
  assert(a >= a, "ge eq");
}

// --- Duration to_string ---

test_duration_to_string_zero() `test {
  assert(Duration.zero().to_string() == "0ns", "zero");
}

test_duration_to_string_nanos() `test {
  assert(Duration.from_nanos(42).to_string() == "42ns", "42ns");
  assert(Duration.from_nanos(999).to_string() == "999ns", "999ns");
}

test_duration_to_string_negative() `test {
  Duration neg = Duration.from_millis(100) - Duration.from_millis(1600);
  assert(neg.to_string() == "-1.5s", "negative duration");
  Duration neg_ms = Duration.from_millis(10) - Duration.from_millis(52);
  assert(neg_ms.to_string() == "-42ms", "negative millis");
}

test_duration_to_string_micros() `test {
  assert(Duration.from_micros(5).to_string() == "5us", "5us");
  assert(Duration.from_nanos(1500).to_string() == "1.5us", "1.5us");
}

test_duration_to_string_millis() `test {
  assert(Duration.from_millis(42).to_string() == "42ms", "42ms");
  assert(Duration.from_nanos(1500000).to_string() == "1.5ms", "1.5ms");
}

test_duration_to_string_secs() `test {
  assert(Duration.from_secs(3).to_string() == "3s", "3s");
  assert(Duration.from_millis(1500).to_string() == "1.5s", "1.5s");
}

test_duration_to_string_boundaries() `test {
  // Exact boundary transitions: ns→us, us→ms, ms→s
  assert(Duration.from_nanos(999).to_string() == "999ns", "just under 1us");
  assert(Duration.from_nanos(1000).to_string() == "1us", "exactly 1us");
  assert(Duration.from_nanos(999999).to_string() == "999.9us", "just under 1ms");
  assert(Duration.from_nanos(1000000).to_string() == "1ms", "exactly 1ms");
  assert(Duration.from_nanos(999999999).to_string() == "999.9ms", "just under 1s");
  assert(Duration.from_nanos(1000000000).to_string() == "1s", "exactly 1s");
}

// --- Duration format ---

test_duration_format() `test {
  Builder b = Builder();
  Duration.from_millis(42).format(b)?!;
  assert(b.to_string() == "42ms", "format 42ms");
}

// --- Instant ---

// T0680 Part 1: no longer excludes wasm — the WASM monotonic clock
// (wasi clock_time_get / web promise_env.monotonic_nanos) now returns a real
// nonzero value instead of the old hardcoded 0.
test_instant_now() `test {
  Instant t = Instant.now();
  assert(t.nanos > 0, "now returns positive nanos");
}

// T0680 Part 1: the monotonic clock must be non-decreasing across two captures
// with work in between — proves it is a real clock, not frozen at 0. Runs on all
// targets including wasm32-wasi (resolution-independent: no strict elapsed bound).
test_instant_monotonic_nondecreasing() `test {
  Instant a = Instant.now();
  int x = 0;
  while x < 10000 {
    x = x + 1;
  }
  Instant b = Instant.now();
  assert(a.nanos > 0, "first capture nonzero");
  assert(b.nanos >= a.nanos, "monotonic non-decreasing");
}

test_instant_elapsed() `test {
  Instant start = Instant.now();
  // Do some trivial work
  int x = 0;
  while x < 1000 {
    x = x + 1;
  }
  Duration elapsed = start.elapsed();
  assert(elapsed.as_nanos >= 0, "elapsed non-negative");
}

test_instant_duration_since() `test {
  Instant a = Instant.now();
  int x = 0;
  while x < 1000 {
    x = x + 1;
  }
  Instant b = Instant.now();
  Duration d = b.duration_since(a);
  assert(d.as_nanos >= 0, "duration_since non-negative");
}

test_instant_comparison() `test {
  Instant a = Instant.now();
  int x = 0;
  while x < 100 {
    x = x + 1;
  }
  Instant b = Instant.now();
  assert(a <= b, "a <= b");
  assert(b >= a, "b >= a");
  assert(a != b || a == b, "!= or ==");
}

// --- sleep ---

test_sleep() `test(exclude: wasm) {
  Instant start = Instant.now();
  sleep(Duration.from_millis(15));
  Duration elapsed = start.elapsed();
  assert(elapsed.as_millis >= 10, "sleep at least 10ms");
}

// --- Instant raw readings and Duration arithmetic (T1563) ---

test_instant_from_nanos_roundtrip() `test {
  Instant t = Instant.from_nanos(1234567890);
  assert(t.as_nanos == 1234567890, "from_nanos roundtrips through as_nanos");
  assert(Instant.from_nanos(0).as_nanos == 0, "zero reading");
}

test_instant_as_nanos_matches_duration_since() `test {
  Instant a = Instant.from_nanos(1000);
  Instant b = Instant.from_nanos(3500);
  assert(b.as_nanos - a.as_nanos == 2500, "raw readings differ by the elapsed nanos");
  assert(b.duration_since(a).as_nanos == 2500, "duration_since agrees with the raw readings");
}

test_instant_plus_duration() `test {
  Instant base = Instant.from_nanos(1000);
  Instant later = base + Duration.from_nanos(500);
  assert(later.as_nanos == 1500, "adding a Duration moves forward");
  assert(later > base, "the result is ordered after the base");
  assert((base + Duration.zero()) == base, "adding zero is identity");
  assert((base + Duration.from_millis(2)).as_nanos == 2001000, "millisecond offset");
}

test_instant_minus_duration() `test {
  Instant base = Instant.from_nanos(1000);
  Instant earlier = base - Duration.from_nanos(400);
  assert(earlier.as_nanos == 600, "subtracting a Duration moves backward");
  assert(earlier < base, "the result is ordered before the base");
  assert(((base + Duration.from_secs(1)) - Duration.from_secs(1)) == base, "add then subtract roundtrips");
}

test_instant_deadline_pattern() `test {
  // The shape modules/net uses to express a relative timeout.
  Instant deadline = Instant.now() + Duration.from_secs(60);
  assert(deadline > Instant.now(), "a one-minute deadline is in the future");
  assert(deadline.duration_since(Instant.now()).as_secs >= 59, "roughly a minute out");
}

test_instant_handles_large_monotonic_readings() `test {
  // Deadlines reach the IO reactor as raw i64 nanos. A machine up for a day is
  // already past 2^31 ns, so anything that truncated to 32 bits on the way
  // would make every deadline fire the moment it was set.
  int day = 86400000000000;
  Instant t = Instant.from_nanos(day);
  assert(t.as_nanos == day, "a day of monotonic nanos survives the roundtrip");
  assert((t + Duration.from_secs(1)).as_nanos == day + 1000000000, "arithmetic stays 64-bit");
  assert((t + Duration.from_secs(1)).duration_since(t).as_secs == 1, "and the difference is exact");
}

test_instant_minus_more_than_it_holds() `test {
  // Instants are raw readings, not clamped: subtracting past the epoch goes
  // negative and stays ordered rather than wrapping. That is what lets a caller
  // write `Instant.now() - d` for an already-expired deadline with no special
  // case, however early in the monotonic epoch the process started.
  Instant early = Instant.from_nanos(5) - Duration.from_nanos(10);
  assert(early.as_nanos == -5, "the reading goes negative rather than wrapping");
  assert(early < Instant.from_nanos(0), "and stays ordered below zero");
  assert(Instant.from_nanos(0).duration_since(early).as_nanos == 5, "the difference is still exact");
}
