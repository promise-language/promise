test_raw_socket_create_close() `test(exclude: wasm) {
  int fd = _net_socket_create(2, 1, 0);
  assert(fd >= 0, "socket created");
  int rc = _net_socket_close(fd);
  assert(rc >= 0, "socket closed");
}

test_netpoll_open_close() `test(exclude: wasm) {
  int fd = _net_socket_create(2, 1, 0);
  assert(fd >= 0, "socket created");
  int pd = _net_netpoll_open(fd);
  assert(pd != 0, "netpoll opened");
  _net_netpoll_close(pd);
  int rc = _net_socket_close(fd);
  assert(rc >= 0, "socket closed");
}

test_netpoll_multiple_open_close() `test(exclude: wasm) {
  int i = 0;
  while i < 5 {
    int fd = _net_socket_create(2, 1, 0);
    assert(fd >= 0, "socket created");
    int pd = _net_netpoll_open(fd);
    assert(pd != 0, "netpoll opened");
    _net_netpoll_close(pd);
    int rc = _net_socket_close(fd);
    assert(rc >= 0, "socket closed");
    i = i + 1;
  }
}

test_listener_bind_auto_drop() `test(exclude: wasm) {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
}

test_listener_bind_and_close() `test(exclude: wasm) {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
  listener.close()?!;
}

_try_bind_invalid!() bool {
  TcpListener listener = TcpListener.bind("not_an_ip", 0)?^;
  listener.close()?^;
  return false;
}

test_listener_bind_invalid_address() `test(exclude: wasm) {
  bool ok = _try_bind_invalid()? e {
    return; // bind failed as expected
  };
  assert(false, "bind should have failed for invalid address");
}

test_listener_local_port() `test(exclude: wasm) {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;
  assert(port > 0, "local_port should be positive");
  assert(port < 65536, "local_port should be valid");
}

test_listener_drop_multiple() `test(exclude: wasm) {
  int i = 0;
  while i < 3 {
    TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
    i = i + 1;
  }
}

// Regression test for B0340: 10 sequential open/close cycles stress the
// batch_lock acquire path in netpoll_close. With the old 10ms reactor timeout,
// this could time out under heavy load (lock starvation). With 1ms it is fast.
test_netpoll_close_batch_lock_stress() `test(exclude: wasm) {
  int i = 0;
  while i < 10 {
    int fd = _net_socket_create(2, 1, 0);
    assert(fd >= 0, "socket created");
    int pd = _net_netpoll_open(fd);
    assert(pd != 0, "netpoll opened");
    _net_netpoll_close(pd);
    int rc = _net_socket_close(fd);
    assert(rc >= 0, "socket closed");
    i = i + 1;
  }
}

// Verify _eagain() returns a valid positive errno value on the current platform.
// Linux=11 (EAGAIN), macOS=35, Windows=10035 (WSAEWOULDBLOCK).
test_eagain_is_valid_errno() `test(exclude: wasm) {
  int e = _eagain();
  assert(e > 0, "eagain is positive");
}

// Verify _net_strerror returns a human-readable message for known and unknown errno values.
test_net_strerror_known_and_unknown() `test(exclude: wasm) {
  assert(_net_strerror(9) == "bad file descriptor", "EBADF");
  assert(_net_strerror(32) == "broken pipe", "EPIPE");
  assert(_net_strerror(999999) == "network error (errno 999999)", "unknown errno");
}

// Server side uses raw blocking sockets; sequential flow — no goroutines
// needed because kernel buffers handle connect backlog and data.

test_stream_connect_and_close() `test(exclude: wasm) {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  int port = _net_socket_getsockname(sfd);

  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  client.close()?!;

  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_stream_write() `test(exclude: wasm) {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  int port = _net_socket_getsockname(sfd);

  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  u8[] data = "Hi".bytes();
  int written = client.write(data)?!;
  assert(written == 2, "wrote 2 bytes");
  client.close()?!;

  u8[] buf = u8[].filled(0, 64);
  int n = _net_socket_recv(afd, buf);
  assert(n == 2, "server read 2 bytes");
  assert(buf[0] == 72, "byte H");
  assert(buf[1] == 105, "byte i");

  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_stream_read() `test(exclude: wasm) {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  int port = _net_socket_getsockname(sfd);

  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  u8[] data = "Ok".bytes();
  int sent = _net_socket_send(afd, data);
  assert(sent == 2, "server sent 2 bytes");
  _net_socket_close(afd);

  u8[] buf = u8[].filled(0, 64);
  int n = client.read(buf)?!;
  assert(n == 2, "client read 2 bytes");
  assert(buf[0] == 79, "byte O");
  assert(buf[1] == 107, "byte k");

  client.close()?!;
  _net_socket_close(sfd);
}

test_stream_shutdown_write() `test(exclude: wasm) {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  int port = _net_socket_getsockname(sfd);

  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  client.shutdown(write: true)?!;

  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");
  u8[] buf = u8[].filled(0, 64);
  int n = _net_socket_recv(afd, buf);
  assert(n == 0, "read EOF after shutdown");

  _net_socket_close(afd);
  client.close()?!;
  _net_socket_close(sfd);
}

test_stream_shutdown_read() `test(exclude: wasm) {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  int port = _net_socket_getsockname(sfd);

  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  client.shutdown(read: true)?!;

  // After SHUT_RD, client can still write
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  u8[] data = "Hi".bytes();
  int written = client.write(data)?!;
  assert(written == 2, "wrote after shutdown read");

  u8[] buf = u8[].filled(0, 64);
  int n = _net_socket_recv(afd, buf);
  assert(n == 2, "server received data");

  _net_socket_close(afd);
  client.close()?!;
  _net_socket_close(sfd);
}

test_stream_shutdown_both() `test(exclude: wasm) {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  int port = _net_socket_getsockname(sfd);

  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  client.shutdown(read: true, write: true)?!;

  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");
  u8[] buf = u8[].filled(0, 64);
  int n = _net_socket_recv(afd, buf);
  assert(n == 0, "server read EOF after full shutdown");

  _net_socket_close(afd);
  client.close()?!;
  _net_socket_close(sfd);
}

// The three tests above only ever shut a live connection down, which is the one
// shape of shutdown(2) that cannot fail. The failure path has to reach the
// caller as an ordinary NetError like every other socket error, and doing it
// after close() is the deterministic way there (T1632): close() parks the fd at
// -1, so the call fails with EBADF whatever the connection state was.
test_shutdown_reports_socket_failure() `test(exclude: wasm, timeout: "10s") {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  int port = _net_socket_getsockname(sfd);

  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  client.close()?!;

  bool raised = false;
  client.shutdown(read: true, write: true)? e {
    assert(e is NetError, "a failed shutdown raises a NetError");
    NetError ne = e as! NetError;
    // EBADF everywhere POSIX; Winsock reports the same mistake as WSAENOTSOCK.
    assert(ne.code == 9 || ne.code == 10038, "and reports the socket errno, got {ne.code}");
    assert(!ne.is_timeout && !ne.is_cancelled, "which is neither a timeout nor a cancellation");
    raised = true;
  };
  assert(raised, "shutting down a closed stream must raise");

  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_listener_accept() `test(exclude: wasm) {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  // Connect with raw blocking socket — kernel queues it in the backlog
  int cfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(cfd >= 0, "client socket");
  int rc = _net_socket_connect_addr(cfd, "127.0.0.1", port);
  assert(rc == 0, "connect");

  // Accept should find the pending connection
  TcpStream stream = listener.accept()?!;

  // Verify data flows through the accepted stream
  u8[] msg = "ab".bytes();
  int sent = _net_socket_send(cfd, msg);
  assert(sent == 2, "raw client sent");

  u8[] buf = u8[].filled(0, 64);
  int n = stream.read(buf)?!;
  assert(n == 2, "accepted stream read");
  assert(buf[0] == 97, "byte a");
  assert(buf[1] == 98, "byte b");

  stream.close()?!;
  _net_socket_close(cfd);
  listener.close()?!;
}

_try_connect_refused!() bool {
  // Port 1 is reserved and should not have a listener — connect must fail.
  TcpStream s = TcpStream.connect("127.0.0.1", 1)?^;
  s.close()?^;
  return true;
}

test_stream_connect_refused() `test(exclude: wasm) {
  bool ok = _try_connect_refused()? e {
    assert(e.message.contains("connection refused"), "connect refused message");
    return;
  };
  // On some CI environments port 1 may unexpectedly be open; skip rather than
  // fail to avoid a flaky test.
}

test_stream_drop_without_close() `test(exclude: wasm) {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  int port = _net_socket_getsockname(sfd);

  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  // Drop without close — drop() should clean up fd + reactor

  int afd = _net_socket_accept_addr(sfd);
  if afd >= 0 {
    _net_socket_close(afd);
  }
  _net_socket_close(sfd);
}

// T1631: a write to a socket that can no longer send must surface as an
// ordinary failable error, never kill the process with SIGPIPE. Before SIGPIPE
// was set to SIG_IGN at startup, that EPIPE arrived as a fatal signal and
// killed the entire test binary, taking every later test in the batch with it —
// the failure mode that broke trunk via modules/tls/tls_test.pr.
//
// Shutting down our own send half is what makes this deterministic: POSIX
// requires a write on a socket already shut down for writing to fail with
// EPIPE and raise SIGPIPE, with no dependence on when a peer's FIN or RST
// happens to arrive. So the test needs no sleep and cannot race under load
// (T1632).
test_stream_write_after_shutdown_raises_not_sigpipe() `test(exclude: wasm, timeout: "10s") {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  int port = _net_socket_getsockname(sfd);

  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  // Close our own send half; the next write is required to fail.
  client.shutdown(write: true)?!;

  bool raised = false;
  client.write("ping".bytes())? e {
    raised = true;
  };
  assert(raised, "write after shutdown(write) must raise an error, not kill the process");

  _net_socket_close(afd);
  _net_socket_close(sfd);
  client.close()? e {
  };
}

// --- Name resolution (T1518) ---
//
// Every test here is hermetic: it resolves either a numeric literal or a name
// that /etc/hosts (or the platform equivalent) answers locally. Nothing depends
// on a working nameserver, so these cannot hang or flake in a sandboxed runner.

test_resolve_ipv4_literal() `test(exclude: wasm) {
  string[] addresses = resolve("127.0.0.1")?!;
  assert(addresses.len == 1, "an IPv4 literal resolves to exactly itself");
  assert(addresses[0] == "127.0.0.1", "IPv4 literal round-trips through inet_ntop");
}

test_resolve_ipv6_literal() `test(exclude: wasm) {
  string[] addresses = resolve("::1")?!;
  assert(addresses.len == 1, "an IPv6 literal resolves to exactly itself");
  assert(addresses[0] == "::1", "IPv6 literal round-trips through inet_ntop");
}

// Exercises the AF_UNSPEC path: localhost may answer with 127.0.0.1, ::1, or
// both depending on the host's /etc/hosts, and every answer must be a loopback
// address in presentation form.
test_resolve_localhost() `test(exclude: wasm) {
  string[] addresses = resolve("localhost")?!;
  assert(addresses.len >= 1, "localhost resolves to at least one address");
  for address in addresses {
    assert(address == "127.0.0.1" || address == "::1",
    "localhost must resolve to a loopback address, got '{address}'");
  }
}

// A host name longer than 255 characters is rejected locally by every platform
// resolver (musl, glibc, macOS, Winsock) with EAI_NONAME — no packet is sent, so
// this exercises the failure path without a network round trip or an NXDOMAIN
// lookup that could hang for seconds or normalize to try_again instead.
_over_long_host() string {
  return "a".repeat(300);
}

test_resolve_invalid_name_raises() `test(exclude: wasm) {
  bool raised = false;
  resolve(_over_long_host())? e is ResolveError {
    raised = true;
    assert(e.host == _over_long_host(), "ResolveError carries the name that failed");
    match e.kind {
      ResolveErrorKind.not_found => {
      },
      _ => {
        assert(false, "an over-long host name must normalize to not_found");
      },
    }
  }!;
  assert(raised, "resolving an over-long host name must raise ResolveError");
}

// ResolveError inherits NetError, so code that already catches NetError — the
// http and tls modules, and any user code written before T1518 — keeps catching
// resolution failures unchanged. This is a compile-time proof of that relation:
// sema type-checks the conversion and the function is never called.
//
// The natural runtime form of this test, `resolve(bad)? e is NetError { }`,
// cannot be written yet: T1702 makes a typed catch at a *supertype* drop only
// the declared type's fields, so it leaks ResolveError.host. Restore the runtime
// version when T1702 is fixed.
_resolve_error_is_a_net_error(ResolveError move e) NetError {
  return e;
}

// Connect by name. The raw server socket is bound to 127.0.0.1 and the client
// connects to "localhost"; on a dual-stack host that resolves to ::1 first, so
// this also covers the fall-through path where the first address is refused and
// the next one succeeds. Sequential — the kernel backlog holds the connection
// until accept, so no goroutine and no sleep are involved (T1632).
test_connect_by_hostname() `test(exclude: wasm) {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  int port = _net_socket_getsockname(sfd);

  TcpStream client = TcpStream.connect("localhost", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  int written = client.write("hi".bytes())?!;
  assert(written == 2, "wrote 2 bytes over a connection made by name");

  u8[] buf = u8[].filled(0, 64);
  int n = _net_socket_recv(afd, buf);
  assert(n == 2, "server read 2 bytes");
  assert(buf[0] == 104, "byte h");
  assert(buf[1] == 105, "byte i");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_connect_invalid_name_raises() `test(exclude: wasm) {
  bool raised = false;
  TcpStream.connect(_over_long_host(), 80)? e is ResolveError {
    raised = true;
    assert(e.host == _over_long_host(), "ResolveError carries the name that failed");
  }!;
  assert(raised, "connecting to an unresolvable name must raise ResolveError");
}

// Repeated resolution must not accumulate Promise-side allocations: every
// `string[]` result and every string inside it is owned by the caller and freed
// at scope exit, which the allocation-count leak detector enforces here.
//
// Note what this does NOT cover. The addrinfo list itself is allocated by the
// platform resolver with libc malloc, so it passes through neither pal_alloc nor
// the `memory_limit` accounting (which counts only Promise allocations) — a
// missing `_net_resolve_free` in `_AddrList.drop` leaks ~110 bytes per lookup
// and every runtime check here stays green. That path is guarded structurally
// instead, by TestNetAddrListDropFreesResolveList in the codegen Go tests, which
// asserts the drop actually calls @promise_net_resolve_free.
test_resolve_repeated_no_leak() `test(exclude: wasm, timeout: "30s") {
  int i = 0;
  while i < 2000 {
    string[] addresses = resolve("localhost")?!;
    assert(addresses.len >= 1, "localhost resolves");
    i = i + 1;
  }
}

// The three normalized resolver codes that no host runner can produce at
// runtime. `unsupported` (-4) is only ever returned by the WASM stub, and
// `try_again` (-2) / `failed` (-3) need a nameserver that is reachable but
// broken — neither is reproducible hermetically, so the mapping is exercised
// through _make_resolve_error directly. Without this, three of the four
// ResolveErrorKind variants are constructed by no test at all, and a swapped
// arm (say -2 reported as `failed`) would ship: `try_again` is the one kind a
// caller is supposed to retry on, so mislabelling it turns a recoverable
// hiccup into a permanent failure.
test_resolve_error_kind_mapping() `test(exclude: wasm) {
  ResolveError again = _make_resolve_error("host.example", 0 - 2);
  match again.kind {
    ResolveErrorKind.try_again => {
    },
    _ => {
      assert(false, "-2 must map to try_again");
    },
  };
  assert(again.message.contains("retry may succeed"), "try_again explains it is worth retrying");

  ResolveError failed = _make_resolve_error("host.example", 0 - 3);
  match failed.kind {
    ResolveErrorKind.failed => {
    },
    _ => {
      assert(false, "-3 must map to failed");
    },
  };
  assert(failed.message.contains("resolver failure"), "failed names the resolver");

  // The WASM path: a target with no resolver at all must say so, rather than
  // claiming the name does not exist.
  ResolveError unsupported = _make_resolve_error("host.example", 0 - 4);
  match unsupported.kind {
    ResolveErrorKind.unsupported => {
    },
    _ => {
      assert(false, "-4 must map to unsupported");
    },
  };
  assert(unsupported.message.contains("not supported"), "unsupported says the target has no resolver");

  // An out-of-vocabulary code must not silently become not_found — anything
  // unrecognized is a permanent failure.
  ResolveError other = _make_resolve_error("host.example", 0 - 99);
  match other.kind {
    ResolveErrorKind.failed => {
    },
    _ => {
      assert(false, "an unknown normalized code must fall back to failed");
    },
  };
}

// Every kind carries the failing name and leaves the inherited NetError.code at
// 0: the normalized codes are not errnos, so _net_strerror would mistranslate
// them (-2 is EAGAIN's neighbour, not "try again" in errno terms). A caller
// reading .code must never see a resolver code leak through.
test_resolve_error_fields() `test(exclude: wasm) {
  for code in 1..5 {
    ResolveError e = _make_resolve_error("host.example", 0 - code);
    assert(e.host == "host.example", "ResolveError carries the failing name");
    assert(e.code == 0, "a normalized resolver code must not be reported as an errno");
    assert(e.message.contains("cannot resolve host 'host.example'"), "message names the host");
  }
}

// An empty host name is the degenerate input a caller reaches by passing an
// unvalidated string through. It must raise rather than resolve to something,
// and the platform resolvers cannot be trusted to decide that: Windows'
// getaddrinfo("") succeeds and hands back every local interface address,
// BSD/macOS succeeds and hands back loopback, and only glibc reports
// EAI_NONAME. pal_resolve_host rejects the empty name before the lookup so all
// three report it the same way (T1726).
test_resolve_empty_host_raises() `test(exclude: wasm) {
  bool raised = false;
  resolve("")? e is ResolveError {
    raised = true;
    assert(e.host == "", "ResolveError echoes the empty name back");
    // not_found specifically, and on every target: the rejection replaces
    // glibc's EAI_NONAME rather than inventing a fourth answer, so Linux's
    // reported kind is unchanged and the other two now match it.
    match e.kind {
      ResolveErrorKind.not_found => {
      },
      _ => {
        assert(false, "an empty host is reported as not_found");
      },
    };
  }!;
  assert(raised, "an empty host name must raise, never resolve");
}

// The same degenerate input on the path that actually matters. `connect` does
// its own `_net_resolve` call, so a guard placed only in `resolve` would leave
// TcpStream.connect("", port) connecting to one of this machine's own interface
// addresses — an unset config field or a mis-parsed URL turning into a silent
// self-connection instead of a diagnosable error (T1726).
test_connect_empty_host_raises() `test(exclude: wasm) {
  bool raised = false;
  TcpStream.connect("", 80)? e is ResolveError {
    raised = true;
    assert(e.host == "", "ResolveError echoes the empty name back");
    match e.kind {
      ResolveErrorKind.not_found => {
      },
      _ => {
        assert(false, "an empty host is reported as not_found");
      },
    };
  }!;
  assert(raised, "connecting to an empty host must raise, never connect to this machine");
}

// The same rejection, reached without the caller ever writing "". The extern
// bridge hands the resolver a NUL-terminated copy of the host, so a name whose
// first byte is NUL — "\0example.com" here, twelve bytes on the Promise side —
// arrives at getaddrinfo as the empty string and lands on exactly the platform
// divergence T1726 is about.
//
// This is what pins the guard to the C-string view rather than to the Promise
// length. A guard written in net.pr as `if host.len == 0` satisfies both tests
// above and still hands this name to a Windows resolver that answers it with
// every local interface address — the truncation would turn a bogus name into a
// connection to this machine, which is the failure mode, not a lesser one.
// Hermetic: nothing here reaches the network.
test_resolve_nul_truncated_host_raises() `test(exclude: wasm) {
  bool raised = false;
  resolve("\0example.com")? e is ResolveError {
    raised = true;
    match e.kind {
      ResolveErrorKind.not_found => {
      },
      _ => {
        assert(false, "a host that is empty at the C boundary is reported as not_found");
      },
    };
  }!;
  assert(raised, "a NUL-truncated host must raise, never resolve");

  // And on the path where it bites: connect must not read it as a request to
  // connect to this machine either.
  bool connect_raised = false;
  TcpStream.connect("\0example.com", 80)? e is ResolveError {
    connect_raised = true;
  }!;
  assert(connect_raised,
  "connecting to a NUL-truncated host must raise, never connect to this machine");
}

// The per-address fall-through, run to exhaustion. "localhost" resolves to ::1
// and/or 127.0.0.1; port 1 is reserved and has no listener, so *every* resolved
// address is refused and connect walks the whole list before raising.
//
// The discrimination is the point: resolution succeeded, so the failure must
// surface as a plain NetError carrying the connect errno — not as a
// ResolveError. Reporting "cannot resolve host" for a refused connection sends
// the reader to the wrong subsystem entirely.
test_connect_by_name_all_addresses_refused() `test(exclude: wasm, timeout: "10s") {
  bool raised = false;
  bool was_resolve_error = false;
  string message = "";
  TcpStream.connect("localhost", 1)? e {
    raised = true;
    was_resolve_error = e is ResolveError;
    message = e.message.clone();
  };
  // Port 1 is reserved, but a runner that somehow has a listener there would
  // connect successfully; only assert when the connection actually failed.
  if raised {
    assert(!was_resolve_error,
    "a refused connection to a name that resolved must not be reported as a resolution failure");
    assert(!message.contains("cannot resolve host"),
    "the message must describe the connect failure, not resolution: '{message}'");
  }
}

// The raise path's allocation accounting. test_resolve_repeated_no_leak covers
// the success path; this covers the other one — every failed lookup clones the
// host name into ResolveError.host and interpolates a message, and the bridge
// allocates a C string for both the host and the service on the way in. All of
// those are pal_alloc'd, so the leak detector sees them; a missing free on the
// failure path shows up here and nowhere else.
test_resolve_repeated_failure_no_leak() `test(exclude: wasm, timeout: "30s") {
  int raised = 0;
  int i = 0;
  while i < 500 {
    resolve(_over_long_host())? e is ResolveError {
      raised = raised + 1;
    }!;
    i = i + 1;
  }
  assert(raised == 500, "every lookup of an over-long name raised");
}

// Same accounting for the connect path, where a successful resolution is
// followed by a failing connect: the _AddrList is live when the raise unwinds,
// so this is the one runtime test that exercises the drop of a *non-empty*
// resolver list on a raise rather than on a normal return.
//
// The iteration count is deliberately small, and the host is deliberately an
// IPv4 literal (T1727). Refusing a loopback connection is not free on every
// platform: Windows charges ~2s per address before the RST surfaces — measured
// with a non-Promise client too, so it is the OS TCP stack and not our reactor
// — and those waits do not overlap, so N failing connects cost N × 2s however
// they are scheduled. "localhost" resolves to both ::1 and 127.0.0.1 and
// connect walks the whole list, doubling it again; a literal pins the list at
// exactly one address, so the cost cannot vary with how the runner resolves
// names.
//
// Looping less costs no signal. The leak detector compares allocation counts
// across the whole test, so a connect that leaks is caught on the first
// iteration; repetition only ever guarded against a leak that appears
// intermittently. The multi-address walk this test covered incidentally is
// owned outright by test_connect_by_name_all_addresses_refused above.
test_connect_failure_repeated_no_leak() `test(exclude: wasm, timeout: "30s") {
  int i = 0;
  while i < 5 {
    TcpStream.connect("127.0.0.1", 1)? e {
    };
    i = i + 1;
  }
}

// A zero handle must not reach the platform free. resolve() and connect() only
// build an _AddrList after a successful lookup, so this branch is unreachable
// from the module's own callers today — but it is the guard that makes
// _AddrList safe to construct anywhere, and free(0) on a resolver list is
// undefined rather than a no-op on every platform.
test_addr_list_zero_handle_drop() `test(exclude: wasm) {
  int i = 0;
  while i < 100 {
    _AddrList empty = _AddrList(_handle: 0);
    i = i + 1;
  }
}

_resolve_count_or_negative() int {
  string[] addresses = resolve("localhost")? e {
    return 0 - 1;
  };
  return addresses.len;
}

// Concurrent resolution is the whole reason T1518 runs getaddrinfo behind the
// scheduler's syscall handoff instead of on the reactor: enter_syscall detaches
// the calling M's P so the remaining goroutines keep running while the resolver
// blocks. Nothing else in the suite drives that handoff concurrently, and a
// regression that dropped it would not fail any sequential test — it would just
// serialize every lookup behind one P, or corrupt the idle-M stack under load.
//
// Deterministic: each goroutine reports over a channel and the test collects
// exactly as many results as it spawned, so there is no sleep and no timing
// assumption (T1632).
test_resolve_concurrent() `test(exclude: wasm, timeout: "30s") {
  ch := channel[int](capacity: 16);
  for i in 0..16 {
    go {
      ch.send(_resolve_count_or_negative());
    };
  }
  int reported = 0;
  for k in 0..16 {
    result := <-ch;
    if v := result {
      assert(v >= 1, "every goroutine resolved localhost to at least one address");
      reported = reported + 1;
    }
  }
  assert(reported == 16, "all 16 goroutines reported");
}

_empty_host_raise_count(int rounds) int {
  int raised = 0;
  int i = 0;
  while i < rounds {
    resolve("")? e is ResolveError {
      raised = raised + 1;
    }!;
    i = i + 1;
  }
  return raised;
}

// The guard answers without a syscall, which makes the empty host the fastest
// possible trip through the resolver bridge: enter_syscall hands this M's P
// away and exit_syscall takes one back with nothing in between. Every other
// resolve test holds that pair open for at least a real getaddrinfo, so this is
// the only place the handoff is driven at full rate and from several goroutines
// at once. Each iteration also raises, so the per-raise clone of the host and
// the interpolated message are accounted across goroutine stacks rather than on
// the test's own (T1726).
//
// Deterministic: each goroutine reports its own count over a channel and the
// test collects exactly as many results as it spawned — no sleep (T1632).
test_resolve_empty_host_concurrent() `test(exclude: wasm, timeout: "30s") {
  ch := channel[int](capacity: 8);
  for i in 0..8 {
    go {
      ch.send(_empty_host_raise_count(50));
    };
  }
  int reported = 0;
  for k in 0..8 {
    result := <-ch;
    if v := result {
      assert(v == 50, "every empty-host lookup in the goroutine raised");
      reported = reported + 1;
    }
  }
  assert(reported == 8, "all 8 goroutines reported");
}

_connect_ok(int port) bool {
  TcpStream s = TcpStream.connect("localhost", port)? e {
    return false;
  };
  s.close()? e {
  };
  return true;
}

// Connect-by-name concurrently against one listener. This drives resolution and
// the reactor's non-blocking connect from several goroutines at once — the
// combination T1518 introduced, where a goroutine hands its P away in
// getaddrinfo and then parks on the reactor for the handshake. The listener
// accepts sequentially from the test goroutine; the kernel backlog holds the
// pending connections, so no sleep is needed.
test_connect_by_name_concurrent() `test(exclude: wasm, timeout: "30s") {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;

  ch := channel[bool](capacity: 8);
  for i in 0..8 {
    go {
      ch.send(_connect_ok(port));
    };
  }

  int accepted = 0;
  for k in 0..8 {
    TcpStream server = listener.accept()?!;
    server.close()?!;
    accepted = accepted + 1;
  }
  assert(accepted == 8, "accepted every connection made by name");

  int connected = 0;
  for k in 0..8 {
    result := <-ch;
    if v := result {
      if v {
        connected = connected + 1;
      }
    }
  }
  assert(connected == 8, "all 8 goroutines connected by name");

  listener.close()?!;
}

// The AF_INET6 half of the connect path. Before T1518, connect built a
// sockaddr_in from an IPv4 literal and could not reach a v6 address at all;
// now the socket family comes from _net_resolve_family and the sockaddr comes
// from the resolver verbatim. Port 1 is reserved, so the connection is refused
// — the point is *how* it is refused: a NetError from connect(), which can only
// happen if an AF_INET6 socket was created and handed a well-formed
// sockaddr_in6. A wrong family or a malformed address surfaces as EAFNOSUPPORT
// or EINVAL instead, and a v6 literal mistakenly pushed through the v4 path
// would fail before connect() was ever reached.
//
// Written to hold on runners with IPv6 disabled too: resolution of a v6 literal
// always succeeds locally, so the one thing asserted unconditionally is that
// the failure is never reported as a resolution failure.
test_connect_ipv6_literal() `test(exclude: wasm, timeout: "10s") {
  string[] addresses = resolve("::1")?!;
  assert(addresses[0] == "::1", "the v6 literal resolves to itself");

  bool raised = false;
  bool was_resolve_error = false;
  int code = 0;
  TcpStream.connect("::1", 1)? e is NetError {
    raised = true;
    was_resolve_error = e is ResolveError;
    code = e.code;
  } else e {
    raised = true;
    assert(false, "connecting to a v6 literal must fail as a NetError, not '{e.message}'");
  };
  if raised {
    assert(!was_resolve_error, "a v6 literal always resolves; the failure must come from connect()");
    assert(code != 0, "a connect failure must carry the socket errno");
  }
}

// --- Deadlines, timeouts and cancellation (T1563) ---

// _serve binds a raw blocking listening socket and returns its fd. These tests
// drive a raw server so the Promise side under test is the only reactor user.
_serve() int {
  int sfd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(sfd >= 0, "server socket");
  assert(_net_socket_bind_addr(sfd, "127.0.0.1", 0) == 0, "bind");
  assert(_net_socket_listen(sfd, 128) == 0, "listen");
  return sfd;
}

// _error_reason classifies a caught error the same way _park_ready reports a
// wake: _wake_timeout(), _wake_cancelled(), or -1 for anything else.
_error_reason(error e) int {
  if e is NetError {
    NetError ne = e as! NetError;
    if ne.is_timeout {
      return _wake_timeout();
    }
    if ne.is_cancelled {
      return _wake_cancelled();
    }
  }
  return -1;
}

// The three outcome helpers below keep the failable call out of the assertions,
// so the stream/listener borrow is released before the test inspects it.
_read_outcome(TcpStream ~s, u8[] ~buf) int {
  int _n = s.read(buf)? e {
    return _error_reason(e);
  };
  return _wake_ready();
}

_write_outcome(TcpStream ~s, u8[] ~data) int {
  int _n = s.write(data)? e {
    return _error_reason(e);
  };
  return _wake_ready();
}

_accept_outcome(TcpListener ~l) int {
  TcpStream _s = l.accept()? e {
    return _error_reason(e);
  };
  return _wake_ready();
}

test_deadline_accessors_roundtrip() `test(exclude: wasm) {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  if _dl := client.read_deadline {
    assert(false, "a fresh stream has no read deadline");
  }
  if _dl2 := client.write_deadline {
    assert(false, "a fresh stream has no write deadline");
  }

  Instant at = Instant.from_nanos(123456789);
  client.set_read_deadline(at);
  if got := client.read_deadline {
    assert(got.as_nanos == 123456789, "read deadline roundtrip");
  } else {
    assert(false, "read deadline should be set");
  }
  if _dl3 := client.write_deadline {
    assert(false, "set_read_deadline must not touch the write deadline");
  }

  client.set_deadline(at);
  if got2 := client.write_deadline {
    assert(got2.as_nanos == 123456789, "set_deadline sets the write side too");
  } else {
    assert(false, "write deadline should be set");
  }

  client.set_deadline(none);
  if _dl4 := client.read_deadline {
    assert(false, "set_deadline(none) clears the read deadline");
  }
  if _dl5 := client.write_deadline {
    assert(false, "set_deadline(none) clears the write deadline");
  }

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_net_error_flags() `test(exclude: wasm) {
  NetError timeout = _timeout_error();
  assert(timeout.is_timeout, "timeout error is_timeout");
  assert(!timeout.is_cancelled, "timeout error is not cancelled");

  NetError cancelled = _cancelled_error();
  assert(cancelled.is_cancelled, "cancelled error is_cancelled");
  assert(!cancelled.is_timeout, "cancelled error is not a timeout");

  NetError refused = _make_net_error(-111);
  assert(!refused.is_timeout, "an errno failure is not a timeout");
  assert(!refused.is_cancelled, "an errno failure is not a cancellation");
  assert(refused.code == 111, "errno preserved");
}

test_read_deadline_expires() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  // The peer never sends, so only the deadline can end this read.
  client.set_read_deadline(Instant.now() + Duration.from_millis(100));
  u8[] buf = u8[].filled(0, 64);
  Instant start = Instant.now();
  int reason = _read_outcome(client, buf);
  int waited = start.elapsed().as_millis;

  assert(reason == _wake_timeout(), "deadline expiry reports is_timeout");
  assert(waited >= 90, "waited for the deadline, not returned early");
  assert(waited < 5000, "woke shortly after the deadline");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_read_deadline_not_hit() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  client.set_read_deadline(Instant.now() + Duration.from_secs(10));
  u8[] first = "Ok".bytes();
  assert(_net_socket_send(afd, first) == 2, "server sent");
  u8[] buf = u8[].filled(0, 64);
  int n = client.read(buf)?!;
  assert(n == 2, "read within the deadline succeeds");

  // A deadline that has not expired must not poison the next read either.
  u8[] second = "Hi".bytes();
  assert(_net_socket_send(afd, second) == 2, "server sent again");
  int n2 = client.read(buf)?!;
  assert(n2 == 2, "second read under the same deadline succeeds");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_read_after_deadline_cleared() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  // Let a short deadline expire, then clear it and read normally.
  client.set_read_deadline(Instant.now() + Duration.from_millis(50));
  u8[] buf = u8[].filled(0, 64);
  assert(_read_outcome(client, buf) == _wake_timeout(), "first read times out");

  client.set_read_deadline(none);
  u8[] payload = "Ok".bytes();
  assert(_net_socket_send(afd, payload) == 2, "server sent");
  int n = client.read(buf)?!;
  assert(n == 2, "read blocks normally once the deadline is cleared");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_write_deadline_expires() `test(exclude: wasm, timeout: "60s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  // Fill both socket buffers. The peer never reads, so once they are full only
  // the deadline can end the write.
  client.set_write_deadline(Instant.now() + Duration.from_millis(200));
  u8[] chunk = u8[].filled(65u8, 65536);
  int reason = _wake_ready();
  int guard = 0;
  while guard < 8192 && reason == _wake_ready() {
    reason = _write_outcome(client, chunk);
    guard = guard + 1;
  }
  assert(reason == _wake_timeout(), "a blocked write reports is_timeout");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_connect_deadline() `test(exclude: wasm, timeout: "20s") {
  // 192.0.2.1 is TEST-NET-1 (RFC 5737) — routed nowhere, so connect either
  // hangs (and must hit the deadline) or fails immediately as unreachable.
  // Both outcomes are legitimate and platform-dependent, but they are not
  // interchangeable: only the deadline can hold connect for its full 500ms, so
  // a failure that took that long and is NOT a timeout means the deadline never
  // armed. The 450ms threshold sits just under the deadline, so the reachable
  // false-positive window is only the 50ms in which a genuine ICMP unreachable
  // could land — the timeout branch always measures at least the full 500ms.
  Instant start = Instant.now();
  TcpStream _s = TcpStream.connect("192.0.2.1", 9, Instant.now() + Duration.from_millis(500))? e {
    assert(e is NetError, "raises a NetError");
    int waited = start.elapsed().as_millis;
    assert(waited < 5000, "connect did not hang");
    assert(waited < 450 || _error_reason(e) == _wake_timeout(),
    "a connect that ran to its deadline must report is_timeout");
    return;
  };
  assert(false, "connect to a blackhole address must fail");
}

test_connect_without_deadline_still_works() `test(exclude: wasm) {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  // The deadline parameter is optional — existing call sites keep working.
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");
  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_cancel_before_read() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  CancelHandle handle = client.create_cancel_handle();
  handle.cancel();
  handle.cancel(); // sticky and idempotent

  u8[] buf = u8[].filled(0, 64);
  assert(_read_outcome(client, buf) == _wake_cancelled(), "read on a cancelled stream raises");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// _cancel_after sleeps briefly so the main goroutine is genuinely parked before
// the cancellation lands, then consumes the handle.
_cancel_after(CancelHandle move handle) int {
  sleep(Duration.from_millis(50));
  handle.cancel();
  return 1;
}

test_cancel_unblocks_parked_read() `test(exclude: wasm, timeout: "30s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  CancelHandle handle = client.create_cancel_handle();
  t := go _cancel_after(move handle);

  u8[] buf = u8[].filled(0, 64);
  assert(_read_outcome(client, buf) == _wake_cancelled(), "a parked read is unblocked as cancelled");
  int done = <-t;
  assert(done == 1, "canceller finished");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_cancel_handle_outlives_stream() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  CancelHandle handle = client.create_cancel_handle();
  client.close()?!;
  // The PollDesc is kept alive by the handle, so cancelling a closed socket is
  // a harmless no-op. Dropping the handle releases the last reference — leak
  // enforcement asserts it is freed exactly once.
  handle.cancel();

  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// Returns a handle whose stream is dropped, not explicitly closed, on return.
_handle_from_dropped_stream!(int port) CancelHandle {
  TcpStream client = TcpStream.connect("127.0.0.1", port)?^;
  return client.create_cancel_handle();
}

test_cancel_handle_after_stream_drop() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  CancelHandle handle = _handle_from_dropped_stream(port)?!;
  handle.cancel();
  int afd = _net_socket_accept_addr(sfd);
  if afd >= 0 {
    _net_socket_close(afd);
  }
  _net_socket_close(sfd);
}

test_deadline_registry_churn() `test(exclude: wasm, timeout: "60s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  // Repeatedly arm and expire a deadline on the same socket. The registry holds
  // at most one entry per PollDesc, and each round must time out on its own
  // deadline rather than inherit a stale one.
  u8[] buf = u8[].filled(0, 64);
  int i = 0;
  while i < 20 {
    client.set_read_deadline(Instant.now() + Duration.from_millis(10));
    assert(_read_outcome(client, buf) == _wake_timeout(), "deadline {i} expired");
    i = i + 1;
  }

  // With the deadline cleared the socket must block normally again.
  client.set_read_deadline(none);
  u8[] payload = "Ok".bytes();
  assert(_net_socket_send(afd, payload) == 2, "server sent");
  int n = client.read(buf)?!;
  assert(n == 2, "read after deadline churn succeeds");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_accept_deadline_expires() `test(exclude: wasm, timeout: "20s") {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
  if _dl := listener.accept_deadline {
    assert(false, "a fresh listener has no accept deadline");
  }
  listener.set_accept_deadline(Instant.now() + Duration.from_millis(100));
  if got := listener.accept_deadline {
    assert(got.as_nanos != 0, "accept deadline is set");
  } else {
    assert(false, "accept deadline should be set");
  }

  Instant start = Instant.now();
  int reason = _accept_outcome(listener);
  int waited = start.elapsed().as_millis;
  assert(reason == _wake_timeout(), "accept past its deadline reports is_timeout");
  assert(waited >= 90, "waited for the accept deadline");
  assert(waited < 5000, "woke shortly after the accept deadline");

  listener.set_accept_deadline(none);
  if _dl2 := listener.accept_deadline {
    assert(false, "set_accept_deadline(none) clears it");
  }
  listener.close()?!;
}

test_accept_cancelled() `test(exclude: wasm, timeout: "30s") {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
  CancelHandle handle = listener.create_cancel_handle();
  t := go _cancel_after(move handle);

  assert(_accept_outcome(listener) == _wake_cancelled(), "a parked accept is unblocked as cancelled");
  int done = <-t;
  assert(done == 1, "canceller finished");
  listener.close()?!;
}

// --- T1563 coverage: sentinel encoding, the already-expired fast path,
// cancellation precedence and a shared deadline registry ---
//
// Every test here also doubles as a resource test: the harness fails a test
// that leaks, so a CancelHandle that forgot to unref its PollDesc — or a
// PollDesc freed while still on the deadline registry — shows up as a leak
// rather than as silently wrong bookkeeping.

// The constants the reactor and modules/net agree on by hand. The Go side
// asserts the same numbers (TestT1563_PollDescFieldIndicesMatchTheStruct in
// compiler/internal/codegen/netpoll_deadline_test.go), so drifting either half
// of the mirror breaks a test instead of silently swapping read for write.
test_wake_and_direction_constants_match_codegen() `test(exclude: wasm) {
  assert(_dir_read() == 0, "read direction is slot 0");
  assert(_dir_write() == 1, "write direction is slot 1");
  assert(_wake_ready() == 0, "ready reason");
  assert(_wake_timeout() == 1, "timeout reason");
  assert(_wake_cancelled() == 2, "cancelled reason");

  // Real errno values are always positive, so the sentinels must be negative
  // and distinct or a timeout could be mistaken for a socket error.
  assert(_timeout_code() < 0, "the timeout sentinel is negative");
  assert(_cancelled_code() < 0, "the cancelled sentinel is negative");
  assert(_timeout_code() != _cancelled_code(), "the two sentinels differ");

  assert(_wake_error(_wake_timeout()).is_timeout, "the timeout reason maps to a timeout error");
  assert(_wake_error(_wake_cancelled()).is_cancelled, "the cancelled reason maps to a cancelled error");
}

// 0 is the reactor's "no deadline" sentinel, so a genuine monotonic reading of 0
// has to be nudged off it — otherwise the first nanosecond of the monotonic
// epoch would silently disarm every deadline set in it.
test_deadline_encoding_reserves_zero() `test(exclude: wasm) {
  assert(_deadline_nanos(none) == 0, "none encodes as the no-deadline sentinel");
  assert(_deadline_nanos(Instant.from_nanos(0)) == 1, "a zero reading is nudged off the sentinel");
  assert(_deadline_nanos(Instant.from_nanos(42)) == 42, "an ordinary reading passes through");

  if _at := _deadline_instant(0) {
    assert(false, "the sentinel decodes back to none");
  }
  if at := _deadline_instant(42) {
    assert(at.as_nanos == 42, "an ordinary reading roundtrips");
  } else {
    assert(false, "42 must decode to an Instant");
  }
}

// The same reservation seen from the public API: a deadline built from a zero
// reading must read back as *set*, not as none.
test_zero_reading_deadline_reads_back_as_set() `test(exclude: wasm) {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
  listener.set_accept_deadline(Instant.from_nanos(0));
  if got := listener.accept_deadline {
    assert(got.as_nanos == 1, "a zero-reading deadline is stored as the nudged value");
  } else {
    assert(false, "a zero-reading deadline must not read back as none");
  }
  listener.close()?!;
}

// A deadline that has already passed is caught before the reactor is armed at
// all. Without that check the goroutine parks and only the next scan pass frees
// it — a millisecond of latency on a call that should not block once.
test_read_deadline_already_past() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  client.set_read_deadline(Instant.now() - Duration.from_secs(1));
  u8[] buf = u8[].filled(0, 64);
  Instant start = Instant.now();
  assert(_read_outcome(client, buf) == _wake_timeout(), "an already-past deadline times out");
  assert(start.elapsed().as_millis < 500, "and returns without parking on the reactor");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_accept_deadline_already_past() `test(exclude: wasm, timeout: "20s") {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
  listener.set_accept_deadline(Instant.now() - Duration.from_secs(1));
  Instant start = Instant.now();
  assert(_accept_outcome(listener) == _wake_timeout(), "an already-past accept deadline times out");
  assert(start.elapsed().as_millis < 500, "and returns without parking on the reactor");
  listener.close()?!;
}

// _connect_outcome mirrors _read_outcome for the connect path, where the stream
// is only produced on success and drops again straight away.
_connect_outcome(int port, Instant? deadline) int {
  TcpStream _s = TcpStream.connect("127.0.0.1", port, deadline)? e {
    return _error_reason(e);
  };
  return _wake_ready();
}

test_connect_deadline_already_past() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);

  Instant start = Instant.now();
  int reason = _connect_outcome(port, Instant.now() - Duration.from_secs(1));
  assert(start.elapsed().as_millis < 500, "an already-past connect deadline never parks");
  // A loopback connect can complete synchronously, in which case the deadline
  // is never consulted. Those are the only two acceptable outcomes: a
  // connection refused or reset here would mean the deadline path tore down a
  // socket it should not have.
  assert(reason == _wake_timeout() || reason == _wake_ready(),
  "connect either completes at once or reports is_timeout");

  // No accept here: whether a connection reached the listener's backlog depends
  // on which of the two outcomes above won the race, and _net_socket_accept_addr
  // is a blocking accept(2) with no deadline — on the timeout branch nothing was
  // ever queued, so it would block until the test times out (T1743). Closing the
  // listener discards anything the connect did queue.
  _net_socket_close(sfd);
}

// The teardown on the timeout branch above — close the PollDesc, close the
// socket, raise — runs exactly once in the whole suite, and on macOS it is the
// only branch a loopback connect ever takes (connect(2) there always returns
// EINPROGRESS, so the synchronous-success branch is unreachable on that host).
// Repeating it is what turns a per-connect leak in that teardown into a reported
// failure rather than a slow drain: the harness's allocation counter catches a
// PollDesc that outlives its socket, and a socket that outlives its connect
// eventually makes _net_socket_create fail, which surfaces here as a socket
// errno instead of one of the two permitted outcomes.
//
// No accept, for the same reason as the test above (T1743): which outcome won
// decides whether anything was ever queued on the listener.
test_connect_deadline_already_past_repeated() `test(exclude: wasm, timeout: "30s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);

  // Under the 128 backlog _serve() asks for, so a round that does connect is
  // held by the kernel rather than dropped and retried.
  int i = 0;
  while i < 100 {
    int reason = _connect_outcome(port, Instant.now() - Duration.from_secs(1));
    assert(reason == _wake_timeout() || reason == _wake_ready(),
    "round {i}: connect either completes at once or reports is_timeout");
    i = i + 1;
  }

  _net_socket_close(sfd);
}

// test_connect_fails_before_the_deadline_path drives an unresolvable name, so it
// stops at the resolver and never reaches connect(2) at all. This is the other
// pre-reactor failure: the name resolves, the socket is created, and the kernel
// rejects the connect on the call itself rather than returning EINPROGRESS.
// That is the one branch of the connect loop that closes a socket it never
// opened a PollDesc for, and the errno has to survive to the caller instead of
// being flattened into a timeout.
//
// Port 0 is the portable way there — it is not a connectable port on any target
// (EADDRNOTAVAIL on macOS, ECONNREFUSED on Linux, WSAEADDRNOTAVAIL on Windows),
// so the assertion is on the *shape* of the error, not on a particular errno.
test_connect_rejected_before_the_reactor() `test(exclude: wasm, timeout: "20s") {
  bool raised = false;
  bool was_resolve_error = false;
  bool timeout_or_cancelled = false;
  int code = 0;
  TcpStream.connect("127.0.0.1", 0)? e is NetError {
    raised = true;
    was_resolve_error = e is ResolveError;
    timeout_or_cancelled = e.is_timeout || e.is_cancelled;
    code = e.code;
  } else e {
    assert(false, "a rejected connect must fail as a NetError, not '{e.message}'");
  };
  assert(raised, "connecting to port 0 must fail");
  assert(!was_resolve_error, "an IPv4 literal always resolves; the failure comes from connect()");
  assert(!timeout_or_cancelled, "a synchronous rejection is neither a timeout nor a cancellation");
  assert(code > 0, "and carries the socket errno");

  // The same call with a deadline already in the past: the socket-level error
  // still wins, because connect(2) fails before anything can be parked.
  assert(_connect_outcome_host("127.0.0.1", 0, Instant.now() - Duration.from_secs(1)) == -1,
  "a rejected connect is reported as a socket error, not as a timeout");
}

// A deadline belongs to one direction. Expiring the read side must not disarm,
// arm, or poison the write side.
test_read_deadline_does_not_affect_the_write_side() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  client.set_read_deadline(Instant.now() + Duration.from_millis(50));
  u8[] buf = u8[].filled(0, 64);
  assert(_read_outcome(client, buf) == _wake_timeout(), "the read side times out");

  if _dl := client.write_deadline {
    assert(false, "a read timeout must leave the write deadline unset");
  }
  u8[] payload = "Ok".bytes();
  assert(client.write(payload)?! == 2, "the write side still works");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// Cancellation and expiry can both be pending; cancellation is processed first,
// so the caller sees is_cancelled and does not wait out the deadline.
test_cancel_beats_a_pending_deadline() `test(exclude: wasm, timeout: "30s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  // Far enough out that only the cancellation can end this read quickly.
  client.set_read_deadline(Instant.now() + Duration.from_secs(10));
  CancelHandle handle = client.create_cancel_handle();
  t := go _cancel_after(move handle);

  u8[] buf = u8[].filled(0, 64);
  Instant start = Instant.now();
  assert(_read_outcome(client, buf) == _wake_cancelled(), "cancellation wins over a pending deadline");
  assert(start.elapsed().as_millis < 5000, "and does not wait for the deadline");
  int done = <-t;
  assert(done == 1, "canceller finished");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// Cancellation is sticky: nothing short of a new socket clears it, and in
// particular changing the deadlines afterwards must not.
test_cancel_survives_a_deadline_change() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  CancelHandle handle = client.create_cancel_handle();
  handle.cancel();

  u8[] buf = u8[].filled(0, 64);
  assert(_read_outcome(client, buf) == _wake_cancelled(), "the first read is cancelled");

  client.set_read_deadline(Instant.now() + Duration.from_secs(10));
  assert(_read_outcome(client, buf) == _wake_cancelled(), "arming a deadline does not clear the cancellation");
  client.set_deadline(none);
  assert(_read_outcome(client, buf) == _wake_cancelled(), "nor does clearing one");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// _release_handle consumes a CancelHandle without cancelling, dropping the extra
// PollDesc reference it holds.
_release_handle(CancelHandle move _handle) {
}

// Dropping a handle releases its reference but not the socket's own, so the
// stream keeps working. Getting this wrong frees the PollDesc under a live
// socket — the failure mode the reference count exists to prevent.
test_cancel_handle_dropped_without_cancelling() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  CancelHandle handle = client.create_cancel_handle();
  _release_handle(move handle);

  u8[] payload = "Ok".bytes();
  assert(_net_socket_send(afd, payload) == 2, "server sent");
  u8[] buf = u8[].filled(0, 64);
  assert(client.read(buf)?! == 2, "the stream still reads after its handle is dropped");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// Several handles can refer to the same socket at once. Releasing one must not
// disturb the others, and cancelling through any of them reaches the socket.
test_multiple_cancel_handles_share_one_socket() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  CancelHandle first = client.create_cancel_handle();
  CancelHandle second = client.create_cancel_handle();
  _release_handle(move first);

  second.cancel();
  u8[] buf = u8[].filled(0, 64);
  assert(_read_outcome(client, buf) == _wake_cancelled(), "the surviving handle still cancels");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// _deadline_reader owns its stream so it can run in its own goroutine, and
// reports how the read ended. The stream closes when it drops on return.
_deadline_reader(TcpStream move s, int millis) int {
  s.set_read_deadline(Instant.now() + Duration.from_millis(millis));
  u8[] buf = u8[].filled(0, 64);
  return _read_outcome(s, buf);
}

// The deadline registry is one global list, and every test above puts a single
// PollDesc on it. Three at once is what exercises walking past the head: the
// scan has to expire a node in the middle and unlink it without losing the rest
// of the list, and the staggered deadlines force it to do so across passes.
test_concurrent_deadlines_across_sockets() `test(exclude: wasm, timeout: "30s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);

  TcpStream first = TcpStream.connect("127.0.0.1", port)?!;
  int afd_first = _net_socket_accept_addr(sfd);
  TcpStream second = TcpStream.connect("127.0.0.1", port)?!;
  int afd_second = _net_socket_accept_addr(sfd);
  TcpStream third = TcpStream.connect("127.0.0.1", port)?!;
  int afd_third = _net_socket_accept_addr(sfd);
  assert(afd_first >= 0 && afd_second >= 0 && afd_third >= 0, "accepted three connections");

  t_first := go _deadline_reader(move first, 80);
  t_second := go _deadline_reader(move second, 140);
  t_third := go _deadline_reader(move third, 200);

  int r_first = <-t_first;
  int r_second = <-t_second;
  int r_third = <-t_third;
  assert(r_first == _wake_timeout(), "the first socket timed out");
  assert(r_second == _wake_timeout(), "the second socket timed out");
  assert(r_third == _wake_timeout(), "the third socket timed out");

  _net_socket_close(afd_first);
  _net_socket_close(afd_second);
  _net_socket_close(afd_third);
  _net_socket_close(sfd);
}

// _cancel_after_millis is _cancel_after with a caller-chosen delay, so a stress
// loop can walk the canceller across the arm/park window.
_cancel_after_millis(CancelHandle move handle, int millis) int {
  sleep(Duration.from_millis(millis));
  handle.cancel();
  return 1;
}

// The window between arm() and the park is the race the whole design is built
// around: a cancellation that lands inside it finds no waiter yet, and only the
// sticky flag plus the retrying scan get the reader unblocked. Repeating with a
// shifting delay lands the canceller before, inside and after that window. The
// generous read deadline is a tripwire, not the mechanism under test — if the
// wake is ever lost this fails as a wrong reason rather than as a hang.
test_cancel_park_race_stress() `test(exclude: wasm, timeout: "60s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  u8[] buf = u8[].filled(0, 64);

  int i = 0;
  while i < 25 {
    TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
    int afd = _net_socket_accept_addr(sfd);
    assert(afd >= 0, "round {i} accept");

    client.set_read_deadline(Instant.now() + Duration.from_secs(10));
    CancelHandle handle = client.create_cancel_handle();
    t := go _cancel_after_millis(move handle, i % 3);

    assert(_read_outcome(client, buf) == _wake_cancelled(), "round {i} cancelled");
    int done = <-t;
    assert(done == 1, "round {i} canceller finished");

    client.close()?!;
    _net_socket_close(afd);
    i = i + 1;
  }
  _net_socket_close(sfd);
}

// close() now releases a PollDesc reference instead of freeing outright, which
// makes a second close on the same socket a use-after-free risk rather than a
// harmless error return. It has to be rejected on the fd check, before the
// unref — and the CancelHandle that is still holding a reference has to survive
// it.
test_double_close_does_not_release_twice() `test(exclude: wasm, timeout: "20s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  CancelHandle handle = client.create_cancel_handle();
  client.close()?!;

  bool raised = false;
  client.close()? e {
    assert(e is NetError, "a second close raises a NetError");
    NetError ne = e as! NetError;
    assert(ne.code == 9, "and reports a bad file descriptor");
    assert(!ne.is_timeout && !ne.is_cancelled, "which is neither a timeout nor a cancellation");
    raised = true;
  };
  assert(raised, "closing an already-closed stream must raise");

  // The handle's reference outlived both closes, so this is still a live
  // PollDesc and dropping the handle here is what finally frees it.
  handle.cancel();

  _net_socket_close(afd);
  _net_socket_close(sfd);
}

test_listener_double_close_does_not_release_twice() `test(exclude: wasm) {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
  CancelHandle handle = listener.create_cancel_handle();
  listener.close()?!;

  bool raised = false;
  listener.close()? e {
    NetError ne = e as! NetError;
    assert(ne.code == 9, "a second close reports a bad file descriptor");
    raised = true;
  };
  assert(raised, "closing an already-closed listener must raise");

  handle.cancel();
}

// connect() now computes a deadline before it creates the socket. A connect
// that fails synchronously — an unparseable host never reaches EINPROGRESS —
// must unwind that early path cleanly: no PollDesc is opened, so nothing may be
// unref'd, and the error is the socket's, not a spurious timeout.
test_connect_fails_before_the_deadline_path() `test(exclude: wasm, timeout: "20s") {
  int reason = _connect_outcome_host("not_an_ip", 80, Instant.now() + Duration.from_secs(10));
  assert(reason == -1, "a synchronous connect failure is neither a timeout nor a cancellation");

  // Same failure with a deadline already in the past: the socket-level error
  // still wins, because connect never gets far enough to consult the deadline.
  int past = _connect_outcome_host("not_an_ip", 80, Instant.now() - Duration.from_secs(1));
  assert(past == -1, "an unusable host is reported as a socket error, not a timeout");
}

// _connect_outcome_host is _connect_outcome with a caller-chosen host, so a test
// can drive the synchronous-failure path.
_connect_outcome_host(string host, int port, Instant? deadline) int {
  TcpStream _s = TcpStream.connect(host, port, deadline)? e {
    return _error_reason(e);
  };
  return _wake_ready();
}

// --- T1563 coverage: the write direction and an accept deadline that holds ---
//
// Everything above drives deadlines and cancellation through the read side (and
// through accept, which is also slot 0). The write slot is a separate deadline,
// a separate reason and a separate waiter, all selected by a runtime index — a
// direction mix-up would be invisible to every read-side test. These drive the
// write slot through the same three states: an already-past deadline, a sticky
// cancellation, and a re-arm that must not inherit the expired one.

// _fill_until_blocked writes chunks until the socket stops accepting them and
// reports how that ended. The peer never reads, so both buffers fill and the
// write genuinely parks — which is the only way to reach the write-side
// deadline and cancellation checks at all.
_fill_until_blocked(TcpStream ~s, u8[] ~chunk) int {
  int reason = _wake_ready();
  int guard = 0;
  while guard < 8192 && reason == _wake_ready() {
    reason = _write_outcome(s, chunk);
    guard = guard + 1;
  }
  return reason;
}

// _drain_all empties everything the peer has buffered and returns the byte
// count. It switches the raw peer fd to non-blocking first so the loop can stop
// on EAGAIN instead of blocking once the buffers are empty. A single recv is
// not enough to unblock the writer: loopback holds megabytes, and the sender
// only becomes writable again once the window actually reopens.
_drain_all(int afd) int {
  _net_socket_set_nonblock(afd);
  u8[] sink = u8[].filled(0, 65536);
  int total = 0;
  int guard = 0;
  while guard < 4096 {
    int n = _net_socket_recv(afd, sink);
    if n <= 0 {
      return total;
    }
    total = total + n;
    guard = guard + 1;
  }
  return total;
}

// The read side has test_read_deadline_already_past; this is its write-slot
// twin, plus the re-arm that a stale expired deadline would break.
test_write_deadline_already_past() `test(exclude: wasm, timeout: "60s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  client.set_write_deadline(Instant.now() - Duration.from_secs(1));
  u8[] chunk = u8[].filled(65u8, 65536);
  assert(_fill_until_blocked(client, chunk) == _wake_timeout(),
  "a write that blocks with a past deadline times out");

  // The buffers are full, but loopback keeps moving the sender's queued bytes
  // into the peer's receive buffer in the background, so a single write here can
  // still be accepted — write() returns on any short send — before the socket
  // blocks again (T1743). Refilling is what deterministically reaches the
  // would-block path again; the elapsed bound is the assertion, since an
  // already-past deadline is caught before the park and every blocked write in
  // this loop therefore returns without reaching the reactor.
  Instant start = Instant.now();
  assert(_fill_until_blocked(client, chunk) == _wake_timeout(), "and keeps timing out while it would block");
  assert(start.elapsed().as_millis < 500, "an already-past write deadline never parks");

  // Re-arm with a deadline that will not fire and drain the peer. An expired
  // deadline is deliberately left armed in the PollDesc until the next park
  // overwrites it, so this is where a stale one would surface as an instant
  // bogus timeout.
  client.set_write_deadline(Instant.now() + Duration.from_secs(30));
  assert(_drain_all(afd) > 0, "peer drained buffered data");
  u8[] small = "Ok".bytes();
  assert(client.write(small)?! == 2, "the write slot works again once space frees up");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// test_read_deadline_does_not_affect_the_write_side in the other direction. The
// two slots are addressed by a runtime index, so an expired write deadline that
// bled into the read slot would show up as a read reporting a timeout it was
// never given — invisible to every test that only ever expires the read side.
test_write_deadline_expiry_does_not_affect_the_read_side() `test(exclude: wasm, timeout: "60s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  client.set_write_deadline(Instant.now() - Duration.from_secs(1));
  u8[] chunk = u8[].filled(65u8, 65536);
  assert(_fill_until_blocked(client, chunk) == _wake_timeout(), "the write side times out");

  if _dl := client.read_deadline {
    assert(false, "a write timeout must leave the read deadline unset");
  }

  // Only the client-to-server direction is full; the peer's send buffer is
  // untouched, so neither this send nor the read that follows it can block.
  u8[] payload = "Ok".bytes();
  assert(_net_socket_send(afd, payload) == 2, "server sent");
  u8[] buf = u8[].filled(0, 64);
  assert(client.read(buf)?! == 2, "the read side still works");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// test_cancel_before_read's write-slot twin. An unblocked write returns before
// it ever consults the sticky flag, so the buffers have to be full first.
test_cancel_before_write() `test(exclude: wasm, timeout: "60s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  CancelHandle handle = client.create_cancel_handle();
  handle.cancel();

  // A far-future deadline is a tripwire: if cancellation were not checked on
  // the write side this would hang until the test timeout instead of failing.
  client.set_write_deadline(Instant.now() + Duration.from_secs(30));
  u8[] chunk = u8[].filled(65u8, 65536);
  assert(_fill_until_blocked(client, chunk) == _wake_cancelled(),
  "a blocked write on a cancelled stream raises as cancelled");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// set_read_deadline's independence is asserted in test_deadline_accessors_
// roundtrip; the write setter needs the same guarantee in the other direction,
// since both slots are addressed by index.
test_set_write_deadline_only_touches_the_write_side() `test(exclude: wasm) {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  client.set_write_deadline(Instant.from_nanos(987654321));
  if got := client.write_deadline {
    assert(got.as_nanos == 987654321, "write deadline roundtrip");
  } else {
    assert(false, "write deadline should be set");
  }
  if _dl := client.read_deadline {
    assert(false, "set_write_deadline must not touch the read deadline");
  }

  client.set_write_deadline(none);
  if _dl2 := client.write_deadline {
    assert(false, "set_write_deadline(none) clears it");
  }

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}

// An accept deadline that does not fire has to be invisible. The listener slot
// is armed on every accept that blocks, so a deadline left half-consumed would
// show up as the *second* accept failing, not the first.
test_accept_succeeds_under_an_unexpired_deadline() `test(exclude: wasm, timeout: "20s") {
  TcpListener listener = TcpListener.bind("127.0.0.1", 0)?!;
  int port = listener.local_port;
  listener.set_accept_deadline(Instant.now() + Duration.from_secs(30));

  int first_fd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(_net_socket_connect_addr(first_fd, "127.0.0.1", port) == 0, "first connect");
  TcpStream first = listener.accept()?!;

  int second_fd = _net_socket_create(_af_inet(), _sock_stream(), 0);
  assert(_net_socket_connect_addr(second_fd, "127.0.0.1", port) == 0, "second connect");
  TcpStream second = listener.accept()?!;

  // The deadline is still the one that was set, and still has not fired.
  if got := listener.accept_deadline {
    assert(got.as_nanos > Instant.now().as_nanos, "the accept deadline is still pending");
  } else {
    assert(false, "a successful accept must not clear the deadline");
  }

  first.close()?!;
  second.close()?!;
  _net_socket_close(first_fd);
  _net_socket_close(second_fd);
  listener.close()?!;
}

// _drain_after gives the writer time to actually park before the peer frees up
// space, so the wake under test comes from the reactor rather than from the
// write never having blocked at all.
_drain_after(int afd, int millis) int {
  sleep(Duration.from_millis(millis));
  return _drain_all(afd);
}

// test_read_deadline_not_hit's write-slot twin, and the only test that drives a
// reactor write-readiness wake with a deadline armed: the PollDesc is on the
// deadline registry for the whole park, so the scan walks it on every pass and
// must leave the waiter alone until the reactor gets to it.
test_write_deadline_not_hit() `test(exclude: wasm, timeout: "60s") {
  int sfd = _serve();
  int port = _net_socket_getsockname(sfd);
  TcpStream client = TcpStream.connect("127.0.0.1", port)?!;
  int afd = _net_socket_accept_addr(sfd);
  assert(afd >= 0, "accept");

  // Fill the buffers with an already-past deadline — that is just the cheap way
  // to reach "the next write will block" without waiting on anything.
  client.set_write_deadline(Instant.now() - Duration.from_secs(1));
  u8[] chunk = u8[].filled(65u8, 65536);
  assert(_fill_until_blocked(client, chunk) == _wake_timeout(), "buffers are full");

  // Now a deadline far beyond the drain delay. The write parks, the peer drains,
  // and the reactor — not the deadline — is what has to wake it.
  client.set_write_deadline(Instant.now() + Duration.from_secs(30));
  t := go _drain_after(afd, 100);

  Instant start = Instant.now();
  u8[] small = "Ok".bytes();
  int reason = _write_outcome(client, small);
  int waited = start.elapsed().as_millis;
  int drained = <-t;

  assert(reason == _wake_ready(), "a write under an unexpired deadline completes normally");
  assert(drained > 0, "the peer drained the buffered data");
  assert(waited < 20000, "and was woken by the reactor, not by the deadline");

  client.close()?!;
  _net_socket_close(afd);
  _net_socket_close(sfd);
}
