// Failable close() error propagation in use bindings (B0013).
type CloseError is error {
  int code;
}

// A resource whose close() always succeeds.
type OkResource {
  int id;

  close!(~this) void {
    // success — no error
  }
}

// A resource whose close() always fails.
type FailResource {
  int id;

  close!(~this) void {
    raise CloseError(message: "close failed", code: 42);
  }
}

// --- Normal exit: failable close error propagates ---

close_propagates!() int {
  use r := FailResource(id: 1);
  return r.id;
}

test_close_error_propagates() `test {
  int result = close_propagates()? e {
    assert(e.message == "close failed", "close error message matches");
    return;
  };
  assert(false, "should not reach here — close should have failed");
}

// --- Normal exit: successful close does not interfere ---

close_ok!() int {
  use r := OkResource(id: 42);
  return r.id;
}

test_close_ok_returns_value() `test {
  int result = close_ok()?!;
  assert(result == 42, "successful close returns normal value");
}

// --- Raise path: close error suppressed, original error preserved ---

raise_with_failable_close!() int {
  use r := FailResource(id: 1);
  raise CloseError(message: "body error", code: 99);
}

test_raise_suppresses_close_error() `test {
  int result = raise_with_failable_close()? e {
    assert(e.message == "body error", "original raise error preserved, not close error");
    return;
  };
  assert(false, "should not reach here");
}

// --- Error propagation path: close error suppressed ---

inner_fail!() void {
  raise CloseError(message: "inner error", code: 77);
}

propagate_with_failable_close!() void {
  use r := FailResource(id: 1);
  inner_fail()?^;
}

test_propagate_suppresses_close_error() `test {
  propagate_with_failable_close()? e {
    assert(e.message == "inner error", "propagated error preserved, not close error");
    return;
  };
  assert(false, "should not reach here");
}

// --- Non-failable function: close error suppressed ---

non_failable_with_failable_close() int {
  use r := FailResource(id: 99);
  return r.id;
}

test_non_failable_suppresses_close() `test {
  int result = non_failable_with_failable_close();
  assert(result == 99, "non-failable function ignores close error");
}

// --- Multiple use bindings: first close error wins ---

multiple_failable_close!() void {
  use a := FailResource(id: 1);
  use b := FailResource(id: 2);
  // Normal exit — both close() called in reverse order (b then a).
  // b.close() fails first; a.close() also fails but that error is suppressed.
}

test_multiple_close_first_error_wins() `test {
  multiple_failable_close()? e {
    assert(e.message == "close failed", "first close error captured");
    return;
  };
  assert(false, "should have gotten close error");
}

// --- Block scope: close error propagates from nested block ---

close_error_in_block!() void {
  if true {
    use r := FailResource(id: 1);
    // r.close() called at block exit, error propagates
  }
}

test_close_error_in_nested_block() `test {
  close_error_in_block()? e {
    assert(e.message == "close failed", "close error propagates from nested block");
    return;
  };
  assert(false, "should have gotten close error");
}

// --- Void failable function: close error propagates ---

void_failable_close!() void {
  use r := FailResource(id: 1);
}

test_void_failable_close() `test {
  void_failable_close()? e {
    assert(e.message == "close failed", "void failable propagates close error");
    return;
  };
  assert(false, "should have gotten close error");
}

// --- Failable INITIALIZER with implicit auto-propagation (GitHub #3) ---
//
// A bare failable call as a `use` initializer must auto-propagate its error and
// unwrap to the ok value, exactly like a normal var decl. Previously this
// panicked codegen (the failable-result aggregate was stored into the unwrapped
// slot). These tests exercise the bare-call form (no `?^`), which is the trigger.

// Resource with a failable factory whose close() succeeds.
type MakeOk {
  int id;

  make!(int id) MakeOk `factory {
    return MakeOk(id: id);
  }

  close!(~this) void {
    // success — no error
  }
}

failable_init_returns_value!() int {
  use r := MakeOk.make(7); // bare failable call — implicit auto-propagation
  return r.id;
}

test_failable_init_returns_value() `test {
  int result = failable_init_returns_value()?!;
  assert(result == 7, "failable use initializer auto-propagates and unwraps to ok value");
}

// Resource whose failable factory FAILS, and whose close() raises a DISTINCT
// error. If the init error propagates (not the close error), close() never ran —
// proving the resource that was never created is never closed (no leak).
type MakeFails {
  int id;

  make!(int id) MakeFails `factory {
    raise CloseError(message: "factory failed", code: 1);
  }

  close!(~this) void {
    raise CloseError(message: "close should not run", code: 2);
  }
}

failable_init_failure_propagates!() int {
  use r := MakeFails.make(3); // factory raises — error propagates before the bind
  return r.id;
}

test_failable_init_failure_propagates() `test {
  failable_init_failure_propagates()? e {
    assert(e.message == "factory failed", "init error propagates; close() did NOT run");
    return;
  };
  assert(false, "should have gotten the factory error");
}

// Failable initializer inside a nested block — auto-propagation + close both fire.
failable_init_in_block!() int {
  if true {
    use r := MakeOk.make(11); // bare failable call inside a nested scope
    return r.id;
  }
  return 0;
}

test_failable_init_in_nested_block() `test {
  int result = failable_init_in_block()?!;
  assert(result == 11, "failable use initializer works inside a nested block");
}

// Multiple failable initializers in one scope: both unwrap, both close in reverse.
two_failable_inits!() int {
  use a := MakeOk.make(20); // bare failable call
  use b := MakeOk.make(22); // bare failable call
  return a.id + b.id;
}

test_two_failable_inits() `test {
  int result = two_failable_inits()?!;
  assert(result == 42, "multiple failable use initializers each unwrap correctly");
}

// Failable factory AND failable close: init succeeds (auto-propagation), then the
// close() at scope exit fails — the close error must propagate. Exercises the new
// auto-propagate-init path together with the failable-close machinery.
type MakeOkCloseFails {
  int id;

  make!(int id) MakeOkCloseFails `factory {
    return MakeOkCloseFails(id: id);
  }

  close!(~this) void {
    raise CloseError(message: "close failed late", code: 7);
  }
}

failable_init_then_failable_close!() int {
  use r := MakeOkCloseFails.make(4); // bare failable call — init succeeds
  return r.id;
}

test_failable_init_then_failable_close() `test {
  failable_init_then_failable_close()? e {
    assert(e.message == "close failed late", "init unwraps; failable close error propagates");
    return;
  };
  assert(false, "should have gotten the close error");
}

// Failable factory producing a resource that owns a heap string field. Exercises
// heap/string-temp claiming through the auto-propagation unwrap (zero-leak audit):
// the owned string must be dropped exactly once at close, never double-freed.
type Handle {
  string name;

  open!(string move name) Handle `factory {
    return Handle(name: move name);
  }

  close!(~this) void {
    // success — the owned `name` string is dropped with the instance
  }
}

failable_init_heap_field!() int {
  use h := Handle.open("socket"); // bare failable call — auto-propagation
  return h.name.len; // string stays owned by h, dropped at close
}

test_failable_init_heap_field_no_leak() `test {
  int result = failable_init_heap_field()?!;
  assert(result == 6, "failable init of a resource with a heap string field; no leak on close");
}

// --- T1388: close-error early exit must clean up OUTER live bindings ---
//
// A failable use-binding close() that fails on a block's NORMAL exit takes an
// early error-return. Before T1388 that early exit skipped scope cleanup for any
// still-live OUTER bindings (those below the block's floor), leaking them. Each
// test below pairs a heap-allocating OUTER droppable with a nested failing close
// and relies on the harness's zero-leak enforcement to prove the outer binding is
// freed on the error path.

// A droppable heap type (explicit drop() → heap-allocated instance, not a value
// type). If its drop() never runs, the instance malloc leaks.
type T1388Droppable {
  int id;
  drop(~this) {
  }
}

// Outer droppable + nested block whose use-close fails on exit (the item's first
// repro). floor = block savedScopeLen; prefix [0, floor) holds `d`.
outer_droppable_nested_close!() int {
  d := T1388Droppable(id: 1);
  {
    use r := FailResource(id: 2);
  }
  // r.close() fails at block exit → early exit
  return d.id;
}

test_t1388_outer_droppable_nested_close() `test {
  bool caught = false;
  int v = outer_droppable_nested_close()? e {
    caught = true;
    -1
  };
  assert(caught, "close error surfaces past the outer droppable");
}

// Two enclosing blocks + a function-level droppable — exercises full prefix
// unwind (both `d` and `e` must be dropped on the innermost close-error exit).
deep_nesting_close!() int {
  d := T1388Droppable(id: 1);
  {
    e := T1388Droppable(id: 2);
    {
      use r := FailResource(id: 3);
    }
    // fails → early exit past both d and e
    return e.id;
  }
}

test_t1388_deep_nesting_close() `test {
  bool caught = false;
  deep_nesting_close()? e {
    caught = true;
  };
  assert(caught, "close error surfaces past two nested outer droppables");
}

// if-let body: outer droppable + failing close inside the unwrap body (covers the
// unwrapScopeLen floor). The unwrapped `v` sits in the cleaned suffix; `d` is the
// outer prefix binding.
some_positive(int x) int? {
  if x > 0 {
    return x;
  }
  return none;
}

iflet_body_close!() int {
  d := T1388Droppable(id: 1);
  if v := some_positive(5) {
    use r := FailResource(id: 2); // fails at if-let body exit → early exit
  }
  return d.id;
}

test_t1388_iflet_body_close() `test {
  bool caught = false;
  iflet_body_close()? e {
    caught = true;
  };
  assert(caught, "close error surfaces past outer droppable from if-let body");
}

// while-let body: outer droppable + failing close inside the loop body (covers the
// while-let unwrapScopeLen floor). The subject yields Some once (n>0), so the body
// runs and its use-close fails on the first iteration end; if the close somehow
// succeeded, n is reset to 0 and the loop terminates.
whilelet_body_close!() int {
  d := T1388Droppable(id: 1);
  n := 1;
  while v := some_positive(n) {
    n = 0;
    use r := FailResource(id: 2); // fails at body exit → early exit
  }
  return d.id;
}

test_t1388_whilelet_body_close() `test {
  bool caught = false;
  whilelet_body_close()? e {
    caught = true;
  };
  assert(caught, "close error surfaces past outer droppable from while-let body");
}

// Loop break: outer droppable declared before the loop + failing close in the loop
// body, then `break` (covers the loopScopeDepth floor). The break's cleanup closes
// `r` (fails) → early exit that must still drop the outer `d`.
loop_break_close!() int {
  d := T1388Droppable(id: 1);
  i := 0;
  while i < 3 {
    use r := FailResource(id: 2); // break-time close fails → early exit
    break;
  }
  return d.id;
}

test_t1388_loop_break_close() `test {
  bool caught = false;
  loop_break_close()? e {
    caught = true;
  };
  assert(caught, "close error surfaces past outer droppable on loop break");
}

// Loop continue: same shape, but `continue` drives the close (also loopScopeDepth
// floor). A counter bounds the loop so it terminates if the close somehow succeeds.
loop_continue_close!() int {
  d := T1388Droppable(id: 1);
  i := 0;
  while i < 3 {
    i = i + 1;
    use r := FailResource(id: 2); // continue-time close fails → early exit
    continue;
  }
  return d.id;
}

test_t1388_loop_continue_close() `test {
  bool caught = false;
  loop_continue_close()? e {
    caught = true;
  };
  assert(caught, "close error surfaces past outer droppable on loop continue");
}

// Block-value form: an if-expression arm holds a failing use-close, with an
// outer droppable declared before the assignment (covers the genBlockValue
// savedScopeLen floor — a distinct call site from the statement-block genBlock).
// The arm's `r.id` is the suffix result; `d` is the outer prefix binding.
blockvalue_close!() int {
  d := T1388Droppable(id: 1);
  x := if true {
    use r := FailResource(id: 2); // fails at arm exit → early exit past `d`
    r.id
  } else {
    0
  };
  return d.id + x;
}

test_t1388_blockvalue_close() `test {
  bool caught = false;
  blockvalue_close()? e {
    caught = true;
  };
  assert(caught, "close error surfaces past outer droppable from a block-value arm");
}

// Select case body: an outer droppable + a ready channel whose select case body
// holds a failing use-close (covers the genSelectStmt savedScopeLen floor). The
// channel is pre-loaded so the case is immediately ready (no blocking), then the
// case body's use-close fails at case-body exit → early exit that must drop `d`.
select_case_close!() int {
  d := T1388Droppable(id: 1);
  ch := channel[int](capacity: 1);
  ch.send(7);
  select {
    v := <-ch:
      use r := FailResource(id: 2); // fails at case-body exit → early exit past `d`
  }
  return d.id;
}

test_t1388_select_case_close() `test {
  bool caught = false;
  select_case_close()? e {
    caught = true;
  };
  assert(caught, "close error surfaces past outer droppable from a select case body");
}

// Select default body: an outer droppable + a select whose (empty) channel makes
// the default clause run, and whose default body holds a failing use-close
// (covers the genSelectStmt default-clause savedScopeLen floor — a distinct
// emission site from the case body). The empty channel forces the default.
select_default_close!() int {
  d := T1388Droppable(id: 1);
  ch := channel[int](capacity: 1);
  select {
    v := <-ch:
    default:
      use r := FailResource(id: 2); // fails at default-body exit → early exit past `d`
  }
  return d.id;
}

test_t1388_select_default_close() `test {
  bool caught = false;
  select_default_close()? e {
    caught = true;
  };
  assert(caught, "close error surfaces past outer droppable from a select default body");
}

// For-in over a channel: an outer droppable + a for-in-channel loop whose body
// holds a failing use-close (covers the genForInChannel bodyScopeStart floor).
// The channel yields one value then closes; the first iteration's use-close fails
// at body exit → early exit that must drop `d`.
forin_channel_close!() int {
  d := T1388Droppable(id: 1);
  ch := channel[int](capacity: 1);
  ch.send(7);
  ch.close();
  for v in ch {
    use r := FailResource(id: 2); // fails at loop-body exit → early exit past `d`
  }
  return d.id;
}

test_t1388_forin_channel_close() `test {
  bool caught = false;
  forin_channel_close()? e {
    caught = true;
  };
  assert(caught, "close error surfaces past outer droppable from a for-in-channel body");
}
